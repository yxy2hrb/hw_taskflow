        "create": [
          {
            "type": "create",
            "id": "toast_success",
            "component": "Toast",
            "bbox": [
              40,
              120,
              280,
              44
            ],
            "text": "开局配置成功"
          }
        ],
        "update": []
      },
      "data_state": {},
      "patches": []
    }
  ],
  "validation_notes": []

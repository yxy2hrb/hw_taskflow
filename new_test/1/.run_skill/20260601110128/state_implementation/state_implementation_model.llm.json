{
  "states": [
    {
      "id": "state_1",
      "label": "工作台初始页面",
      "ui_intent": "展示我的工作台页面，包含顶部状态栏、导航栏、功能图标区、项目开局卡片及底部导航栏",
      "parent_state": null,
      "trigger": {

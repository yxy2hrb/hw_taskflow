        "action": "goto:state_2"
      },
      "inheritance": {
        "keep": [
          "页面根容器与浅灰背景-整个页面",
          "顶部背景装饰图形组-顶部靠上",
          "顶部状态栏-屏幕最顶端",
          "0808-文本",
          "顶部导航栏-状态栏下方",

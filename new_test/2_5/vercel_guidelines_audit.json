      "severity": "high",
      "category": "Accessibility",
      "rule": "Icon-only buttons need `aria-label`",
      "location": ".tf-cg-appbar-back (line ~1394)",
      "element": "<div class=\"tf-cg-appbar-back\"><svg ...></svg></div>",
      "problem": "返回按钮只有 SVG 箭头图标，无 aria-label，屏幕阅读器无法识别",
      "fix": "添加 aria-label=\"返回\" 或改为 <button aria-label=\"返回\">"
    },
    {
      "severity": "high",
      "category": "Accessibility",
      "rule": "Form controls need semantic input + label association",
      "location": ".tf-cg-radio-item (line ~1400)",
      "element": "<label class=\"tf-cg-radio-item\"><span class=\"tf-cg-radio-icon\"></span>...</label>",
      "problem": "radio 选项用纯 CSS <span> 模拟，不是真正的 <input type=\"radio\">，键盘无法操作，屏幕阅读器不可用",
      "fix": "改为 <label><input type=\"radio\" name=\"属性\" value=\"公司\"><span>公司</span></label>"
    },
    {
      "severity": "high",
      "category": "Accessibility",
      "rule": "Decorative icons need `aria-hidden=\"true\"`",
      "location": ".tf-cg-list-arrow SVG (line ~1400)",
      "element": "<svg class=\"tf-cg-list-arrow\" viewBox=\"0 0 1024 1024\">...</svg>",
      "problem": "列表行的装饰性箭头 SVG 没有 aria-hidden=\"true\"，屏幕阅读器会读出无意义内容",
      "fix": "添加 aria-hidden=\"true\" 到所有装饰性 SVG 图标"
    },
    {
      "severity": "high",
      "category": "Accessibility",
      "rule": "Async updates need `aria-live=\"polite\"`",
      "location": "state_4 loading state (line ~1394)",
      "element": "<button ... disabled><span class=\"tf-cg-spinner\"></span><span>提交中</span></button>",
      "problem": "提交状态切换为 loading 时无 aria-live 通知，辅助技术用户感知不到状态变化",
      "fix": "在状态切换区域添加 <div aria-live=\"polite\" aria-atomic=\"true\"> 包裹或 role=\"status\""
    },
    {
      "severity": "medium",
      "category": "Animation",
      "rule": "Honor `prefers-reduced-motion`",
      "location": ".tf-cg-spinner @keyframes tf-cg-spin (line ~1400)",
      "element": ".tf-cg-spinner { animation: tf-cg-spin 1s linear infinite }",
      "problem": "spinner 旋转动画没有 prefers-reduced-motion 回退，对前庭障碍用户可能造成不适",
      "fix": "@media (prefers-reduced-motion: reduce) { .tf-cg-spinner { animation: none; border-top-color: #fff; opacity: 0.6; } }"
    },
    {
      "severity": "medium",
      "category": "Focus States",
      "rule": "Interactive elements need visible focus: `:focus-visible`",

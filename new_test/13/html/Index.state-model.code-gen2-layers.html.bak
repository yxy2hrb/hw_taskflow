#tf-state-5 .border{ border: 1px solid var(--color-border-subtle); }#tf-state-5 .border-b{ border-bottom: 1px solid var(--color-border-subtle); }#tf-state-5 .border-black{ border-color: #000; }#tf-state-5 .bg-transparent{ background: transparent; }#tf-state-5 .bg-white{ background-color: #fff; }#tf-state-5 .bg-\[var\(--color-primary\)\]{ background-color: var(--color-primary); }#tf-state-5 .bg-\[var\(--color-bg-hover\)\]{ background-color: var(--color-bg-hover); }#tf-state-5 .bg-\[var\(--color-primary-active\)\]{ background-color: var(--color-primary-active); }#tf-state-5 .text-white{ color: #fff; }#tf-state-5 .rounded-\[var\(--radius-xxs\)\]{ border-radius: var(--radius-xxs); }#tf-state-5 .rounded-\[var\(--radius-md\)\]{ border-radius: var(--radius-md); }#tf-state-5 .rounded-\[var\(--radius-lg\)\]{ border-radius: var(--radius-lg); }#tf-state-5 .rounded-\[var\(--radius-xl\)\]{ border-radius: var(--radius-xl); }#tf-state-5 .rounded-\[var\(--radius-2xl\)\]{ border-radius: var(--radius-2xl); }#tf-state-5 .rounded-\[var\(--radius-full\)\]{ border-radius: var(--radius-full); }#tf-state-5 .truncate{ overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }#tf-state-5 .whitespace-nowrap{ white-space: nowrap; }#tf-state-5 .text-left{ text-align: left; }#tf-state-5 .text-center{ text-align: center; }#tf-state-5 .p-0{ padding: 0; }#tf-state-5 .px-3{ padding-left: 12px; padding-right: 12px; }#tf-state-5 .px-4{ padding-left: 16px; padding-right: 16px; }#tf-state-5 .py-2{ padding-top: 8px; padding-bottom: 8px; }#tf-state-5 .py-2\.5{ padding-top: 10px; padding-bottom: 10px; }#tf-state-5 .py-16{ padding-top: 64px; padding-bottom: 64px; }#tf-state-5 .pl-\[var\(--spacing-lg\)\]{ padding-left: var(--spacing-lg); }#tf-state-5 .mt-2{ margin-top: 8px; }#tf-state-5 .mb-3{ margin-bottom: 12px; }#tf-state-5 .-top-0\.5{ top: -2px; }#tf-state-5 .-right-0\.5{ right: -2px; }#tf-state-5 .left-1\/2{ left: 50%; }#tf-state-5 .top-1\/2{ top: 50%; }#tf-state-5 .-translate-y-1\/2{ transform: translateY(-50%); }#tf-state-5 .rotate-180{ transform: rotate(180deg); }#tf-state-5 .gap-0{ gap: 0; }#tf-state-5 .gap-2{ gap: 8px; }#tf-state-5 .gap-4{ gap: 16px; }#tf-state-5 .grid-cols-3{ grid-template-columns: repeat(3, minmax(0, 1fr)); }#tf-state-5 .space-y-2 > * + *{ margin-top: 8px; }#tf-state-5 .transition-all,#tf-state-5 .transition-colors,#tf-state-5 .transition-opacity,#tf-state-5 .transition-transform{
  transition-duration: 150ms;
  transition-timing-function: ease;
}#tf-state-5 .duration-150{ transition-duration: 150ms; }#tf-state-5 .duration-200{ transition-duration: 200ms; }#tf-state-5 .opacity-40{ opacity: 0.4; }#tf-state-5 .line-clamp-2{
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}



@keyframes slide-in-right {
  from { transform: translateX(100%); }
  to   { transform: translateX(0); }
}
@keyframes slide-out-right {
  from { transform: translateX(0); }
  to   { transform: translateX(100%); }
}
@keyframes fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes slide-up {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}
@keyframes page-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}#tf-state-5 .animate-slide-in-right{ animation: slide-in-right 300ms ease-out forwards; }#tf-state-5 .animate-slide-out-right{ animation: slide-out-right 300ms ease-in forwards; }#tf-state-5 .fade-in{ animation: fade-in 300ms ease-out forwards; }#tf-state-5 .animate-slide-up{ animation: slide-up 300ms ease-out forwards; }#tf-state-5 .animate-page-in{ animation: page-in 150ms ease-out; }#tf-state-5 .tf-cg-bottom-bar{
  background: var(--color-bg-card);
  box-shadow: 0 -2px 12px 0 rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}#tf-state-5 .tf-cg-bottom-bar__inner{
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 100%;
  padding: 0 var(--spacing-lg);
  box-sizing: border-box;
}#tf-state-5 .tf-cg-bottom-bar__left{
  display: flex;
  align-items: center;
  gap: var(--spacing-lg);
  flex-shrink: 0;
}#tf-state-5 .tf-cg-bottom-bar__icon-btn{
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  min-width: 40px;
}#tf-state-5 .tf-cg-bottom-bar__icon-wrap{
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-primary);
  width: 24px;
  height: 24px;
}#tf-state-5 .tf-cg-bottom-bar__icon-label{
  font-size: var(--font-caption-10);
  line-height: var(--line-height-12);
  font-weight: var(--font-weight-regular);
  color: var(--color-text-secondary);
  white-space: nowrap;
}#tf-state-5 .tf-cg-bottom-bar__right{
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  flex: 1;
  justify-content: flex-end;
  margin-left: var(--spacing-lg);
}#tf-state-5 .tf-cg-bottom-bar__btn{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 40px;
  border-radius: var(--radius-full);
  font-size: var(--font-headline-16);
  line-height: var(--line-height-20);
  font-weight: var(--font-weight-medium);
  border: none;
  cursor: pointer;
  padding: 0 var(--spacing-xl);
  white-space: nowrap;
  -webkit-tap-highlight-color: transparent;
  transition: opacity 150ms ease;
  flex: 1;
  max-width: 140px;
}#tf-state-5 .tf-cg-bottom-bar__btn:active{
  opacity: 0.8;
}#tf-state-5 .tf-cg-bottom-bar__btn--secondary{
  background: var(--color-primary-soft);
  color: var(--color-primary);
}#tf-state-5 .tf-cg-bottom-bar__btn--primary{
  background: var(--color-primary);
  color: var(--color-text-white);
}

#tf-state-4 > [data-component-id="comments_card"],#tf-state-4 > [data-component-frame="comments_card"]{display:none!important;visibility:hidden!important;pointer-events:none!important}
#tf-state-5 > [data-component-id="product_info_card"],#tf-state-5 > [data-component-frame="product_info_card"]{display:none!important;visibility:hidden!important;pointer-events:none!important}
#tf-state-5 > [data-component-id="aftersales_card"],#tf-state-5 > [data-component-frame="aftersales_card"]{display:none!important;visibility:hidden!important;pointer-events:none!important}
#tf-state-5 > [data-component-id="tools_card"],#tf-state-5 > [data-component-frame="tools_card"]{display:none!important;visibility:hidden!important;pointer-events:none!important}
#tf-state-5 > [data-component-id="comments_card"],#tf-state-5 > [data-component-frame="comments_card"]{display:none!important;visibility:hidden!important;pointer-events:none!important}
#tf-state-6 > [data-component-id="config_overview_card"],#tf-state-6 > [data-component-frame="config_overview_card"]{display:none!important;visibility:hidden!important;pointer-events:none!important}

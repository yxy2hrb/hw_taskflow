translateY(-50%); }#tf-state-6 .rotate-180{ transform: rotate(180deg); }#tf-state-6 .gap-0{ gap: 0; }#tf-state-6 .gap-2{ gap: 8px; }#tf-state-6 .gap-4{ gap: 16px; }#tf-state-6 .grid-cols-3{ grid-template-columns: repeat(3, minmax(0, 1fr)); }#tf-state-6 .space-y-2 > * + *{ margin-top: 8px; }#tf-state-6 .transition-all,#tf-state-6 .transition-colors,#tf-state-6 .transition-opacity,#tf-state-6 .transition-transform{
  transition-duration: 150ms;
  transition-timing-function: ease;

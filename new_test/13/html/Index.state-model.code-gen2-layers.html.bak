@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Regular.ttf') format('truetype');
  font-weight: 400;
  font-display: swap;
}

@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Medium.ttf') format('truetype');
  font-weight: 500;
  font-display: swap;
}

@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Bold.ttf') format('truetype');
  font-weight: 600;
  font-display: swap;
}

@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Bold.ttf') format('truetype');
  font-weight: 700;
  font-display: swap;
}



@layer base {
  :root {
    
    --background: oklch(1 0 0);
    --foreground: var(--color-text-primary);
    --card: var(--color-bg-card);
    --card-foreground: var(--color-text-primary);
    --popover: var(--color-bg-card);
    --popover-foreground: var(--color-text-primary);
    --primary: var(--color-primary);
    --primary-foreground: var(--color-text-white);
    --secondary: var(--color-bg-hover);
    --secondary-foreground: var(--color-text-primary);
    --muted: var(--color-bg-disabled);
    --muted-foreground: var(--color-text-secondary);
    --accent: var(--color-primary-active);
    --accent-foreground: var(--color-primary);
    --destructive: var(--color-error);
    --destructive-foreground: var(--color-text-white);
    --border: var(--color-border-subtle);
    --input: var(--color-border-subtle);
    --ring: var(--color-primary);
    --radius: 0.625rem;
    --chart-1: oklch(0.87 0 0);
    --chart-2: oklch(0.556 0 0);
    --chart-3: oklch(0.439 0 0);
    --chart-4: oklch(0.371 0 0);
    --chart-5: oklch(0.269 0 0);
    --sidebar: oklch(0.985 0 0);
    --sidebar-foreground: var(--color-text-primary);
    --sidebar-primary: var(--color-primary);
    --sidebar-primary-foreground: var(--color-text-white);
    --sidebar-accent: var(--color-primary-active);
    --sidebar-accent-foreground: var(--color-primary);
    --sidebar-border: var(--color-border-subtle);
    --sidebar-ring: var(--color-primary);

    
    --color-text-primary:     rgba(0, 0, 0, 0.9);
    --color-text-secondary:   rgba(0, 0, 0, 0.6);
    --color-text-muted:       rgba(0, 0, 0, 0.4);
    --color-text-hint:        rgba(0, 0, 0, 0.4);
    --color-text-disabled:    rgba(0, 0, 0, 0.2);
    --color-text-white:       #ffffff;

    --color-primary: #C7000B;
    --color-primary-disabled: rgba(199, 0, 11, 0.4);
    --color-primary-soft: rgba(199, 0, 11, 0.05);
    --color-primary-active: rgba(199, 0, 11, 0.08);
    --color-orange: #FF8C42;

    --color-success: #10B981;
    --color-warning: #F97316;
    --color-error: #DC2626;

    --color-bg-page: #F2F3F5;
    --color-bg-card: #ffffff;
    --color-bg-hover: rgba(0, 0, 0, 0.04);
    --color-bg-disabled: rgba(0, 0, 0, 0.05);

    --color-border-subtle: rgba(0, 0, 0, 0.06);

    --color-divider-strong:  rgba(0, 0, 0, 0.6);
    --color-divider:         rgba(0, 0, 0, 0.1);
    --color-divider-subtle:  rgba(0, 0, 0, 0.05);
    --color-divider-faint:   rgba(0, 0, 0, 0.03);

    --color-mask: rgba(0, 0, 0, 0.3);

    --radius-xxs: 4px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 18px;
    --radius-2xl: 20px;
    --radius-3xl: 24px;
    --radius-4xl: 32px;
    --radius-full: 9999px;

    --shadow-sm: 0 1px 6px 0 rgba(0, 0, 0, 0.08);
    --shadow-md: 0 8px 24px 0 rgba(0, 0, 0, 0.08);
    --shadow-lg: 0 8px 24px 0 rgba(0, 0, 0, 0.16);
    --shadow-xl: 0 10px 20px 0 rgba(0, 0, 0, 0.15);

    --font-caption-10:  10px;
    --font-caption-12:  12px;
    --font-display-36: 36px;
    --font-display-48: 48px;
    --font-display-60: 60px;
    --font-headline-12: 12px;
    --font-headline-14: 14px;
    --font-headline-16: 16px;
    --font-headline-18: 18px;
    --font-headline-20: 20px;
    --font-headline-24: 24px;
    --font-body-12: 12px;
    --font-body-14: 14px;
    --font-body-16: 16px;

    --font-weight-regular:  400;
    --font-weight-medium:   500;
    --font-weight-semibold: 600;
    --font-weight-bold:     700;

    --line-height-12: 12px;
    --line-height-14: 14px;
    --line-height-16: 16px;
    --line-height-18: 18px;
    --line-height-20: 20px;
    --line-height-24: 24px;
    --line-height-26: 26px;
    --line-height-30: 30px;
    --line-height-32: 32px;
    --line-height-36: 36px;
    --line-height-48: 48px;
    --line-height-60: 60px;
    --line-height-64: 64px;
    --line-height-80: 80px;

    --spacing-xs: 4px;
    --spacing-sm: 6px;
    --spacing-md: 8px;
    --spacing-lg: 12px;
    --spacing-xl: 16px;
    --spacing-2xl: 24px;
  }

  .dark {
    --background: oklch(0.145 0 0);
    --foreground: oklch(0.985 0 0);
    --card: oklch(0.205 0 0);
    --card-foreground: oklch(0.985 0 0);
    --popover: oklch(0.205 0 0);
    --popover-foreground: oklch(0.985 0 0);
    --primary: var(--color-primary);
    --primary-foreground: var(--color-text-white);
    --secondary: oklch(0.269 0 0);
    --secondary-foreground: oklch(0.985 0 0);
    --muted: oklch(0.269 0 0);
    --muted-foreground: oklch(0.708 0 0);
    --accent: oklch(0.269 0 0);
    --accent-foreground: oklch(0.985 0 0);
    --destructive: var(--color-error);
    --destructive-foreground: var(--color-text-white);
    --border: oklch(1 0 0 / 10%);
    --input: oklch(1 0 0 / 15%);
    --ring: var(--color-primary);
    --chart-1: oklch(0.87 0 0);
    --chart-2: oklch(0.556 0 0);
    --chart-3: oklch(0.439 0 0);
    --chart-4: oklch(0.371 0 0);
    --chart-5: oklch(0.269 0 0);
    --sidebar: oklch(0.205 0 0);
    --sidebar-foreground: oklch(0.985 0 0);
    --sidebar-primary: oklch(0.488 0.243 264.376);
    --sidebar-primary-foreground: oklch(0.985 0 0);
    --sidebar-accent: oklch(0.269 0 0);
    --sidebar-accent-foreground: oklch(0.985 0 0);
    --sidebar-border: oklch(1 0 0 / 10%);
    --sidebar-ring: oklch(0.556 0 0);
  }

  * {
    @apply border-border;
    border-color: var(--color-border-subtle);
  }

  body {
    @apply bg-background text-foreground;
    font-family: 'HarmonyOS Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Noto Sans SC', sans-serif;
    background-color: var(--color-bg-page);
    color: var(--color-text-primary);
    -webkit-tap-highlight-color: transparent;
  }

  .theme {
    --font-heading: var(--font-sans);
    --font-sans: 'HarmonyOS Sans SC', sans-serif;
  }
  html {
    @apply font-sans;
  }
}



@layer components {
  
  .font-display-s { font-size: var(--font-display-36); line-height: var(--line-height-48); font-weight: var(--font-weight-medium); }
  .font-display-m { font-size: var(--font-display-48); line-height: var(--line-height-64); font-weight: var(--font-weight-medium); }
  .font-display-l { font-size: var(--font-display-60); line-height: var(--line-height-80); font-weight: var(--font-weight-medium); }

  
  .font-headline-xxs { font-size: var(--font-headline-12); line-height: var(--line-height-16); font-weight: var(--font-weight-medium); }
  .font-headline-xs  { font-size: var(--font-headline-14); line-height: var(--line-height-18); font-weight: var(--font-weight-medium); }
  .font-headline-s   { font-size: var(--font-headline-16); line-height: var(--line-height-20); font-weight: var(--font-weight-medium); }
  .font-headline-m   { font-size: var(--font-headline-18); line-height: var(--line-height-24); font-weight: var(--font-weight-medium); }
  .font-headline-l   { font-size: var(--font-headline-20); line-height: var(--line-height-26); font-weight: var(--font-weight-medium); }
  .font-headline-xl  { font-size: var(--font-headline-20); line-height: var(--line-height-26); font-weight: var(--font-weight-bold); }
  .font-headline-xxl { font-size: var(--font-headline-24); line-height: var(--line-height-32); font-weight: var(--font-weight-bold); }

  
  .font-headline-xs-multi { font-size: var(--font-headline-14); line-height: var(--line-height-20); font-weight: var(--font-weight-medium); }
  .font-headline-s-multi  { font-size: var(--font-headline-16); line-height: var(--line-height-24); font-weight: var(--font-weight-medium); }
  .font-headline-m-multi  { font-size: var(--font-headline-18); line-height: var(--line-height-26); font-weight: var(--font-weight-medium); }
  .font-headline-l-multi  { font-size: var(--font-headline-20); line-height: var(--line-height-30); font-weight: var(--font-weight-medium); }

  
  .font-body-s  { font-size: var(--font-body-12); line-height: var(--line-height-16); font-weight: var(--font-weight-regular); }
  .font-body-m  { font-size: var(--font-body-14); line-height: var(--line-height-18); font-weight: var(--font-weight-regular); }
  .font-body-l  { font-size: var(--font-body-16); line-height: var(--line-height-20); font-weight: var(--font-weight-regular); }

  
  .font-body-s-multi { font-size: var(--font-body-12); line-height: var(--line-height-18); font-weight: var(--font-weight-regular); }
  .font-body-m-multi { font-size: var(--font-body-14); line-height: var(--line-height-20); font-weight: var(--font-weight-regular); }
  .font-body-l-multi { font-size: var(--font-body-16); line-height: var(--line-height-24); font-weight: var(--font-weight-regular); }

  
  .font-caption-s { font-size: var(--font-caption-10); line-height: var(--line-height-12); font-weight: var(--font-weight-regular); }
  .font-caption-m { font-size: var(--font-caption-12); line-height: var(--line-height-16); font-weight: var(--font-weight-regular); }

  .font-caption-s-multi { font-size: var(--font-caption-10); line-height: var(--line-height-14); font-weight: var(--font-weight-regular); }
  .font-caption-m-multi { font-size: var(--font-caption-12); line-height: var(--line-height-18); font-weight: var(--font-weight-regular); }

  
  .p-page    { padding: var(--spacing-lg) var(--spacing-xl); }
  .p-card    { padding: var(--spacing-lg); }
  .p-card-sm { padding: var(--spacing-md); }
  .p-pill    { padding: var(--spacing-sm) var(--spacing-lg); }
  .p-tab     { padding: var(--spacing-xs) 0; }

  
  .size-icon-nav   { width: 40px; height: 40px; }
  .size-icon-entry { width: 48px; height: 48px; }
  .size-icon-card  { width: 40px; height: 40px; }
  .size-icon-sm    { width: 28px; height: 28px; }
  .size-badge      { width: 16px; height: 16px; font-size: 10px; }
  .size-icon-tab   { width: 30px; height: 30px; }
  .h-banner        { height: 140px; }

  
  .bg-gradient-layer-1 {
    width: 360px; height: 792px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.5) 0%, rgba(255,255,255,0) 100%),
      radial-gradient(circle 200px at 360px 140px, rgba(255,143,111,0.4) 0%, rgba(250,194,193,0) 100%),
      radial-gradient(circle 300px at 0px -100px, rgba(247,168,10,0.4) 0%, rgba(247,106,10,0) 100%),
      linear-gradient(180deg, #f6f6f5 0%, #f2f3f5 100%);
  }
  .bg-gradient-layer-2 {
    width: 360px; height: 792px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.4) 10%, rgba(255,255,255,0) 100%),
      radial-gradient(circle 231px at 320px 0px, rgba(255,143,111,0.2) 0%, rgba(250,194,193,0) 100%),
      radial-gradient(circle 271px at 85px -105px, rgba(247,168,10,0.2) 0%, rgba(247,106,10,0) 100%),
      linear-gradient(180deg, #f6f6f5 0%, #f2f3f5 100%);
  }
  .bg-gradient-layer-3 {
    width: 360px; height: 792px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.4) 10%, rgba(255,255,255,0) 100%),
      radial-gradient(circle 220px at 360px 0px, rgba(255,143,111,0.4) 0%, rgba(250,194,193,0) 100%),
      radial-gradient(circle 389px at 111px -284px, rgba(247,168,10,0.4) 0%, rgba(247,106,10,0) 100%),
      linear-gradient(180deg, #f6f6f5 0%, #f2f3f5 100%);
  }

  
  .tap-scale { transition: transform 150ms ease; }
  .tap-scale:active { transform: scale(0.98); }
  .tap-opacity:active { opacity: 0.8; }

  
  .flex-distribute { display: flex; align-items: center; justify-content: space-between; }
  .flex-center     { display: flex; align-items: center; }
  .flex-between    { display: flex; align-items: center; justify-content: space-between; }
  .scrollbar-hide { scrollbar-width: none; -ms-overflow-style: none; }
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .mobile-canvas,
  .mobile-canvas * { scrollbar-width: none; -ms-overflow-style: none; }
  .mobile-canvas::-webkit-scrollbar,
  .mobile-canvas *::-webkit-scrollbar { display: none; }

  
  .divider { border: none; border-top: 1px solid var(--color-divider); margin: 0; }
}#tf-state-4 .flex{ display: flex; }#tf-state-4 .inline-flex{ display: inline-flex; }#tf-state-4 .grid{ display: grid; }#tf-state-4 .block{ display: block; }#tf-state-4 .hidden{ display: none; }#tf-state-4 .flex-col{ flex-direction: column; }#tf-state-4 .flex-1{ flex: 1 1 0%; }#tf-state-4 .flex-shrink-0,#tf-state-4 .shrink-0{ flex-shrink: 0; }#tf-state-4 .items-start{ align-items: flex-start; }#tf-state-4 .items-center{ align-items: center; }#tf-state-4 .items-end{ align-items: flex-end; }#tf-state-4 .items-baseline{ align-items: baseline; }#tf-state-4 .justify-center{ justify-content: center; }#tf-state-4 .justify-between{ justify-content: space-between; }#tf-state-4 .relative{ position: relative; }#tf-state-4 .absolute{ position: absolute; }#tf-state-4 .fixed{ position: fixed; }#tf-state-4 .inset-0{ inset: 0; }#tf-state-4 .top-full{ top: 100%; }#tf-state-4 .left-0{ left: 0; }#tf-state-4 .right-0{ right: 0; }#tf-state-4 .top-0{ top: 0; }#tf-state-4 .bottom-0{ bottom: 0; }#tf-state-4 .z-10{ z-index: 10; }#tf-state-4 .z-40{ z-index: 40; }#tf-state-4 .z-50{ z-index: 50; }#tf-state-4 .w-full{ width: 100%; }#tf-state-4 .h-full{ height: 100%; }#tf-state-4 .w-5{ width: 20px; }#tf-state-4 .h-5{ height: 20px; }#tf-state-4 .w-8{ width: 32px; }#tf-state-4 .w-10{ width: 40px; }#tf-state-4 .h-10{ height: 40px; }#tf-state-4 .w-12{ width: 48px; }#tf-state-4 .h-12{ height: 48px; }#tf-state-4 .w-\[1px\]{ width: 1px; }#tf-state-4 .h-\[16px\]{ height: 16px; }#tf-state-4 .w-\[64px\]{ width: 64px; }#tf-state-4 .w-\[72px\]{ width: 72px; }#tf-state-4 .h-\[46px\]{ height: 46px; }#tf-state-4 .min-w-0{ min-width: 0; }#tf-state-4 .overflow-hidden{ overflow: hidden; }#tf-state-4 .overflow-x-auto{ overflow-x: auto; }#tf-state-4 .overflow-y-auto{ overflow-y: auto; }#tf-state-4 .overflow-x-hidden{ overflow-x: hidden; }#tf-state-4 .cursor-pointer{ cursor: pointer; }#tf-state-4 .pointer-events-none{ pointer-events: none; }#tf-state-4 .border-none{ border: none; }#tf-state-4 .border-0{ border: 0; }#tf-state-4 .border{ border: 1px solid var(--color-border-subtle); }#tf-state-4 .border-b{ border-bottom: 1px solid var(--color-border-subtle); }#tf-state-4 .border-black{ border-color: #000; }#tf-state-4 .bg-transparent{ background: transparent; }#tf-state-4 .bg-white{ background-color: #fff; }#tf-state-4 .bg-\[var\(--color-primary\)\]{ background-color: var(--color-primary); }#tf-state-4 .bg-\[var\(--color-bg-hover\)\]{ background-color: var(--color-bg-hover); }#tf-state-4 .bg-\[var\(--color-primary-active\)\]{ background-color: var(--color-primary-active); }#tf-state-4 .text-white{ color: #fff; }#tf-state-4 .rounded-\[var\(--radius-xxs\)\]{ border-radius: var(--radius-xxs); }#tf-state-4 .rounded-\[var\(--radius-md\)\]{ border-radius: var(--radius-md); }#tf-state-4 .rounded-\[var\(--radius-lg\)\]{ border-radius: var(--radius-lg); }#tf-state-4 .rounded-\[var\(--radius-xl\)\]{ border-radius: var(--radius-xl); }#tf-state-4 .rounded-\[var\(--radius-2xl\)\]{ border-radius: var(--radius-2xl); }#tf-state-4 .rounded-\[var\(--radius-full\)\]{ border-radius: var(--radius-full); }#tf-state-4 .truncate{ overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }#tf-state-4 .whitespace-nowrap{ white-space: nowrap; }#tf-state-4 .text-left{ text-align: left; }#tf-state-4 .text-center{ text-align: center; }#tf-state-4 .p-0{ padding: 0; }#tf-state-4 .px-3{ padding-left: 12px; padding-right: 12px; }#tf-state-4 .px-4{ padding-left: 16px; padding-right: 16px; }#tf-state-4 .py-2{ padding-top: 8px; padding-bottom: 8px; }#tf-state-4 .py-2\.5{ padding-top: 10px; padding-bottom: 10px; }#tf-state-4 .py-16{ padding-top: 64px; padding-bottom: 64px; }#tf-state-4 .pl-\[var\(--spacing-lg\)\]{ padding-left: var(--spacing-lg); }#tf-state-4 .mt-2{ margin-top: 8px; }#tf-state-4 .mb-3{ margin-bottom: 12px; }#tf-state-4 .-top-0\.5{ top: -2px; }#tf-state-4 .-right-0\.5{ right: -2px; }#tf-state-4 .left-1\/2{ left: 50%; }#tf-state-4 .top-1\/2{ top: 50%; }#tf-state-4 .-translate-y-1\/2{ transform: translateY(-50%); }#tf-state-4 .rotate-180{ transform: rotate(180deg); }#tf-state-4 .gap-0{ gap: 0; }#tf-state-4 .gap-2{ gap: 8px; }#tf-state-4 .gap-4{ gap: 16px; }#tf-state-4 .grid-cols-3{ grid-template-columns: repeat(3, minmax(0, 1fr)); }#tf-state-4 .space-y-2 > * + *{ margin-top: 8px; }#tf-state-4 .transition-all,#tf-state-4 .transition-colors,#tf-state-4 .transition-opacity,#tf-state-4 .transition-transform{
  transition-duration: 150ms;
  transition-timing-function: ease;
}#tf-state-4 .duration-150{ transition-duration: 150ms; }#tf-state-4 .duration-200{ transition-duration: 200ms; }#tf-state-4 .opacity-40{ opacity: 0.4; }#tf-state-4 .line-clamp-2{
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}



@keyframes slide-in-right {
  from { transform: translateX(100%); }
  to   { transform: translateX(0); }
}
@keyframes slide-out-right {
  from { transform: translateX(0); }
  to   { transform: translateX(100%); }
}
@keyframes fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes slide-up {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}
@keyframes page-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}#tf-state-4 .animate-slide-in-right{ animation: slide-in-right 300ms ease-out forwards; }#tf-state-4 .animate-slide-out-right{ animation: slide-out-right 300ms ease-in forwards; }#tf-state-4 .fade-in{ animation: fade-in 300ms ease-out forwards; }#tf-state-4 .animate-slide-up{ animation: slide-up 300ms ease-out forwards; }#tf-state-4 .animate-page-in{ animation: page-in 150ms ease-out; }#tf-state-4 .tf-cg-bottomsheet-root{
  position: absolute;
  top: 0;
  left: 0;
  width: 360px;
  height: 1200px;
  pointer-events: auto;
}#tf-state-4 .tf-cg-bottomsheet-mask{
  position: absolute;
  inset: 0;
  background: var(--color-mask);
}#tf-state-4 .tf-cg-bottomsheet-sheet{
  position: absolute;
  bottom: 0;
  left: 0;
  width: 360px;
  height: 420px;
  background: var(--color-bg-card);
  border-radius: var(--radius-2xl) var(--radius-2xl) 0 0;
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow-lg);
  overflow: hidden;
}#tf-state-4 .tf-cg-bottomsheet-header{
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-xl) var(--spacing-xl) var(--spacing-lg);
  flex-shrink: 0;
}#tf-state-4 .tf-cg-bottomsheet-title{
  font-size: var(--font-headline-16);
  line-height: var(--line-height-20);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}#tf-state-4 .tf-cg-bottomsheet-close{
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  border-radius: var(--radius-full);
  cursor: pointer;
  padding: 0;
  margin: -6px -6px -6px 0;
}#tf-state-4 .tf-cg-bottomsheet-close:active{
  background: var(--color-bg-hover);
}#tf-state-4 .tf-cg-bottomsheet-body{
  flex: 1;
  padding: 0 var(--spacing-xl);
  overflow-y: auto;
}#tf-state-4 .tf-cg-bottomsheet-label{
  display: block;
  font-size: var(--font-body-14);
  line-height: var(--line-height-18);
  font-weight: var(--font-weight-regular);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-md);
}#tf-state-4 .tf-cg-bottomsheet-input-wrap{
  width: 100%;
}#tf-state-4 .tf-cg-bottomsheet-input{
  width: 100%;
  height: 48px;
  padding: 0 var(--spacing-lg);
  border: 1px solid var(--color-border-subtle);
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
  font-size: var(--font-body-14);
  line-height: var(--line-height-18);
  font-weight: var(--font-weight-regular);
  color: var(--color-text-primary);
  outline: none;
  box-sizing: border-box;
  transition: border-color 150ms ease;
}#tf-state-4 .tf-cg-bottomsheet-input:focus{
  border-color: var(--color-primary);
}#tf-state-4 .tf-cg-bottomsheet-input::placeholder{
  color: var(--color-text-hint);
}#tf-state-4 .tf-cg-bottomsheet-footer{
  flex-shrink: 0;
  padding: var(--spacing-lg) var(--spacing-xl) var(--spacing-2xl);
}#tf-state-4 .tf-cg-bottomsheet-btn-primary{
  width: 100%;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary);
  color: var(--color-text-white);
  border: none;
  border-radius: var(--radius-full);
  font-size: var(--font-headline-16);
  line-height: var(--line-height-20);
  font-weight: var(--font-weight-medium);
  cursor: pointer;
  transition: opacity 150ms ease;
}#tf-state-4 .tf-cg-bottomsheet-btn-primary:active{
  opacity: 0.85;
}
/* component-codegen placeholder: top_nav_detail */


@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Regular.ttf') format('truetype');
  font-weight: 400;
  font-display: swap;
}

@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Medium.ttf') format('truetype');
  font-weight: 500;
  font-display: swap;
}

@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Bold.ttf') format('truetype');
  font-weight: 600;
  font-display: swap;
}

@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Bold.ttf') format('truetype');
  font-weight: 700;
  font-display: swap;
}



@layer base {
  :root {
    
    --background: oklch(1 0 0);
    --foreground: var(--color-text-primary);
    --card: var(--color-bg-card);
    --card-foreground: var(--color-text-primary);
    --popover: var(--color-bg-card);
    --popover-foreground: var(--color-text-primary);
    --primary: var(--color-primary);
    --primary-foreground: var(--color-text-white);
    --secondary: var(--color-bg-hover);
    --secondary-foreground: var(--color-text-primary);
    --muted: var(--color-bg-disabled);
    --muted-foreground: var(--color-text-secondary);
    --accent: var(--color-primary-active);
    --accent-foreground: var(--color-primary);
    --destructive: var(--color-error);
    --destructive-foreground: var(--color-text-white);
    --border: var(--color-border-subtle);
    --input: var(--color-border-subtle);
    --ring: var(--color-primary);
    --radius: 0.625rem;
    --chart-1: oklch(0.87 0 0);
    --chart-2: oklch(0.556 0 0);
    --chart-3: oklch(0.439 0 0);
    --chart-4: oklch(0.371 0 0);
    --chart-5: oklch(0.269 0 0);
    --sidebar: oklch(0.985 0 0);
    --sidebar-foreground: var(--color-text-primary);
    --sidebar-primary: var(--color-primary);
    --sidebar-primary-foreground: var(--color-text-white);
    --sidebar-accent: var(--color-primary-active);
    --sidebar-accent-foreground: var(--color-primary);
    --sidebar-border: var(--color-border-subtle);
    --sidebar-ring: var(--color-primary);

    
    --color-text-primary:     rgba(0, 0, 0, 0.9);
    --color-text-secondary:   rgba(0, 0, 0, 0.6);
    --color-text-muted:       rgba(0, 0, 0, 0.4);
    --color-text-hint:        rgba(0, 0, 0, 0.4);
    --color-text-disabled:    rgba(0, 0, 0, 0.2);
    --color-text-white:       #ffffff;

    --color-primary: #C7000B;
    --color-primary-disabled: rgba(199, 0, 11, 0.4);
    --color-primary-soft: rgba(199, 0, 11, 0.05);
    --color-primary-active: rgba(199, 0, 11, 0.08);
    --color-orange: #FF8C42;

    --color-success: #10B981;
    --color-warning: #F97316;
    --color-error: #DC2626;

    --color-bg-page: #F2F3F5;
    --color-bg-card: #ffffff;
    --color-bg-hover: rgba(0, 0, 0, 0.04);
    --color-bg-disabled: rgba(0, 0, 0, 0.05);

    --color-border-subtle: rgba(0, 0, 0, 0.06);

    --color-divider-strong:  rgba(0, 0, 0, 0.6);
    --color-divider:         rgba(0, 0, 0, 0.1);
    --color-divider-subtle:  rgba(0, 0, 0, 0.05);
    --color-divider-faint:   rgba(0, 0, 0, 0.03);

    --color-mask: rgba(0, 0, 0, 0.3);

    --radius-xxs: 4px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 18px;
    --radius-2xl: 20px;
    --radius-3xl: 24px;
    --radius-4xl: 32px;
    --radius-full: 9999px;

    --shadow-sm: 0 1px 6px 0 rgba(0, 0, 0, 0.08);
    --shadow-md: 0 8px 24px 0 rgba(0, 0, 0, 0.08);
    --shadow-lg: 0 8px 24px 0 rgba(0, 0, 0, 0.16);
    --shadow-xl: 0 10px 20px 0 rgba(0, 0, 0, 0.15);

    --font-caption-10:  10px;
    --font-caption-12:  12px;
    --font-display-36: 36px;
    --font-display-48: 48px;
    --font-display-60: 60px;
    --font-headline-12: 12px;
    --font-headline-14: 14px;
    --font-headline-16: 16px;
    --font-headline-18: 18px;
    --font-headline-20: 20px;
    --font-headline-24: 24px;
    --font-body-12: 12px;
    --font-body-14: 14px;
    --font-body-16: 16px;

    --font-weight-regular:  400;
    --font-weight-medium:   500;
    --font-weight-semibold: 600;
    --font-weight-bold:     700;

    --line-height-12: 12px;
    --line-height-14: 14px;
    --line-height-16: 16px;
    --line-height-18: 18px;
    --line-height-20: 20px;
    --line-height-24: 24px;
    --line-height-26: 26px;
    --line-height-30: 30px;
    --line-height-32: 32px;
    --line-height-36: 36px;
    --line-height-48: 48px;
    --line-height-60: 60px;
    --line-height-64: 64px;
    --line-height-80: 80px;

    --spacing-xs: 4px;
    --spacing-sm: 6px;
    --spacing-md: 8px;
    --spacing-lg: 12px;
    --spacing-xl: 16px;
    --spacing-2xl: 24px;
  }

  .dark {
    --background: oklch(0.145 0 0);
    --foreground: oklch(0.985 0 0);
    --card: oklch(0.205 0 0);
    --card-foreground: oklch(0.985 0 0);
    --popover: oklch(0.205 0 0);
    --popover-foreground: oklch(0.985 0 0);
    --primary: var(--color-primary);
    --primary-foreground: var(--color-text-white);
    --secondary: oklch(0.269 0 0);
    --secondary-foreground: oklch(0.985 0 0);
    --muted: oklch(0.269 0 0);
    --muted-foreground: oklch(0.708 0 0);
    --accent: oklch(0.269 0 0);
    --accent-foreground: oklch(0.985 0 0);
    --destructive: var(--color-error);
    --destructive-foreground: var(--color-text-white);
    --border: oklch(1 0 0 / 10%);
    --input: oklch(1 0 0 / 15%);
    --ring: var(--color-primary);
    --chart-1: oklch(0.87 0 0);
    --chart-2: oklch(0.556 0 0);
    --chart-3: oklch(0.439 0 0);
    --chart-4: oklch(0.371 0 0);
    --chart-5: oklch(0.269 0 0);
    --sidebar: oklch(0.205 0 0);
    --sidebar-foreground: oklch(0.985 0 0);
    --sidebar-primary: oklch(0.488 0.243 264.376);
    --sidebar-primary-foreground: oklch(0.985 0 0);
    --sidebar-accent: oklch(0.269 0 0);
    --sidebar-accent-foreground: oklch(0.985 0 0);
    --sidebar-border: oklch(1 0 0 / 10%);
    --sidebar-ring: oklch(0.556 0 0);
  }

  * {
    @apply border-border;
    border-color: var(--color-border-subtle);
  }

  body {
    @apply bg-background text-foreground;
    font-family: 'HarmonyOS Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Noto Sans SC', sans-serif;
    background-color: var(--color-bg-page);
    color: var(--color-text-primary);
    -webkit-tap-highlight-color: transparent;
  }

  .theme {
    --font-heading: var(--font-sans);
    --font-sans: 'HarmonyOS Sans SC', sans-serif;
  }
  html {
    @apply font-sans;
  }
}



@layer components {
  
  .font-display-s { font-size: var(--font-display-36); line-height: var(--line-height-48); font-weight: var(--font-weight-medium); }
  .font-display-m { font-size: var(--font-display-48); line-height: var(--line-height-64); font-weight: var(--font-weight-medium); }
  .font-display-l { font-size: var(--font-display-60); line-height: var(--line-height-80); font-weight: var(--font-weight-medium); }

  
  .font-headline-xxs { font-size: var(--font-headline-12); line-height: var(--line-height-16); font-weight: var(--font-weight-medium); }
  .font-headline-xs  { font-size: var(--font-headline-14); line-height: var(--line-height-18); font-weight: var(--font-weight-medium); }
  .font-headline-s   { font-size: var(--font-headline-16); line-height: var(--line-height-20); font-weight: var(--font-weight-medium); }
  .font-headline-m   { font-size: var(--font-headline-18); line-height: var(--line-height-24); font-weight: var(--font-weight-medium); }
  .font-headline-l   { font-size: var(--font-headline-20); line-height: var(--line-height-26); font-weight: var(--font-weight-medium); }
  .font-headline-xl  { font-size: var(--font-headline-20); line-height: var(--line-height-26); font-weight: var(--font-weight-bold); }
  .font-headline-xxl { font-size: var(--font-headline-24); line-height: var(--line-height-32); font-weight: var(--font-weight-bold); }

  
  .font-headline-xs-multi { font-size: var(--font-headline-14); line-height: var(--line-height-20); font-weight: var(--font-weight-medium); }
  .font-headline-s-multi  { font-size: var(--font-headline-16); line-height: var(--line-height-24); font-weight: var(--font-weight-medium); }
  .font-headline-m-multi  { font-size: var(--font-headline-18); line-height: var(--line-height-26); font-weight: var(--font-weight-medium); }
  .font-headline-l-multi  { font-size: var(--font-headline-20); line-height: var(--line-height-30); font-weight: var(--font-weight-medium); }

  
  .font-body-s  { font-size: var(--font-body-12); line-height: var(--line-height-16); font-weight: var(--font-weight-regular); }
  .font-body-m  { font-size: var(--font-body-14); line-height: var(--line-height-18); font-weight: var(--font-weight-regular); }
  .font-body-l  { font-size: var(--font-body-16); line-height: var(--line-height-20); font-weight: var(--font-weight-regular); }

  
  .font-body-s-multi { font-size: var(--font-body-12); line-height: var(--line-height-18); font-weight: var(--font-weight-regular); }
  .font-body-m-multi { font-size: var(--font-body-14); line-height: var(--line-height-20); font-weight: var(--font-weight-regular); }
  .font-body-l-multi { font-size: var(--font-body-16); line-height: var(--line-height-24); font-weight: var(--font-weight-regular); }

  
  .font-caption-s { font-size: var(--font-caption-10); line-height: var(--line-height-12); font-weight: var(--font-weight-regular); }
  .font-caption-m { font-size: var(--font-caption-12); line-height: var(--line-height-16); font-weight: var(--font-weight-regular); }

  .font-caption-s-multi { font-size: var(--font-caption-10); line-height: var(--line-height-14); font-weight: var(--font-weight-regular); }
  .font-caption-m-multi { font-size: var(--font-caption-12); line-height: var(--line-height-18); font-weight: var(--font-weight-regular); }

  
  .p-page    { padding: var(--spacing-lg) var(--spacing-xl); }
  .p-card    { padding: var(--spacing-lg); }
  .p-card-sm { padding: var(--spacing-md); }
  .p-pill    { padding: var(--spacing-sm) var(--spacing-lg); }
  .p-tab     { padding: var(--spacing-xs) 0; }

  
  .size-icon-nav   { width: 40px; height: 40px; }
  .size-icon-entry { width: 48px; height: 48px; }
  .size-icon-card  { width: 40px; height: 40px; }
  .size-icon-sm    { width: 28px; height: 28px; }
  .size-badge      { width: 16px; height: 16px; font-size: 10px; }
  .size-icon-tab   { width: 30px; height: 30px; }
  .h-banner        { height: 140px; }

  
  .bg-gradient-layer-1 {
    width: 360px; height: 792px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.5) 0%, rgba(255,255,255,0) 100%),
      radial-gradient(circle 200px at 360px 140px, rgba(255,143,111,0.4) 0%, rgba(250,194,193,0) 100%),
      radial-gradient(circle 300px at 0px -100px, rgba(247,168,10,0.4) 0%, rgba(247,106,10,0) 100%),
      linear-gradient(180deg, #f6f6f5 0%, #f2f3f5 100%);
  }
  .bg-gradient-layer-2 {
    width: 360px; height: 792px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.4) 10%, rgba(255,255,255,0) 100%),
      radial-gradient(circle 231px at 320px 0px, rgba(255,143,111,0.2) 0%, rgba(250,194,193,0) 100%),
      radial-gradient(circle 271px at 85px -105px, rgba(247,168,10,0.2) 0%, rgba(247,106,10,0) 100%),
      linear-gradient(180deg, #f6f6f5 0%, #f2f3f5 100%);
  }
  .bg-gradient-layer-3 {
    width: 360px; height: 792px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.4) 10%, rgba(255,255,255,0) 100%),
      radial-gradient(circle 220px at 360px 0px, rgba(255,143,111,0.4) 0%, rgba(250,194,193,0) 100%),
      radial-gradient(circle 389px at 111px -284px, rgba(247,168,10,0.4) 0%, rgba(247,106,10,0) 100%),
      linear-gradient(180deg, #f6f6f5 0%, #f2f3f5 100%);
  }

  
  .tap-scale { transition: transform 150ms ease; }
  .tap-scale:active { transform: scale(0.98); }
  .tap-opacity:active { opacity: 0.8; }

  
  .flex-distribute { display: flex; align-items: center; justify-content: space-between; }
  .flex-center     { display: flex; align-items: center; }
  .flex-between    { display: flex; align-items: center; justify-content: space-between; }
  .scrollbar-hide { scrollbar-width: none; -ms-overflow-style: none; }
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .mobile-canvas,
  .mobile-canvas * { scrollbar-width: none; -ms-overflow-style: none; }
  .mobile-canvas::-webkit-scrollbar,
  .mobile-canvas *::-webkit-scrollbar { display: none; }

  
  .divider { border: none; border-top: 1px solid var(--color-divider); margin: 0; }
}#tf-state-5 .flex{ display: flex; }#tf-state-5 .inline-flex{ display: inline-flex; }#tf-state-5 .grid{ display: grid; }#tf-state-5 .block{ display: block; }#tf-state-5 .hidden{ display: none; }#tf-state-5 .flex-col{ flex-direction: column; }#tf-state-5 .flex-1{ flex: 1 1 0%; }#tf-state-5 .flex-shrink-0,#tf-state-5 .shrink-0{ flex-shrink: 0; }#tf-state-5 .items-start{ align-items: flex-start; }#tf-state-5 .items-center{ align-items: center; }#tf-state-5 .items-end{ align-items: flex-end; }#tf-state-5 .items-baseline{ align-items: baseline; }#tf-state-5 .justify-center{ justify-content: center; }#tf-state-5 .justify-between{ justify-content: space-between; }#tf-state-5 .relative{ position: relative; }#tf-state-5 .absolute{ position: absolute; }#tf-state-5 .fixed{ position: fixed; }#tf-state-5 .inset-0{ inset: 0; }#tf-state-5 .top-full{ top: 100%; }#tf-state-5 .left-0{ left: 0; }#tf-state-5 .right-0{ right: 0; }#tf-state-5 .top-0{ top: 0; }#tf-state-5 .bottom-0{ bottom: 0; }#tf-state-5 .z-10{ z-index: 10; }#tf-state-5 .z-40{ z-index: 40; }#tf-state-5 .z-50{ z-index: 50; }#tf-state-5 .w-full{ width: 100%; }#tf-state-5 .h-full{ height: 100%; }#tf-state-5 .w-5{ width: 20px; }#tf-state-5 .h-5{ height: 20px; }#tf-state-5 .w-8{ width: 32px; }#tf-state-5 .w-10{ width: 40px; }#tf-state-5 .h-10{ height: 40px; }#tf-state-5 .w-12{ width: 48px; }#tf-state-5 .h-12{ height: 48px; }#tf-state-5 .w-\[1px\]{ width: 1px; }#tf-state-5 .h-\[16px\]{ height: 16px; }#tf-state-5 .w-\[64px\]{ width: 64px; }#tf-state-5 .w-\[72px\]{ width: 72px; }#tf-state-5 .h-\[46px\]{ height: 46px; }#tf-state-5 .min-w-0{ min-width: 0; }#tf-state-5 .overflow-hidden{ overflow: hidden; }#tf-state-5 .overflow-x-auto{ overflow-x: auto; }#tf-state-5 .overflow-y-auto{ overflow-y: auto; }#tf-state-5 .overflow-x-hidden{ overflow-x: hidden; }#tf-state-5 .cursor-pointer{ cursor: pointer; }#tf-state-5 .pointer-events-none{ pointer-events: none; }#tf-state-5 .border-none{ border: none; }#tf-state-5 .border-0{ border: 0; }#tf-state-5 .border{ border: 1px solid var(--color-border-subtle); }#tf-state-5 .border-b{ border-bottom: 1px solid var(--color-border-subtle); }#tf-state-5 .border-black{ border-color: #000; }#tf-state-5 .bg-transparent{ background: transparent; }#tf-state-5 .bg-white{ background-color: #fff; }#tf-state-5 .bg-\[var\(--color-primary\)\]{ background-color: var(--color-primary); }#tf-state-5 .bg-\[var\(--color-bg-hover\)\]{ background-color: var(--color-bg-hover); }#tf-state-5 .bg-\[var\(--color-primary-active\)\]{ background-color: var(--color-primary-active); }#tf-state-5 .text-white{ color: #fff; }#tf-state-5 .rounded-\[var\(--radius-xxs\)\]{ border-radius: var(--radius-xxs); }#tf-state-5 .rounded-\[var\(--radius-md\)\]{ border-radius: var(--radius-md); }#tf-state-5 .rounded-\[var\(--radius-lg\)\]{ border-radius: var(--radius-lg); }#tf-state-5 .rounded-\[var\(--radius-xl\)\]{ border-radius: var(--radius-xl); }#tf-state-5 .rounded-\[var\(--radius-2xl\)\]{ border-radius: var(--radius-2xl); }#tf-state-5 .rounded-\[var\(--radius-full\)\]{ border-radius: var(--radius-full); }#tf-state-5 .truncate{ overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }#tf-state-5 .whitespace-nowrap{ white-space: nowrap; }#tf-state-5 .text-left{ text-align: left; }#tf-state-5 .text-center{ text-align: center; }#tf-state-5 .p-0{ padding: 0; }#tf-state-5 .px-3{ padding-left: 12px; padding-right: 12px; }#tf-state-5 .px-4{ padding-left: 16px; padding-right: 16px; }#tf-state-5 .py-2{ padding-top: 8px; padding-bottom: 8px; }#tf-state-5 .py-2\.5{ padding-top: 10px; padding-bottom: 10px; }#tf-state-5 .py-16{ padding-top: 64px; padding-bottom: 64px; }#tf-state-5 .pl-\[var\(--spacing-lg\)\]{ padding-left: var(--spacing-lg); }#tf-state-5 .mt-2{ margin-top: 8px; }#tf-state-5 .mb-3{ margin-bottom: 12px; }#tf-state-5 .-top-0\.5{ top: -2px; }#tf-state-5 .-right-0\.5{ right: -2px; }#tf-state-5 .left-1\/2{ left: 50%; }#tf-state-5 .top-1\/2{ top: 50%; }#tf-state-5 .-translate-y-1\/2{ transform: translateY(-50%); }#tf-state-5 .rotate-180{ transform: rotate(180deg); }#tf-state-5 .gap-0{ gap: 0; }#tf-state-5 .gap-2{ gap: 8px; }#tf-state-5 .gap-4{ gap: 16px; }#tf-state-5 .grid-cols-3{ grid-template-columns: repeat(3, minmax(0, 1fr)); }#tf-state-5 .space-y-2 > * + *{ margin-top: 8px; }#tf-state-5 .transition-all,#tf-state-5 .transition-colors,#tf-state-5 .transition-opacity,#tf-state-5 .transition-transform{
  transition-duration: 150ms;
  transition-timing-function: ease;
}#tf-state-5 .duration-150{ transition-duration: 150ms; }#tf-state-5 .duration-200{ transition-duration: 200ms; }#tf-state-5 .opacity-40{ opacity: 0.4; }#tf-state-5 .line-clamp-2{
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}



@keyframes slide-in-right {
  from { transform: translateX(100%); }
  to   { transform: translateX(0); }
}
@keyframes slide-out-right {
  from { transform: translateX(0); }
  to   { transform: translateX(100%); }
}
@keyframes fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes slide-up {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}
@keyframes page-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}#tf-state-5 .animate-slide-in-right{ animation: slide-in-right 300ms ease-out forwards; }#tf-state-5 .animate-slide-out-right{ animation: slide-out-right 300ms ease-in forwards; }#tf-state-5 .fade-in{ animation: fade-in 300ms ease-out forwards; }#tf-state-5 .animate-slide-up{ animation: slide-up 300ms ease-out forwards; }#tf-state-5 .animate-page-in{ animation: page-in 150ms ease-out; }#tf-state-5 [data-component-id="top_nav_detail"]{
  pointer-events: auto;
}#tf-state-5 [data-component-id="top_nav_detail"] button:active{
  opacity: 0.7;
}
/* component-codegen placeholder: product_image_carousel */


@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Regular.ttf') format('truetype');
  font-weight: 400;
  font-display: swap;
}

@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Medium.ttf') format('truetype');
  font-weight: 500;
  font-display: swap;
}

@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Bold.ttf') format('truetype');
  font-weight: 600;
  font-display: swap;
}

@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Bold.ttf') format('truetype');
  font-weight: 700;
  font-display: swap;
}



@layer base {
  :root {
    
    --background: oklch(1 0 0);
    --foreground: var(--color-text-primary);
    --card: var(--color-bg-card);
    --card-foreground: var(--color-text-primary);
    --popover: var(--color-bg-card);
    --popover-foreground: var(--color-text-primary);
    --primary: var(--color-primary);
    --primary-foreground: var(--color-text-white);
    --secondary: var(--color-bg-hover);
    --secondary-foreground: var(--color-text-primary);
    --muted: var(--color-bg-disabled);
    --muted-foreground: var(--color-text-secondary);
    --accent: var(--color-primary-active);
    --accent-foreground: var(--color-primary);
    --destructive: var(--color-error);
    --destructive-foreground: var(--color-text-white);
    --border: var(--color-border-subtle);
    --input: var(--color-border-subtle);
    --ring: var(--color-primary);
    --radius: 0.625rem;
    --chart-1: oklch(0.87 0 0);
    --chart-2: oklch(0.556 0 0);
    --chart-3: oklch(0.439 0 0);
    --chart-4: oklch(0.371 0 0);
    --chart-5: oklch(0.269 0 0);
    --sidebar: oklch(0.985 0 0);
    --sidebar-foreground: var(--color-text-primary);
    --sidebar-primary: var(--color-primary);
    --sidebar-primary-foreground: var(--color-text-white);
    --sidebar-accent: var(--color-primary-active);
    --sidebar-accent-foreground: var(--color-primary);
    --sidebar-border: var(--color-border-subtle);
    --sidebar-ring: var(--color-primary);

    
    --color-text-primary:     rgba(0, 0, 0, 0.9);
    --color-text-secondary:   rgba(0, 0, 0, 0.6);
    --color-text-muted:       rgba(0, 0, 0, 0.4);
    --color-text-hint:        rgba(0, 0, 0, 0.4);
    --color-text-disabled:    rgba(0, 0, 0, 0.2);
    --color-text-white:       #ffffff;

    --color-primary: #C7000B;
    --color-primary-disabled: rgba(199, 0, 11, 0.4);
    --color-primary-soft: rgba(199, 0, 11, 0.05);
    --color-primary-active: rgba(199, 0, 11, 0.08);
    --color-orange: #FF8C42;

    --color-success: #10B981;
    --color-warning: #F97316;
    --color-error: #DC2626;

    --color-bg-page: #F2F3F5;
    --color-bg-card: #ffffff;
    --color-bg-hover: rgba(0, 0, 0, 0.04);
    --color-bg-disabled: rgba(0, 0, 0, 0.05);

    --color-border-subtle: rgba(0, 0, 0, 0.06);

    --color-divider-strong:  rgba(0, 0, 0, 0.6);
    --color-divider:         rgba(0, 0, 0, 0.1);
    --color-divider-subtle:  rgba(0, 0, 0, 0.05);
    --color-divider-faint:   rgba(0, 0, 0, 0.03);

    --color-mask: rgba(0, 0, 0, 0.3);

    --radius-xxs: 4px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 18px;
    --radius-2xl: 20px;
    --radius-3xl: 24px;
    --radius-4xl: 32px;
    --radius-full: 9999px;

    --shadow-sm: 0 1px 6px 0 rgba(0, 0, 0, 0.08);
    --shadow-md: 0 8px 24px 0 rgba(0, 0, 0, 0.08);
    --shadow-lg: 0 8px 24px 0 rgba(0, 0, 0, 0.16);
    --shadow-xl: 0 10px 20px 0 rgba(0, 0, 0, 0.15);

    --font-caption-10:  10px;
    --font-caption-12:  12px;
    --font-display-36: 36px;
    --font-display-48: 48px;
    --font-display-60: 60px;
    --font-headline-12: 12px;
    --font-headline-14: 14px;
    --font-headline-16: 16px;
    --font-headline-18: 18px;
    --font-headline-20: 20px;
    --font-headline-24: 24px;
    --font-body-12: 12px;
    --font-body-14: 14px;
    --font-body-16: 16px;

    --font-weight-regular:  400;
    --font-weight-medium:   500;
    --font-weight-semibold: 600;
    --font-weight-bold:     700;

    --line-height-12: 12px;
    --line-height-14: 14px;
    --line-height-16: 16px;
    --line-height-18: 18px;
    --line-height-20: 20px;
    --line-height-24: 24px;
    --line-height-26: 26px;
    --line-height-30: 30px;
    --line-height-32: 32px;
    --line-height-36: 36px;
    --line-height-48: 48px;
    --line-height-60: 60px;
    --line-height-64: 64px;
    --line-height-80: 80px;

    --spacing-xs: 4px;
    --spacing-sm: 6px;
    --spacing-md: 8px;
    --spacing-lg: 12px;
    --spacing-xl: 16px;
    --spacing-2xl: 24px;
  }

  .dark {
    --background: oklch(0.145 0 0);
    --foreground: oklch(0.985 0 0);
    --card: oklch(0.205 0 0);
    --card-foreground: oklch(0.985 0 0);
    --popover: oklch(0.205 0 0);
    --popover-foreground: oklch(0.985 0 0);
    --primary: var(--color-primary);
    --primary-foreground: var(--color-text-white);
    --secondary: oklch(0.269 0 0);
    --secondary-foreground: oklch(0.985 0 0);
    --muted: oklch(0.269 0 0);
    --muted-foreground: oklch(0.708 0 0);
    --accent: oklch(0.269 0 0);
    --accent-foreground: oklch(0.985 0 0);
    --destructive: var(--color-error);
    --destructive-foreground: var(--color-text-white);
    --border: oklch(1 0 0 / 10%);
    --input: oklch(1 0 0 / 15%);
    --ring: var(--color-primary);
    --chart-1: oklch(0.87 0 0);
    --chart-2: oklch(0.556 0 0);
    --chart-3: oklch(0.439 0 0);
    --chart-4: oklch(0.371 0 0);
    --chart-5: oklch(0.269 0 0);
    --sidebar: oklch(0.205 0 0);
    --sidebar-foreground: oklch(0.985 0 0);
    --sidebar-primary: oklch(0.488 0.243 264.376);
    --sidebar-primary-foreground: oklch(0.985 0 0);
    --sidebar-accent: oklch(0.269 0 0);
    --sidebar-accent-foreground: oklch(0.985 0 0);
    --sidebar-border: oklch(1 0 0 / 10%);
    --sidebar-ring: oklch(0.556 0 0);
  }

  * {
    @apply border-border;
    border-color: var(--color-border-subtle);
  }

  body {
    @apply bg-background text-foreground;
    font-family: 'HarmonyOS Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Noto Sans SC', sans-serif;
    background-color: var(--color-bg-page);
    color: var(--color-text-primary);
    -webkit-tap-highlight-color: transparent;
  }

  .theme {
    --font-heading: var(--font-sans);
    --font-sans: 'HarmonyOS Sans SC', sans-serif;
  }
  html {
    @apply font-sans;
  }
}



@layer components {
  
  .font-display-s { font-size: var(--font-display-36); line-height: var(--line-height-48); font-weight: var(--font-weight-medium); }
  .font-display-m { font-size: var(--font-display-48); line-height: var(--line-height-64); font-weight: var(--font-weight-medium); }
  .font-display-l { font-size: var(--font-display-60); line-height: var(--line-height-80); font-weight: var(--font-weight-medium); }

  
  .font-headline-xxs { font-size: var(--font-headline-12); line-height: var(--line-height-16); font-weight: var(--font-weight-medium); }
  .font-headline-xs  { font-size: var(--font-headline-14); line-height: var(--line-height-18); font-weight: var(--font-weight-medium); }
  .font-headline-s   { font-size: var(--font-headline-16); line-height: var(--line-height-20); font-weight: var(--font-weight-medium); }
  .font-headline-m   { font-size: var(--font-headline-18); line-height: var(--line-height-24); font-weight: var(--font-weight-medium); }
  .font-headline-l   { font-size: var(--font-headline-20); line-height: var(--line-height-26); font-weight: var(--font-weight-medium); }
  .font-headline-xl  { font-size: var(--font-headline-20); line-height: var(--line-height-26); font-weight: var(--font-weight-bold); }
  .font-headline-xxl { font-size: var(--font-headline-24); line-height: var(--line-height-32); font-weight: var(--font-weight-bold); }

  
  .font-headline-xs-multi { font-size: var(--font-headline-14); line-height: var(--line-height-20); font-weight: var(--font-weight-medium); }
  .font-headline-s-multi  { font-size: var(--font-headline-16); line-height: var(--line-height-24); font-weight: var(--font-weight-medium); }
  .font-headline-m-multi  { font-size: var(--font-headline-18); line-height: var(--line-height-26); font-weight: var(--font-weight-medium); }
  .font-headline-l-multi  { font-size: var(--font-headline-20); line-height: var(--line-height-30); font-weight: var(--font-weight-medium); }

  
  .font-body-s  { font-size: var(--font-body-12); line-height: var(--line-height-16); font-weight: var(--font-weight-regular); }
  .font-body-m  { font-size: var(--font-body-14); line-height: var(--line-height-18); font-weight: var(--font-weight-regular); }
  .font-body-l  { font-size: var(--font-body-16); line-height: var(--line-height-20); font-weight: var(--font-weight-regular); }

  
  .font-body-s-multi { font-size: var(--font-body-12); line-height: var(--line-height-18); font-weight: var(--font-weight-regular); }
  .font-body-m-multi { font-size: var(--font-body-14); line-height: var(--line-height-20); font-weight: var(--font-weight-regular); }
  .font-body-l-multi { font-size: var(--font-body-16); line-height: var(--line-height-24); font-weight: var(--font-weight-regular); }

  
  .font-caption-s { font-size: var(--font-caption-10); line-height: var(--line-height-12); font-weight: var(--font-weight-regular); }
  .font-caption-m { font-size: var(--font-caption-12); line-height: var(--line-height-16); font-weight: var(--font-weight-regular); }

  .font-caption-s-multi { font-size: var(--font-caption-10); line-height: var(--line-height-14); font-weight: var(--font-weight-regular); }
  .font-caption-m-multi { font-size: var(--font-caption-12); line-height: var(--line-height-18); font-weight: var(--font-weight-regular); }

  
  .p-page    { padding: var(--spacing-lg) var(--spacing-xl); }
  .p-card    { padding: var(--spacing-lg); }
  .p-card-sm { padding: var(--spacing-md); }
  .p-pill    { padding: var(--spacing-sm) var(--spacing-lg); }
  .p-tab     { padding: var(--spacing-xs) 0; }

  
  .size-icon-nav   { width: 40px; height: 40px; }
  .size-icon-entry { width: 48px; height: 48px; }
  .size-icon-card  { width: 40px; height: 40px; }
  .size-icon-sm    { width: 28px; height: 28px; }
  .size-badge      { width: 16px; height: 16px; font-size: 10px; }
  .size-icon-tab   { width: 30px; height: 30px; }
  .h-banner        { height: 140px; }

  
  .bg-gradient-layer-1 {
    width: 360px; height: 792px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.5) 0%, rgba(255,255,255,0) 100%),
      radial-gradient(circle 200px at 360px 140px, rgba(255,143,111,0.4) 0%, rgba(250,194,193,0) 100%),
      radial-gradient(circle 300px at 0px -100px, rgba(247,168,10,0.4) 0%, rgba(247,106,10,0) 100%),
      linear-gradient(180deg, #f6f6f5 0%, #f2f3f5 100%);
  }
  .bg-gradient-layer-2 {
    width: 360px; height: 792px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.4) 10%, rgba(255,255,255,0) 100%),
      radial-gradient(circle 231px at 320px 0px, rgba(255,143,111,0.2) 0%, rgba(250,194,193,0) 100%),
      radial-gradient(circle 271px at 85px -105px, rgba(247,168,10,0.2) 0%, rgba(247,106,10,0) 100%),
      linear-gradient(180deg, #f6f6f5 0%, #f2f3f5 100%);
  }
  .bg-gradient-layer-3 {
    width: 360px; height: 792px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.4) 10%, rgba(255,255,255,0) 100%),
      radial-gradient(circle 220px at 360px 0px, rgba(255,143,111,0.4) 0%, rgba(250,194,193,0) 100%),
      radial-gradient(circle 389px at 111px -284px, rgba(247,168,10,0.4) 0%, rgba(247,106,10,0) 100%),
      linear-gradient(180deg, #f6f6f5 0%, #f2f3f5 100%);
  }

  
  .tap-scale { transition: transform 150ms ease; }
  .tap-scale:active { transform: scale(0.98); }
  .tap-opacity:active { opacity: 0.8; }

  
  .flex-distribute { display: flex; align-items: center; justify-content: space-between; }
  .flex-center     { display: flex; align-items: center; }
  .flex-between    { display: flex; align-items: center; justify-content: space-between; }
  .scrollbar-hide { scrollbar-width: none; -ms-overflow-style: none; }
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .mobile-canvas,
  .mobile-canvas * { scrollbar-width: none; -ms-overflow-style: none; }
  .mobile-canvas::-webkit-scrollbar,
  .mobile-canvas *::-webkit-scrollbar { display: none; }

  
  .divider { border: none; border-top: 1px solid var(--color-divider); margin: 0; }
}#tf-state-5 .flex{ display: flex; }#tf-state-5 .inline-flex{ display: inline-flex; }#tf-state-5 .grid{ display: grid; }#tf-state-5 .block{ display: block; }#tf-state-5 .hidden{ display: none; }#tf-state-5 .flex-col{ flex-direction: column; }#tf-state-5 .flex-1{ flex: 1 1 0%; }#tf-state-5 .flex-shrink-0,#tf-state-5 .shrink-0{ flex-shrink: 0; }#tf-state-5 .items-start{ align-items: flex-start; }#tf-state-5 .items-center{ align-items: center; }#tf-state-5 .items-end{ align-items: flex-end; }#tf-state-5 .items-baseline{ align-items: baseline; }#tf-state-5 .justify-center{ justify-content: center; }#tf-state-5 .justify-between{ justify-content: space-between; }#tf-state-5 .relative{ position: relative; }#tf-state-5 .absolute{ position: absolute; }#tf-state-5 .fixed{ position: fixed; }#tf-state-5 .inset-0{ inset: 0; }#tf-state-5 .top-full{ top: 100%; }#tf-state-5 .left-0{ left: 0; }#tf-state-5 .right-0{ right: 0; }#tf-state-5 .top-0{ top: 0; }#tf-state-5 .bottom-0{ bottom: 0; }#tf-state-5 .z-10{ z-index: 10; }#tf-state-5 .z-40{ z-index: 40; }#tf-state-5 .z-50{ z-index: 50; }#tf-state-5 .w-full{ width: 100%; }#tf-state-5 .h-full{ height: 100%; }#tf-state-5 .w-5{ width: 20px; }#tf-state-5 .h-5{ height: 20px; }#tf-state-5 .w-8{ width: 32px; }#tf-state-5 .w-10{ width: 40px; }#tf-state-5 .h-10{ height: 40px; }#tf-state-5 .w-12{ width: 48px; }#tf-state-5 .h-12{ height: 48px; }#tf-state-5 .w-\[1px\]{ width: 1px; }#tf-state-5 .h-\[16px\]{ height: 16px; }#tf-state-5 .w-\[64px\]{ width: 64px; }#tf-state-5 .w-\[72px\]{ width: 72px; }#tf-state-5 .h-\[46px\]{ height: 46px; }#tf-state-5 .min-w-0{ min-width: 0; }#tf-state-5 .overflow-hidden{ overflow: hidden; }#tf-state-5 .overflow-x-auto{ overflow-x: auto; }#tf-state-5 .overflow-y-auto{ overflow-y: auto; }#tf-state-5 .overflow-x-hidden{ overflow-x: hidden; }#tf-state-5 .cursor-pointer{ cursor: pointer; }#tf-state-5 .pointer-events-none{ pointer-events: none; }#tf-state-5 .border-none{ border: none; }#tf-state-5 .border-0{ border: 0; }#tf-state-5 .border{ border: 1px solid var(--color-border-subtle); }#tf-state-5 .border-b{ border-bottom: 1px solid var(--color-border-subtle); }#tf-state-5 .border-black{ border-color: #000; }#tf-state-5 .bg-transparent{ background: transparent; }#tf-state-5 .bg-white{ background-color: #fff; }#tf-state-5 .bg-\[var\(--color-primary\)\]{ background-color: var(--color-primary); }#tf-state-5 .bg-\[var\(--color-bg-hover\)\]{ background-color: var(--color-bg-hover); }#tf-state-5 .bg-\[var\(--color-primary-active\)\]{ background-color: var(--color-primary-active); }#tf-state-5 .text-white{ color: #fff; }#tf-state-5 .rounded-\[var\(--radius-xxs\)\]{ border-radius: var(--radius-xxs); }#tf-state-5 .rounded-\[var\(--radius-md\)\]{ border-radius: var(--radius-md); }#tf-state-5 .rounded-\[var\(--radius-lg\)\]{ border-radius: var(--radius-lg); }#tf-state-5 .rounded-\[var\(--radius-xl\)\]{ border-radius: var(--radius-xl); }#tf-state-5 .rounded-\[var\(--radius-2xl\)\]{ border-radius: var(--radius-2xl); }#tf-state-5 .rounded-\[var\(--radius-full\)\]{ border-radius: var(--radius-full); }#tf-state-5 .truncate{ overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }#tf-state-5 .whitespace-nowrap{ white-space: nowrap; }#tf-state-5 .text-left{ text-align: left; }#tf-state-5 .text-center{ text-align: center; }#tf-state-5 .p-0{ padding: 0; }#tf-state-5 .px-3{ padding-left: 12px; padding-right: 12px; }#tf-state-5 .px-4{ padding-left: 16px; padding-right: 16px; }#tf-state-5 .py-2{ padding-top: 8px; padding-bottom: 8px; }#tf-state-5 .py-2\.5{ padding-top: 10px; padding-bottom: 10px; }#tf-state-5 .py-16{ padding-top: 64px; padding-bottom: 64px; }#tf-state-5 .pl-\[var\(--spacing-lg\)\]{ padding-left: var(--spacing-lg); }#tf-state-5 .mt-2{ margin-top: 8px; }#tf-state-5 .mb-3{ margin-bottom: 12px; }#tf-state-5 .-top-0\.5{ top: -2px; }#tf-state-5 .-right-0\.5{ right: -2px; }#tf-state-5 .left-1\/2{ left: 50%; }#tf-state-5 .top-1\/2{ top: 50%; }#tf-state-5 .-translate-y-1\/2{ transform: translateY(-50%); }#tf-state-5 .rotate-180{ transform: rotate(180deg); }#tf-state-5 .gap-0{ gap: 0; }#tf-state-5 .gap-2{ gap: 8px; }#tf-state-5 .gap-4{ gap: 16px; }#tf-state-5 .grid-cols-3{ grid-template-columns: repeat(3, minmax(0, 1fr)); }#tf-state-5 .space-y-2 > * + *{ margin-top: 8px; }#tf-state-5 .transition-all,#tf-state-5 .transition-colors,#tf-state-5 .transition-opacity,#tf-state-5 .transition-transform{
  transition-duration: 150ms;
  transition-timing-function: ease;
}#tf-state-5 .duration-150{ transition-duration: 150ms; }#tf-state-5 .duration-200{ transition-duration: 200ms; }#tf-state-5 .opacity-40{ opacity: 0.4; }#tf-state-5 .line-clamp-2{
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}



@keyframes slide-in-right {
  from { transform: translateX(100%); }
  to   { transform: translateX(0); }
}
@keyframes slide-out-right {
  from { transform: translateX(0); }
  to   { transform: translateX(100%); }
}
@keyframes fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes slide-up {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}
@keyframes page-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}#tf-state-5 .animate-slide-in-right{ animation: slide-in-right 300ms ease-out forwards; }#tf-state-5 .animate-slide-out-right{ animation: slide-out-right 300ms ease-in forwards; }#tf-state-5 .fade-in{ animation: fade-in 300ms ease-out forwards; }#tf-state-5 .animate-slide-up{ animation: slide-up 300ms ease-out forwards; }#tf-state-5 .animate-page-in{ animation: page-in 150ms ease-out; }#tf-state-5 .tf-cg-carousel-root{
  overflow: hidden;
  background: var(--color-bg-card);
}#tf-state-5 .tf-cg-carousel-track{
  display: flex;
  width: 100%;
  height: 100%;
}#tf-state-5 .tf-cg-carousel-slide{
  flex: 0 0 100%;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}#tf-state-5 .tf-cg-carousel-placeholder{
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.6;
}#tf-state-5 .tf-cg-carousel-indicator{
  position: absolute;
  bottom: 16px;
  right: 16px;
  background: rgba(0, 0, 0, 0.45);
  border-radius: var(--radius-full);
  padding: 4px 10px;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}#tf-state-5 .tf-cg-carousel-indicator-text{
  font-family: 'HarmonyOS Sans SC', sans-serif;
  font-size: var(--font-caption-12);
  line-height: var(--line-height-16);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-white);
  letter-spacing: 0.5px;
}
/* component-codegen placeholder: product_info_card */


@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Regular.ttf') format('truetype');
  font-weight: 400;
  font-display: swap;
}

@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Medium.ttf') format('truetype');
  font-weight: 500;
  font-display: swap;
}

@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Bold.ttf') format('truetype');
  font-weight: 600;
  font-display: swap;
}

@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Bold.ttf') format('truetype');
  font-weight: 700;
  font-display: swap;
}



@layer base {
  :root {
    
    --background: oklch(1 0 0);
    --foreground: var(--color-text-primary);
    --card: var(--color-bg-card);
    --card-foreground: var(--color-text-primary);
    --popover: var(--color-bg-card);
    --popover-foreground: var(--color-text-primary);
    --primary: var(--color-primary);
    --primary-foreground: var(--color-text-white);
    --secondary: var(--color-bg-hover);
    --secondary-foreground: var(--color-text-primary);
    --muted: var(--color-bg-disabled);
    --muted-foreground: var(--color-text-secondary);
    --accent: var(--color-primary-active);
    --accent-foreground: var(--color-primary);
    --destructive: var(--color-error);
    --destructive-foreground: var(--color-text-white);
    --border: var(--color-border-subtle);
    --input: var(--color-border-subtle);
    --ring: var(--color-primary);
    --radius: 0.625rem;
    --chart-1: oklch(0.87 0 0);
    --chart-2: oklch(0.556 0 0);
    --chart-3: oklch(0.439 0 0);
    --chart-4: oklch(0.371 0 0);
    --chart-5: oklch(0.269 0 0);
    --sidebar: oklch(0.985 0 0);
    --sidebar-foreground: var(--color-text-primary);
    --sidebar-primary: var(--color-primary);
    --sidebar-primary-foreground: var(--color-text-white);
    --sidebar-accent: var(--color-primary-active);
    --sidebar-accent-foreground: var(--color-primary);
    --sidebar-border: var(--color-border-subtle);
    --sidebar-ring: var(--color-primary);

    
    --color-text-primary:     rgba(0, 0, 0, 0.9);
    --color-text-secondary:   rgba(0, 0, 0, 0.6);
    --color-text-muted:       rgba(0, 0, 0, 0.4);
    --color-text-hint:        rgba(0, 0, 0, 0.4);
    --color-text-disabled:    rgba(0, 0, 0, 0.2);
    --color-text-white:       #ffffff;

    --color-primary: #C7000B;
    --color-primary-disabled: rgba(199, 0, 11, 0.4);
    --color-primary-soft: rgba(199, 0, 11, 0.05);
    --color-primary-active: rgba(199, 0, 11, 0.08);
    --color-orange: #FF8C42;

    --color-success: #10B981;
    --color-warning: #F97316;
    --color-error: #DC2626;

    --color-bg-page: #F2F3F5;
    --color-bg-card: #ffffff;
    --color-bg-hover: rgba(0, 0, 0, 0.04);
    --color-bg-disabled: rgba(0, 0, 0, 0.05);

    --color-border-subtle: rgba(0, 0, 0, 0.06);

    --color-divider-strong:  rgba(0, 0, 0, 0.6);
    --color-divider:         rgba(0, 0, 0, 0.1);
    --color-divider-subtle:  rgba(0, 0, 0, 0.05);
    --color-divider-faint:   rgba(0, 0, 0, 0.03);

    --color-mask: rgba(0, 0, 0, 0.3);

    --radius-xxs: 4px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 18px;
    --radius-2xl: 20px;
    --radius-3xl: 24px;
    --radius-4xl: 32px;
    --radius-full: 9999px;

    --shadow-sm: 0 1px 6px 0 rgba(0, 0, 0, 0.08);
    --shadow-md: 0 8px 24px 0 rgba(0, 0, 0, 0.08);
    --shadow-lg: 0 8px 24px 0 rgba(0, 0, 0, 0.16);
    --shadow-xl: 0 10px 20px 0 rgba(0, 0, 0, 0.15);

    --font-caption-10:  10px;
    --font-caption-12:  12px;
    --font-display-36: 36px;
    --font-display-48: 48px;
    --font-display-60: 60px;
    --font-headline-12: 12px;
    --font-headline-14: 14px;
    --font-headline-16: 16px;
    --font-headline-18: 18px;
    --font-headline-20: 20px;
    --font-headline-24: 24px;
    --font-body-12: 12px;
    --font-body-14: 14px;
    --font-body-16: 16px;

    --font-weight-regular:  400;
    --font-weight-medium:   500;
    --font-weight-semibold: 600;
    --font-weight-bold:     700;

    --line-height-12: 12px;
    --line-height-14: 14px;
    --line-height-16: 16px;
    --line-height-18: 18px;
    --line-height-20: 20px;
    --line-height-24: 24px;
    --line-height-26: 26px;
    --line-height-30: 30px;
    --line-height-32: 32px;
    --line-height-36: 36px;
    --line-height-48: 48px;
    --line-height-60: 60px;
    --line-height-64: 64px;
    --line-height-80: 80px;

    --spacing-xs: 4px;
    --spacing-sm: 6px;
    --spacing-md: 8px;
    --spacing-lg: 12px;
    --spacing-xl: 16px;
    --spacing-2xl: 24px;
  }

  .dark {
    --background: oklch(0.145 0 0);
    --foreground: oklch(0.985 0 0);
    --card: oklch(0.205 0 0);
    --card-foreground: oklch(0.985 0 0);
    --popover: oklch(0.205 0 0);
    --popover-foreground: oklch(0.985 0 0);
    --primary: var(--color-primary);
    --primary-foreground: var(--color-text-white);
    --secondary: oklch(0.269 0 0);
    --secondary-foreground: oklch(0.985 0 0);
    --muted: oklch(0.269 0 0);
    --muted-foreground: oklch(0.708 0 0);
    --accent: oklch(0.269 0 0);
    --accent-foreground: oklch(0.985 0 0);
    --destructive: var(--color-error);
    --destructive-foreground: var(--color-text-white);
    --border: oklch(1 0 0 / 10%);
    --input: oklch(1 0 0 / 15%);
    --ring: var(--color-primary);
    --chart-1: oklch(0.87 0 0);
    --chart-2: oklch(0.556 0 0);
    --chart-3: oklch(0.439 0 0);
    --chart-4: oklch(0.371 0 0);
    --chart-5: oklch(0.269 0 0);
    --sidebar: oklch(0.205 0 0);
    --sidebar-foreground: oklch(0.985 0 0);
    --sidebar-primary: oklch(0.488 0.243 264.376);
    --sidebar-primary-foreground: oklch(0.985 0 0);
    --sidebar-accent: oklch(0.269 0 0);
    --sidebar-accent-foreground: oklch(0.985 0 0);
    --sidebar-border: oklch(1 0 0 / 10%);
    --sidebar-ring: oklch(0.556 0 0);
  }

  * {
    @apply border-border;
    border-color: var(--color-border-subtle);
  }

  body {
    @apply bg-background text-foreground;
    font-family: 'HarmonyOS Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Noto Sans SC', sans-serif;
    background-color: var(--color-bg-page);
    color: var(--color-text-primary);
    -webkit-tap-highlight-color: transparent;
  }

  .theme {
    --font-heading: var(--font-sans);
    --font-sans: 'HarmonyOS Sans SC', sans-serif;
  }
  html {
    @apply font-sans;
  }
}



@layer components {
  
  .font-display-s { font-size: var(--font-display-36); line-height: var(--line-height-48); font-weight: var(--font-weight-medium); }
  .font-display-m { font-size: var(--font-display-48); line-height: var(--line-height-64); font-weight: var(--font-weight-medium); }
  .font-display-l { font-size: var(--font-display-60); line-height: var(--line-height-80); font-weight: var(--font-weight-medium); }

  
  .font-headline-xxs { font-size: var(--font-headline-12); line-height: var(--line-height-16); font-weight: var(--font-weight-medium); }
  .font-headline-xs  { font-size: var(--font-headline-14); line-height: var(--line-height-18); font-weight: var(--font-weight-medium); }
  .font-headline-s   { font-size: var(--font-headline-16); line-height: var(--line-height-20); font-weight: var(--font-weight-medium); }
  .font-headline-m   { font-size: var(--font-headline-18); line-height: var(--line-height-24); font-weight: var(--font-weight-medium); }
  .font-headline-l   { font-size: var(--font-headline-20); line-height: var(--line-height-26); font-weight: var(--font-weight-medium); }
  .font-headline-xl  { font-size: var(--font-headline-20); line-height: var(--line-height-26); font-weight: var(--font-weight-bold); }
  .font-headline-xxl { font-size: var(--font-headline-24); line-height: var(--line-height-32); font-weight: var(--font-weight-bold); }

  
  .font-headline-xs-multi { font-size: var(--font-headline-14); line-height: var(--line-height-20); font-weight: var(--font-weight-medium); }
  .font-headline-s-multi  { font-size: var(--font-headline-16); line-height: var(--line-height-24); font-weight: var(--font-weight-medium); }
  .font-headline-m-multi  { font-size: var(--font-headline-18); line-height: var(--line-height-26); font-weight: var(--font-weight-medium); }
  .font-headline-l-multi  { font-size: var(--font-headline-20); line-height: var(--line-height-30); font-weight: var(--font-weight-medium); }

  
  .font-body-s  { font-size: var(--font-body-12); line-height: var(--line-height-16); font-weight: var(--font-weight-regular); }
  .font-body-m  { font-size: var(--font-body-14); line-height: var(--line-height-18); font-weight: var(--font-weight-regular); }
  .font-body-l  { font-size: var(--font-body-16); line-height: var(--line-height-20); font-weight: var(--font-weight-regular); }

  
  .font-body-s-multi { font-size: var(--font-body-12); line-height: var(--line-height-18); font-weight: var(--font-weight-regular); }
  .font-body-m-multi { font-size: var(--font-body-14); line-height: var(--line-height-20); font-weight: var(--font-weight-regular); }
  .font-body-l-multi { font-size: var(--font-body-16); line-height: var(--line-height-24); font-weight: var(--font-weight-regular); }

  
  .font-caption-s { font-size: var(--font-caption-10); line-height: var(--line-height-12); font-weight: var(--font-weight-regular); }
  .font-caption-m { font-size: var(--font-caption-12); line-height: var(--line-height-16); font-weight: var(--font-weight-regular); }

  .font-caption-s-multi { font-size: var(--font-caption-10); line-height: var(--line-height-14); font-weight: var(--font-weight-regular); }
  .font-caption-m-multi { font-size: var(--font-caption-12); line-height: var(--line-height-18); font-weight: var(--font-weight-regular); }

  
  .p-page    { padding: var(--spacing-lg) var(--spacing-xl); }
  .p-card    { padding: var(--spacing-lg); }
  .p-card-sm { padding: var(--spacing-md); }
  .p-pill    { padding: var(--spacing-sm) var(--spacing-lg); }
  .p-tab     { padding: var(--spacing-xs) 0; }

  
  .size-icon-nav   { width: 40px; height: 40px; }
  .size-icon-entry { width: 48px; height: 48px; }
  .size-icon-card  { width: 40px; height: 40px; }
  .size-icon-sm    { width: 28px; height: 28px; }
  .size-badge      { width: 16px; height: 16px; font-size: 10px; }
  .size-icon-tab   { width: 30px; height: 30px; }
  .h-banner        { height: 140px; }

  
  .bg-gradient-layer-1 {
    width: 360px; height: 792px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.5) 0%, rgba(255,255,255,0) 100%),
      radial-gradient(circle 200px at 360px 140px, rgba(255,143,111,0.4) 0%, rgba(250,194,193,0) 100%),
      radial-gradient(circle 300px at 0px -100px, rgba(247,168,10,0.4) 0%, rgba(247,106,10,0) 100%),
      linear-gradient(180deg, #f6f6f5 0%, #f2f3f5 100%);
  }
  .bg-gradient-layer-2 {
    width: 360px; height: 792px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.4) 10%, rgba(255,255,255,0) 100%),
      radial-gradient(circle 231px at 320px 0px, rgba(255,143,111,0.2) 0%, rgba(250,194,193,0) 100%),
      radial-gradient(circle 271px at 85px -105px, rgba(247,168,10,0.2) 0%, rgba(247,106,10,0) 100%),
      linear-gradient(180deg, #f6f6f5 0%, #f2f3f5 100%);
  }
  .bg-gradient-layer-3 {
    width: 360px; height: 792px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.4) 10%, rgba(255,255,255,0) 100%),
      radial-gradient(circle 220px at 360px 0px, rgba(255,143,111,0.4) 0%, rgba(250,194,193,0) 100%),
      radial-gradient(circle 389px at 111px -284px, rgba(247,168,10,0.4) 0%, rgba(247,106,10,0) 100%),
      linear-gradient(180deg, #f6f6f5 0%, #f2f3f5 100%);
  }

  
  .tap-scale { transition: transform 150ms ease; }
  .tap-scale:active { transform: scale(0.98); }
  .tap-opacity:active { opacity: 0.8; }

  
  .flex-distribute { display: flex; align-items: center; justify-content: space-between; }
  .flex-center     { display: flex; align-items: center; }
  .flex-between    { display: flex; align-items: center; justify-content: space-between; }
  .scrollbar-hide { scrollbar-width: none; -ms-overflow-style: none; }
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .mobile-canvas,
  .mobile-canvas * { scrollbar-width: none; -ms-overflow-style: none; }
  .mobile-canvas::-webkit-scrollbar,
  .mobile-canvas *::-webkit-scrollbar { display: none; }

  
  .divider { border: none; border-top: 1px solid var(--color-divider); margin: 0; }
}#tf-state-5 .flex{ display: flex; }#tf-state-5 .inline-flex{ display: inline-flex; }#tf-state-5 .grid{ display: grid; }#tf-state-5 .block{ display: block; }#tf-state-5 .hidden{ display: none; }#tf-state-5 .flex-col{ flex-direction: column; }#tf-state-5 .flex-1{ flex: 1 1 0%; }#tf-state-5 .flex-shrink-0,#tf-state-5 .shrink-0{ flex-shrink: 0; }#tf-state-5 .items-start{ align-items: flex-start; }#tf-state-5 .items-center{ align-items: center; }#tf-state-5 .items-end{ align-items: flex-end; }#tf-state-5 .items-baseline{ align-items: baseline; }#tf-state-5 .justify-center{ justify-content: center; }#tf-state-5 .justify-between{ justify-content: space-between; }#tf-state-5 .relative{ position: relative; }#tf-state-5 .absolute{ position: absolute; }#tf-state-5 .fixed{ position: fixed; }#tf-state-5 .inset-0{ inset: 0; }#tf-state-5 .top-full{ top: 100%; }#tf-state-5 .left-0{ left: 0; }#tf-state-5 .right-0{ right: 0; }#tf-state-5 .top-0{ top: 0; }#tf-state-5 .bottom-0{ bottom: 0; }#tf-state-5 .z-10{ z-index: 10; }#tf-state-5 .z-40{ z-index: 40; }#tf-state-5 .z-50{ z-index: 50; }#tf-state-5 .w-full{ width: 100%; }#tf-state-5 .h-full{ height: 100%; }#tf-state-5 .w-5{ width: 20px; }#tf-state-5 .h-5{ height: 20px; }#tf-state-5 .w-8{ width: 32px; }#tf-state-5 .w-10{ width: 40px; }#tf-state-5 .h-10{ height: 40px; }#tf-state-5 .w-12{ width: 48px; }#tf-state-5 .h-12{ height: 48px; }#tf-state-5 .w-\[1px\]{ width: 1px; }#tf-state-5 .h-\[16px\]{ height: 16px; }#tf-state-5 .w-\[64px\]{ width: 64px; }#tf-state-5 .w-\[72px\]{ width: 72px; }#tf-state-5 .h-\[46px\]{ height: 46px; }#tf-state-5 .min-w-0{ min-width: 0; }#tf-state-5 .overflow-hidden{ overflow: hidden; }#tf-state-5 .overflow-x-auto{ overflow-x: auto; }#tf-state-5 .overflow-y-auto{ overflow-y: auto; }#tf-state-5 .overflow-x-hidden{ overflow-x: hidden; }#tf-state-5 .cursor-pointer{ cursor: pointer; }#tf-state-5 .pointer-events-none{ pointer-events: none; }#tf-state-5 .border-none{ border: none; }#tf-state-5 .border-0{ border: 0; }#tf-state-5 .border{ border: 1px solid var(--color-border-subtle); }#tf-state-5 .border-b{ border-bottom: 1px solid var(--color-border-subtle); }#tf-state-5 .border-black{ border-color: #000; }#tf-state-5 .bg-transparent{ background: transparent; }#tf-state-5 .bg-white{ background-color: #fff; }#tf-state-5 .bg-\[var\(--color-primary\)\]{ background-color: var(--color-primary); }#tf-state-5 .bg-\[var\(--color-bg-hover\)\]{ background-color: var(--color-bg-hover); }#tf-state-5 .bg-\[var\(--color-primary-active\)\]{ background-color: var(--color-primary-active); }#tf-state-5 .text-white{ color: #fff; }#tf-state-5 .rounded-\[var\(--radius-xxs\)\]{ border-radius: var(--radius-xxs); }#tf-state-5 .rounded-\[var\(--radius-md\)\]{ border-radius: var(--radius-md); }#tf-state-5 .rounded-\[var\(--radius-lg\)\]{ border-radius: var(--radius-lg); }#tf-state-5 .rounded-\[var\(--radius-xl\)\]{ border-radius: var(--radius-xl); }#tf-state-5 .rounded-\[var\(--radius-2xl\)\]{ border-radius: var(--radius-2xl); }#tf-state-5 .rounded-\[var\(--radius-full\)\]{ border-radius: var(--radius-full); }#tf-state-5 .truncate{ overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }#tf-state-5 .whitespace-nowrap{ white-space: nowrap; }#tf-state-5 .text-left{ text-align: left; }#tf-state-5 .text-center{ text-align: center; }#tf-state-5 .p-0{ padding: 0; }#tf-state-5 .px-3{ padding-left: 12px; padding-right: 12px; }#tf-state-5 .px-4{ padding-left: 16px; padding-right: 16px; }#tf-state-5 .py-2{ padding-top: 8px; padding-bottom: 8px; }#tf-state-5 .py-2\.5{ padding-top: 10px; padding-bottom: 10px; }#tf-state-5 .py-16{ padding-top: 64px; padding-bottom: 64px; }#tf-state-5 .pl-\[var\(--spacing-lg\)\]{ padding-left: var(--spacing-lg); }#tf-state-5 .mt-2{ margin-top: 8px; }#tf-state-5 .mb-3{ margin-bottom: 12px; }#tf-state-5 .-top-0\.5{ top: -2px; }#tf-state-5 .-right-0\.5{ right: -2px; }#tf-state-5 .left-1\/2{ left: 50%; }#tf-state-5 .top-1\/2{ top: 50%; }#tf-state-5 .-translate-y-1\/2{ transform: translateY(-50%); }#tf-state-5 .rotate-180{ transform: rotate(180deg); }#tf-state-5 .gap-0{ gap: 0; }#tf-state-5 .gap-2{ gap: 8px; }#tf-state-5 .gap-4{ gap: 16px; }#tf-state-5 .grid-cols-3{ grid-template-columns: repeat(3, minmax(0, 1fr)); }#tf-state-5 .space-y-2 > * + *{ margin-top: 8px; }#tf-state-5 .transition-all,#tf-state-5 .transition-colors,#tf-state-5 .transition-opacity,#tf-state-5 .transition-transform{
  transition-duration: 150ms;
  transition-timing-function: ease;
}#tf-state-5 .duration-150{ transition-duration: 150ms; }#tf-state-5 .duration-200{ transition-duration: 200ms; }#tf-state-5 .opacity-40{ opacity: 0.4; }#tf-state-5 .line-clamp-2{
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}



@keyframes slide-in-right {
  from { transform: translateX(100%); }
  to   { transform: translateX(0); }
}
@keyframes slide-out-right {
  from { transform: translateX(0); }
  to   { transform: translateX(100%); }
}
@keyframes fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes slide-up {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}
@keyframes page-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}#tf-state-5 .animate-slide-in-right{ animation: slide-in-right 300ms ease-out forwards; }#tf-state-5 .animate-slide-out-right{ animation: slide-out-right 300ms ease-in forwards; }#tf-state-5 .fade-in{ animation: fade-in 300ms ease-out forwards; }#tf-state-5 .animate-slide-up{ animation: slide-up 300ms ease-out forwards; }#tf-state-5 .animate-page-in{ animation: page-in 150ms ease-out; }#tf-state-5 [data-component-id="product_info_card"]{
  width: 100%;
}



@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Regular.ttf') format('truetype');
  font-weight: 400;
  font-display: swap;
}

@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Medium.ttf') format('truetype');
  font-weight: 500;
  font-display: swap;
}

@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Bold.ttf') format('truetype');
  font-weight: 600;
  font-display: swap;
}

@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Bold.ttf') format('truetype');
  font-weight: 700;
  font-display: swap;
}



@layer base {
  :root {
    
    --background: oklch(1 0 0);
    --foreground: var(--color-text-primary);
    --card: var(--color-bg-card);
    --card-foreground: var(--color-text-primary);
    --popover: var(--color-bg-card);
    --popover-foreground: var(--color-text-primary);
    --primary: var(--color-primary);
    --primary-foreground: var(--color-text-white);
    --secondary: var(--color-bg-hover);
    --secondary-foreground: var(--color-text-primary);
    --muted: var(--color-bg-disabled);
    --muted-foreground: var(--color-text-secondary);
    --accent: var(--color-primary-active);
    --accent-foreground: var(--color-primary);
    --destructive: var(--color-error);
    --destructive-foreground: var(--color-text-white);
    --border: var(--color-border-subtle);
    --input: var(--color-border-subtle);
    --ring: var(--color-primary);
    --radius: 0.625rem;
    --chart-1: oklch(0.87 0 0);
    --chart-2: oklch(0.556 0 0);
    --chart-3: oklch(0.439 0 0);
    --chart-4: oklch(0.371 0 0);
    --chart-5: oklch(0.269 0 0);
    --sidebar: oklch(0.985 0 0);
    --sidebar-foreground: var(--color-text-primary);
    --sidebar-primary: var(--color-primary);
    --sidebar-primary-foreground: var(--color-text-white);
    --sidebar-accent: var(--color-primary-active);
    --sidebar-accent-foreground: var(--color-primary);
    --sidebar-border: var(--color-border-subtle);
    --sidebar-ring: var(--color-primary);

    
    --color-text-primary:     rgba(0, 0, 0, 0.9);
    --color-text-secondary:   rgba(0, 0, 0, 0.6);
    --color-text-muted:       rgba(0, 0, 0, 0.4);
    --color-text-hint:        rgba(0, 0, 0, 0.4);
    --color-text-disabled:    rgba(0, 0, 0, 0.2);
    --color-text-white:       #ffffff;

    --color-primary: #C7000B;
    --color-primary-disabled: rgba(199, 0, 11, 0.4);
    --color-primary-soft: rgba(199, 0, 11, 0.05);
    --color-primary-active: rgba(199, 0, 11, 0.08);
    --color-orange: #FF8C42;

    --color-success: #10B981;
    --color-warning: #F97316;
    --color-error: #DC2626;

    --color-bg-page: #F2F3F5;
    --color-bg-card: #ffffff;
    --color-bg-hover: rgba(0, 0, 0, 0.04);
    --color-bg-disabled: rgba(0, 0, 0, 0.05);

    --color-border-subtle: rgba(0, 0, 0, 0.06);

    --color-divider-strong:  rgba(0, 0, 0, 0.6);
    --color-divider:         rgba(0, 0, 0, 0.1);
    --color-divider-subtle:  rgba(0, 0, 0, 0.05);
    --color-divider-faint:   rgba(0, 0, 0, 0.03);

    --color-mask: rgba(0, 0, 0, 0.3);

    --radius-xxs: 4px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 18px;
    --radius-2xl: 20px;
    --radius-3xl: 24px;
    --radius-4xl: 32px;
    --radius-full: 9999px;

    --shadow-sm: 0 1px 6px 0 rgba(0, 0, 0, 0.08);
    --shadow-md: 0 8px 24px 0 rgba(0, 0, 0, 0.08);
    --shadow-lg: 0 8px 24px 0 rgba(0, 0, 0, 0.16);
    --shadow-xl: 0 10px 20px 0 rgba(0, 0, 0, 0.15);

    --font-caption-10:  10px;
    --font-caption-12:  12px;
    --font-display-36: 36px;
    --font-display-48: 48px;
    --font-display-60: 60px;
    --font-headline-12: 12px;
    --font-headline-14: 14px;
    --font-headline-16: 16px;
    --font-headline-18: 18px;
    --font-headline-20: 20px;
    --font-headline-24: 24px;
    --font-body-12: 12px;
    --font-body-14: 14px;
    --font-body-16: 16px;

    --font-weight-regular:  400;
    --font-weight-medium:   500;
    --font-weight-semibold: 600;
    --font-weight-bold:     700;

    --line-height-12: 12px;
    --line-height-14: 14px;
    --line-height-16: 16px;
    --line-height-18: 18px;
    --line-height-20: 20px;
    --line-height-24: 24px;
    --line-height-26: 26px;
    --line-height-30: 30px;
    --line-height-32: 32px;
    --line-height-36: 36px;
    --line-height-48: 48px;
    --line-height-60: 60px;
    --line-height-64: 64px;
    --line-height-80: 80px;

    --spacing-xs: 4px;
    --spacing-sm: 6px;
    --spacing-md: 8px;
    --spacing-lg: 12px;
    --spacing-xl: 16px;
    --spacing-2xl: 24px;
  }

  .dark {
    --background: oklch(0.145 0 0);
    --foreground: oklch(0.985 0 0);
    --card: oklch(0.205 0 0);
    --card-foreground: oklch(0.985 0 0);
    --popover: oklch(0.205 0 0);
    --popover-foreground: oklch(0.985 0 0);
    --primary: var(--color-primary);
    --primary-foreground: var(--color-text-white);
    --secondary: oklch(0.269 0 0);
    --secondary-foreground: oklch(0.985 0 0);
    --muted: oklch(0.269 0 0);
    --muted-foreground: oklch(0.708 0 0);
    --accent: oklch(0.269 0 0);
    --accent-foreground: oklch(0.985 0 0);
    --destructive: var(--color-error);
    --destructive-foreground: var(--color-text-white);
    --border: oklch(1 0 0 / 10%);
    --input: oklch(1 0 0 / 15%);
    --ring: var(--color-primary);
    --chart-1: oklch(0.87 0 0);
    --chart-2: oklch(0.556 0 0);
    --chart-3: oklch(0.439 0 0);
    --chart-4: oklch(0.371 0 0);
    --chart-5: oklch(0.269 0 0);
    --sidebar: oklch(0.205 0 0);
    --sidebar-foreground: oklch(0.985 0 0);
    --sidebar-primary: oklch(0.488 0.243 264.376);
    --sidebar-primary-foreground: oklch(0.985 0 0);
    --sidebar-accent: oklch(0.269 0 0);
    --sidebar-accent-foreground: oklch(0.985 0 0);
    --sidebar-border: oklch(1 0 0 / 10%);
    --sidebar-ring: oklch(0.556 0 0);
  }

  * {
    @apply border-border;
    border-color: var(--color-border-subtle);
  }

  body {
    @apply bg-background text-foreground;
    font-family: 'HarmonyOS Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Noto Sans SC', sans-serif;
    background-color: var(--color-bg-page);
    color: var(--color-text-primary);
    -webkit-tap-highlight-color: transparent;
  }

  .theme {
    --font-heading: var(--font-sans);
    --font-sans: 'HarmonyOS Sans SC', sans-serif;
  }
  html {
    @apply font-sans;
  }
}



@layer components {
  
  .font-display-s { font-size: var(--font-display-36); line-height: var(--line-height-48); font-weight: var(--font-weight-medium); }
  .font-display-m { font-size: var(--font-display-48); line-height: var(--line-height-64); font-weight: var(--font-weight-medium); }
  .font-display-l { font-size: var(--font-display-60); line-height: var(--line-height-80); font-weight: var(--font-weight-medium); }

  
  .font-headline-xxs { font-size: var(--font-headline-12); line-height: var(--line-height-16); font-weight: var(--font-weight-medium); }
  .font-headline-xs  { font-size: var(--font-headline-14); line-height: var(--line-height-18); font-weight: var(--font-weight-medium); }
  .font-headline-s   { font-size: var(--font-headline-16); line-height: var(--line-height-20); font-weight: var(--font-weight-medium); }
  .font-headline-m   { font-size: var(--font-headline-18); line-height: var(--line-height-24); font-weight: var(--font-weight-medium); }
  .font-headline-l   { font-size: var(--font-headline-20); line-height: var(--line-height-26); font-weight: var(--font-weight-medium); }
  .font-headline-xl  { font-size: var(--font-headline-20); line-height: var(--line-height-26); font-weight: var(--font-weight-bold); }
  .font-headline-xxl { font-size: var(--font-headline-24); line-height: var(--line-height-32); font-weight: var(--font-weight-bold); }

  
  .font-headline-xs-multi { font-size: var(--font-headline-14); line-height: var(--line-height-20); font-weight: var(--font-weight-medium); }
  .font-headline-s-multi  { font-size: var(--font-headline-16); line-height: var(--line-height-24); font-weight: var(--font-weight-medium); }
  .font-headline-m-multi  { font-size: var(--font-headline-18); line-height: var(--line-height-26); font-weight: var(--font-weight-medium); }
  .font-headline-l-multi  { font-size: var(--font-headline-20); line-height: var(--line-height-30); font-weight: var(--font-weight-medium); }

  
  .font-body-s  { font-size: var(--font-body-12); line-height: var(--line-height-16); font-weight: var(--font-weight-regular); }
  .font-body-m  { font-size: var(--font-body-14); line-height: var(--line-height-18); font-weight: var(--font-weight-regular); }
  .font-body-l  { font-size: var(--font-body-16); line-height: var(--line-height-20); font-weight: var(--font-weight-regular); }

  
  .font-body-s-multi { font-size: var(--font-body-12); line-height: var(--line-height-18); font-weight: var(--font-weight-regular); }
  .font-body-m-multi { font-size: var(--font-body-14); line-height: var(--line-height-20); font-weight: var(--font-weight-regular); }
  .font-body-l-multi { font-size: var(--font-body-16); line-height: var(--line-height-24); font-weight: var(--font-weight-regular); }

  
  .font-caption-s { font-size: var(--font-caption-10); line-height: var(--line-height-12); font-weight: var(--font-weight-regular); }
  .font-caption-m { font-size: var(--font-caption-12); line-height: var(--line-height-16); font-weight: var(--font-weight-regular); }

  .font-caption-s-multi { font-size: var(--font-caption-10); line-height: var(--line-height-14); font-weight: var(--font-weight-regular); }
  .font-caption-m-multi { font-size: var(--font-caption-12); line-height: var(--line-height-18); font-weight: var(--font-weight-regular); }

  
  .p-page    { padding: var(--spacing-lg) var(--spacing-xl); }
  .p-card    { padding: var(--spacing-lg); }
  .p-card-sm { padding: var(--spacing-md); }
  .p-pill    { padding: var(--spacing-sm) var(--spacing-lg); }
  .p-tab     { padding: var(--spacing-xs) 0; }

  
  .size-icon-nav   { width: 40px; height: 40px; }
  .size-icon-entry { width: 48px; height: 48px; }
  .size-icon-card  { width: 40px; height: 40px; }
  .size-icon-sm    { width: 28px; height: 28px; }
  .size-badge      { width: 16px; height: 16px; font-size: 10px; }
  .size-icon-tab   { width: 30px; height: 30px; }
  .h-banner        { height: 140px; }

  
  .bg-gradient-layer-1 {
    width: 360px; height: 792px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.5) 0%, rgba(255,255,255,0) 100%),
      radial-gradient(circle 200px at 360px 140px, rgba(255,143,111,0.4) 0%, rgba(250,194,193,0) 100%),
      radial-gradient(circle 300px at 0px -100px, rgba(247,168,10,0.4) 0%, rgba(247,106,10,0) 100%),
      linear-gradient(180deg, #f6f6f5 0%, #f2f3f5 100%);
  }
  .bg-gradient-layer-2 {
    width: 360px; height: 792px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.4) 10%, rgba(255,255,255,0) 100%),
      radial-gradient(circle 231px at 320px 0px, rgba(255,143,111,0.2) 0%, rgba(250,194,193,0) 100%),
      radial-gradient(circle 271px at 85px -105px, rgba(247,168,10,0.2) 0%, rgba(247,106,10,0) 100%),
      linear-gradient(180deg, #f6f6f5 0%, #f2f3f5 100%);
  }
  .bg-gradient-layer-3 {
    width: 360px; height: 792px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.4) 10%, rgba(255,255,255,0) 100%),
      radial-gradient(circle 220px at 360px 0px, rgba(255,143,111,0.4) 0%, rgba(250,194,193,0) 100%),
      radial-gradient(circle 389px at 111px -284px, rgba(247,168,10,0.4) 0%, rgba(247,106,10,0) 100%),
      linear-gradient(180deg, #f6f6f5 0%, #f2f3f5 100%);
  }

  
  .tap-scale { transition: transform 150ms ease; }
  .tap-scale:active { transform: scale(0.98); }
  .tap-opacity:active { opacity: 0.8; }

  
  .flex-distribute { display: flex; align-items: center; justify-content: space-between; }
  .flex-center     { display: flex; align-items: center; }
  .flex-between    { display: flex; align-items: center; justify-content: space-between; }
  .scrollbar-hide { scrollbar-width: none; -ms-overflow-style: none; }
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .mobile-canvas,
  .mobile-canvas * { scrollbar-width: none; -ms-overflow-style: none; }
  .mobile-canvas::-webkit-scrollbar,
  .mobile-canvas *::-webkit-scrollbar { display: none; }

  
  .divider { border: none; border-top: 1px solid var(--color-divider); margin: 0; }
}#tf-state-5 .flex{ display: flex; }#tf-state-5 .inline-flex{ display: inline-flex; }#tf-state-5 .grid{ display: grid; }#tf-state-5 .block{ display: block; }#tf-state-5 .hidden{ display: none; }#tf-state-5 .flex-col{ flex-direction: column; }#tf-state-5 .flex-1{ flex: 1 1 0%; }#tf-state-5 .flex-shrink-0,#tf-state-5 .shrink-0{ flex-shrink: 0; }#tf-state-5 .items-start{ align-items: flex-start; }#tf-state-5 .items-center{ align-items: center; }#tf-state-5 .items-end{ align-items: flex-end; }#tf-state-5 .items-baseline{ align-items: baseline; }#tf-state-5 .justify-center{ justify-content: center; }#tf-state-5 .justify-between{ justify-content: space-between; }#tf-state-5 .relative{ position: relative; }#tf-state-5 .absolute{ position: absolute; }#tf-state-5 .fixed{ position: fixed; }#tf-state-5 .inset-0{ inset: 0; }#tf-state-5 .top-full{ top: 100%; }#tf-state-5 .left-0{ left: 0; }#tf-state-5 .right-0{ right: 0; }#tf-state-5 .top-0{ top: 0; }#tf-state-5 .bottom-0{ bottom: 0; }#tf-state-5 .z-10{ z-index: 10; }#tf-state-5 .z-40{ z-index: 40; }#tf-state-5 .z-50{ z-index: 50; }#tf-state-5 .w-full{ width: 100%; }#tf-state-5 .h-full{ height: 100%; }#tf-state-5 .w-5{ width: 20px; }#tf-state-5 .h-5{ height: 20px; }#tf-state-5 .w-8{ width: 32px; }#tf-state-5 .w-10{ width: 40px; }#tf-state-5 .h-10{ height: 40px; }#tf-state-5 .w-12{ width: 48px; }#tf-state-5 .h-12{ height: 48px; }#tf-state-5 .w-\[1px\]{ width: 1px; }#tf-state-5 .h-\[16px\]{ height: 16px; }#tf-state-5 .w-\[64px\]{ width: 64px; }#tf-state-5 .w-\[72px\]{ width: 72px; }#tf-state-5 .h-\[46px\]{ height: 46px; }#tf-state-5 .min-w-0{ min-width: 0; }#tf-state-5 .overflow-hidden{ overflow: hidden; }#tf-state-5 .overflow-x-auto{ overflow-x: auto; }#tf-state-5 .overflow-y-auto{ overflow-y: auto; }#tf-state-5 .overflow-x-hidden{ overflow-x: hidden; }#tf-state-5 .cursor-pointer{ cursor: pointer; }#tf-state-5 .pointer-events-none{ pointer-events: none; }#tf-state-5 .border-none{ border: none; }#tf-state-5 .border-0{ border: 0; }#tf-state-5 .border{ border: 1px solid var(--color-border-subtle); }#tf-state-5 .border-b{ border-bottom: 1px solid var(--color-border-subtle); }#tf-state-5 .border-black{ border-color: #000; }#tf-state-5 .bg-transparent{ background: transparent; }#tf-state-5 .bg-white{ background-color: #fff; }#tf-state-5 .bg-\[var\(--color-primary\)\]{ background-color: var(--color-primary); }#tf-state-5 .bg-\[var\(--color-bg-hover\)\]{ background-color: var(--color-bg-hover); }#tf-state-5 .bg-\[var\(--color-primary-active\)\]{ background-color: var(--color-primary-active); }#tf-state-5 .text-white{ color: #fff; }#tf-state-5 .rounded-\[var\(--radius-xxs\)\]{ border-radius: var(--radius-xxs); }#tf-state-5 .rounded-\[var\(--radius-md\)\]{ border-radius: var(--radius-md); }#tf-state-5 .rounded-\[var\(--radius-lg\)\]{ border-radius: var(--radius-lg); }#tf-state-5 .rounded-\[var\(--radius-xl\)\]{ border-radius: var(--radius-xl); }#tf-state-5 .rounded-\[var\(--radius-2xl\)\]{ border-radius: var(--radius-2xl); }#tf-state-5 .rounded-\[var\(--radius-full\)\]{ border-radius: var(--radius-full); }#tf-state-5 .truncate{ overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }#tf-state-5 .whitespace-nowrap{ white-space: nowrap; }#tf-state-5 .text-left{ text-align: left; }#tf-state-5 .text-center{ text-align: center; }#tf-state-5 .p-0{ padding: 0; }#tf-state-5 .px-3{ padding-left: 12px; padding-right: 12px; }#tf-state-5 .px-4{ padding-left: 16px; padding-right: 16px; }#tf-state-5 .py-2{ padding-top: 8px; padding-bottom: 8px; }#tf-state-5 .py-2\.5{ padding-top: 10px; padding-bottom: 10px; }#tf-state-5 .py-16{ padding-top: 64px; padding-bottom: 64px; }#tf-state-5 .pl-\[var\(--spacing-lg\)\]{ padding-left: var(--spacing-lg); }#tf-state-5 .mt-2{ margin-top: 8px; }#tf-state-5 .mb-3{ margin-bottom: 12px; }#tf-state-5 .-top-0\.5{ top: -2px; }#tf-state-5 .-right-0\.5{ right: -2px; }#tf-state-5 .left-1\/2{ left: 50%; }#tf-state-5 .top-1\/2{ top: 50%; }#tf-state-5 .-translate-y-1\/2{ transform: translateY(-50%); }#tf-state-5 .rotate-180{ transform: rotate(180deg); }#tf-state-5 .gap-0{ gap: 0; }#tf-state-5 .gap-2{ gap: 8px; }#tf-state-5 .gap-4{ gap: 16px; }#tf-state-5 .grid-cols-3{ grid-template-columns: repeat(3, minmax(0, 1fr)); }#tf-state-5 .space-y-2 > * + *{ margin-top: 8px; }#tf-state-5 .transition-all,#tf-state-5 .transition-colors,#tf-state-5 .transition-opacity,#tf-state-5 .transition-transform{
  transition-duration: 150ms;
  transition-timing-function: ease;
}#tf-state-5 .duration-150{ transition-duration: 150ms; }#tf-state-5 .duration-200{ transition-duration: 200ms; }#tf-state-5 .opacity-40{ opacity: 0.4; }#tf-state-5 .line-clamp-2{
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}



@keyframes slide-in-right {
  from { transform: translateX(100%); }
  to   { transform: translateX(0); }
}
@keyframes slide-out-right {
  from { transform: translateX(0); }
  to   { transform: translateX(100%); }
}
@keyframes fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes slide-up {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}
@keyframes page-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}#tf-state-5 .animate-slide-in-right{ animation: slide-in-right 300ms ease-out forwards; }#tf-state-5 .animate-slide-out-right{ animation: slide-out-right 300ms ease-in forwards; }#tf-state-5 .fade-in{ animation: fade-in 300ms ease-out forwards; }#tf-state-5 .animate-slide-up{ animation: slide-up 300ms ease-out forwards; }#tf-state-5 .animate-page-in{ animation: page-in 150ms ease-out; }#tf-state-5 [data-component-id="product_title"]{
  display: block;
}




@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Regular.ttf') format('truetype');
  font-weight: 400;
  font-display: swap;
}

@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Medium.ttf') format('truetype');
  font-weight: 500;
  font-display: swap;
}

@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Bold.ttf') format('truetype');
  font-weight: 600;
  font-display: swap;
}

@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Bold.ttf') format('truetype');
  font-weight: 700;
  font-display: swap;
}



@layer base {
  :root {
    
    --background: oklch(1 0 0);
    --foreground: var(--color-text-primary);
    --card: var(--color-bg-card);
    --card-foreground: var(--color-text-primary);
    --popover: var(--color-bg-card);
    --popover-foreground: var(--color-text-primary);
    --primary: var(--color-primary);
    --primary-foreground: var(--color-text-white);
    --secondary: var(--color-bg-hover);
    --secondary-foreground: var(--color-text-primary);
    --muted: var(--color-bg-disabled);
    --muted-foreground: var(--color-text-secondary);
    --accent: var(--color-primary-active);
    --accent-foreground: var(--color-primary);
    --destructive: var(--color-error);
    --destructive-foreground: var(--color-text-white);
    --border: var(--color-border-subtle);
    --input: var(--color-border-subtle);
    --ring: var(--color-primary);
    --radius: 0.625rem;
    --chart-1: oklch(0.87 0 0);
    --chart-2: oklch(0.556 0 0);
    --chart-3: oklch(0.439 0 0);
    --chart-4: oklch(0.371 0 0);
    --chart-5: oklch(0.269 0 0);
    --sidebar: oklch(0.985 0 0);
    --sidebar-foreground: var(--color-text-primary);
    --sidebar-primary: var(--color-primary);
    --sidebar-primary-foreground: var(--color-text-white);
    --sidebar-accent: var(--color-primary-active);
    --sidebar-accent-foreground: var(--color-primary);
    --sidebar-border: var(--color-border-subtle);
    --sidebar-ring: var(--color-primary);

    
    --color-text-primary:     rgba(0, 0, 0, 0.9);
    --color-text-secondary:   rgba(0, 0, 0, 0.6);
    --color-text-muted:       rgba(0, 0, 0, 0.4);
    --color-text-hint:        rgba(0, 0, 0, 0.4);
    --color-text-disabled:    rgba(0, 0, 0, 0.2);
    --color-text-white:       #ffffff;

    --color-primary: #C7000B;
    --color-primary-disabled: rgba(199, 0, 11, 0.4);
    --color-primary-soft: rgba(199, 0, 11, 0.05);
    --color-primary-active: rgba(199, 0, 11, 0.08);
    --color-orange: #FF8C42;

    --color-success: #10B981;
    --color-warning: #F97316;
    --color-error: #DC2626;

    --color-bg-page: #F2F3F5;
    --color-bg-card: #ffffff;
    --color-bg-hover: rgba(0, 0, 0, 0.04);
    --color-bg-disabled: rgba(0, 0, 0, 0.05);

    --color-border-subtle: rgba(0, 0, 0, 0.06);

    --color-divider-strong:  rgba(0, 0, 0, 0.6);
    --color-divider:         rgba(0, 0, 0, 0.1);
    --color-divider-subtle:  rgba(0, 0, 0, 0.05);
    --color-divider-faint:   rgba(0, 0, 0, 0.03);

    --color-mask: rgba(0, 0, 0, 0.3);

    --radius-xxs: 4px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 18px;
    --radius-2xl: 20px;
    --radius-3xl: 24px;
    --radius-4xl: 32px;
    --radius-full: 9999px;

    --shadow-sm: 0 1px 6px 0 rgba(0, 0, 0, 0.08);
    --shadow-md: 0 8px 24px 0 rgba(0, 0, 0, 0.08);
    --shadow-lg: 0 8px 24px 0 rgba(0, 0, 0, 0.16);
    --shadow-xl: 0 10px 20px 0 rgba(0, 0, 0, 0.15);

    --font-caption-10:  10px;
    --font-caption-12:  12px;
    --font-display-36: 36px;
    --font-display-48: 48px;
    --font-display-60: 60px;
    --font-headline-12: 12px;
    --font-headline-14: 14px;
    --font-headline-16: 16px;
    --font-headline-18: 18px;
    --font-headline-20: 20px;
    --font-headline-24: 24px;
    --font-body-12: 12px;
    --font-body-14: 14px;
    --font-body-16: 16px;

    --font-weight-regular:  400;
    --font-weight-medium:   500;
    --font-weight-semibold: 600;
    --font-weight-bold:     700;

    --line-height-12: 12px;
    --line-height-14: 14px;
    --line-height-16: 16px;
    --line-height-18: 18px;
    --line-height-20: 20px;
    --line-height-24: 24px;
    --line-height-26: 26px;
    --line-height-30: 30px;
    --line-height-32: 32px;
    --line-height-36: 36px;
    --line-height-48: 48px;
    --line-height-60: 60px;
    --line-height-64: 64px;
    --line-height-80: 80px;

    --spacing-xs: 4px;
    --spacing-sm: 6px;
    --spacing-md: 8px;
    --spacing-lg: 12px;
    --spacing-xl: 16px;
    --spacing-2xl: 24px;
  }

  .dark {
    --background: oklch(0.145 0 0);
    --foreground: oklch(0.985 0 0);
    --card: oklch(0.205 0 0);
    --card-foreground: oklch(0.985 0 0);
    --popover: oklch(0.205 0 0);
    --popover-foreground: oklch(0.985 0 0);
    --primary: var(--color-primary);
    --primary-foreground: var(--color-text-white);
    --secondary: oklch(0.269 0 0);
    --secondary-foreground: oklch(0.985 0 0);
    --muted: oklch(0.269 0 0);
    --muted-foreground: oklch(0.708 0 0);
    --accent: oklch(0.269 0 0);
    --accent-foreground: oklch(0.985 0 0);
    --destructive: var(--color-error);
    --destructive-foreground: var(--color-text-white);
    --border: oklch(1 0 0 / 10%);
    --input: oklch(1 0 0 / 15%);
    --ring: var(--color-primary);
    --chart-1: oklch(0.87 0 0);
    --chart-2: oklch(0.556 0 0);
    --chart-3: oklch(0.439 0 0);
    --chart-4: oklch(0.371 0 0);
    --chart-5: oklch(0.269 0 0);
    --sidebar: oklch(0.205 0 0);
    --sidebar-foreground: oklch(0.985 0 0);
    --sidebar-primary: oklch(0.488 0.243 264.376);
    --sidebar-primary-foreground: oklch(0.985 0 0);
    --sidebar-accent: oklch(0.269 0 0);
    --sidebar-accent-foreground: oklch(0.985 0 0);
    --sidebar-border: oklch(1 0 0 / 10%);
    --sidebar-ring: oklch(0.556 0 0);
  }

  * {
    @apply border-border;
    border-color: var(--color-border-subtle);
  }

  body {
    @apply bg-background text-foreground;
    font-family: 'HarmonyOS Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Noto Sans SC', sans-serif;
    background-color: var(--color-bg-page);
    color: var(--color-text-primary);
    -webkit-tap-highlight-color: transparent;
  }

  .theme {
    --font-heading: var(--font-sans);
    --font-sans: 'HarmonyOS Sans SC', sans-serif;
  }
  html {
    @apply font-sans;
  }
}



@layer components {
  
  .font-display-s { font-size: var(--font-display-36); line-height: var(--line-height-48); font-weight: var(--font-weight-medium); }
  .font-display-m { font-size: var(--font-display-48); line-height: var(--line-height-64); font-weight: var(--font-weight-medium); }
  .font-display-l { font-size: var(--font-display-60); line-height: var(--line-height-80); font-weight: var(--font-weight-medium); }

  
  .font-headline-xxs { font-size: var(--font-headline-12); line-height: var(--line-height-16); font-weight: var(--font-weight-medium); }
  .font-headline-xs  { font-size: var(--font-headline-14); line-height: var(--line-height-18); font-weight: var(--font-weight-medium); }
  .font-headline-s   { font-size: var(--font-headline-16); line-height: var(--line-height-20); font-weight: var(--font-weight-medium); }
  .font-headline-m   { font-size: var(--font-headline-18); line-height: var(--line-height-24); font-weight: var(--font-weight-medium); }
  .font-headline-l   { font-size: var(--font-headline-20); line-height: var(--line-height-26); font-weight: var(--font-weight-medium); }
  .font-headline-xl  { font-size: var(--font-headline-20); line-height: var(--line-height-26); font-weight: var(--font-weight-bold); }
  .font-headline-xxl { font-size: var(--font-headline-24); line-height: var(--line-height-32); font-weight: var(--font-weight-bold); }

  
  .font-headline-xs-multi { font-size: var(--font-headline-14); line-height: var(--line-height-20); font-weight: var(--font-weight-medium); }
  .font-headline-s-multi  { font-size: var(--font-headline-16); line-height: var(--line-height-24); font-weight: var(--font-weight-medium); }
  .font-headline-m-multi  { font-size: var(--font-headline-18); line-height: var(--line-height-26); font-weight: var(--font-weight-medium); }
  .font-headline-l-multi  { font-size: var(--font-headline-20); line-height: var(--line-height-30); font-weight: var(--font-weight-medium); }

  
  .font-body-s  { font-size: var(--font-body-12); line-height: var(--line-height-16); font-weight: var(--font-weight-regular); }
  .font-body-m  { font-size: var(--font-body-14); line-height: var(--line-height-18); font-weight: var(--font-weight-regular); }
  .font-body-l  { font-size: var(--font-body-16); line-height: var(--line-height-20); font-weight: var(--font-weight-regular); }

  
  .font-body-s-multi { font-size: var(--font-body-12); line-height: var(--line-height-18); font-weight: var(--font-weight-regular); }
  .font-body-m-multi { font-size: var(--font-body-14); line-height: var(--line-height-20); font-weight: var(--font-weight-regular); }
  .font-body-l-multi { font-size: var(--font-body-16); line-height: var(--line-height-24); font-weight: var(--font-weight-regular); }

  
  .font-caption-s { font-size: var(--font-caption-10); line-height: var(--line-height-12); font-weight: var(--font-weight-regular); }
  .font-caption-m { font-size: var(--font-caption-12); line-height: var(--line-height-16); font-weight: var(--font-weight-regular); }

  .font-caption-s-multi { font-size: var(--font-caption-10); line-height: var(--line-height-14); font-weight: var(--font-weight-regular); }
  .font-caption-m-multi { font-size: var(--font-caption-12); line-height: var(--line-height-18); font-weight: var(--font-weight-regular); }

  
  .p-page    { padding: var(--spacing-lg) var(--spacing-xl); }
  .p-card    { padding: var(--spacing-lg); }
  .p-card-sm { padding: var(--spacing-md); }
  .p-pill    { padding: var(--spacing-sm) var(--spacing-lg); }
  .p-tab     { padding: var(--spacing-xs) 0; }

  
  .size-icon-nav   { width: 40px; height: 40px; }
  .size-icon-entry { width: 48px; height: 48px; }
  .size-icon-card  { width: 40px; height: 40px; }
  .size-icon-sm    { width: 28px; height: 28px; }
  .size-badge      { width: 16px; height: 16px; font-size: 10px; }
  .size-icon-tab   { width: 30px; height: 30px; }
  .h-banner        { height: 140px; }

  
  .bg-gradient-layer-1 {
    width: 360px; height: 792px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.5) 0%, rgba(255,255,255,0) 100%),
      radial-gradient(circle 200px at 360px 140px, rgba(255,143,111,0.4) 0%, rgba(250,194,193,0) 100%),
      radial-gradient(circle 300px at 0px -100px, rgba(247,168,10,0.4) 0%, rgba(247,106,10,0) 100%),
      linear-gradient(180deg, #f6f6f5 0%, #f2f3f5 100%);
  }
  .bg-gradient-layer-2 {
    width: 360px; height: 792px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.4) 10%, rgba(255,255,255,0) 100%),
      radial-gradient(circle 231px at 320px 0px, rgba(255,143,111,0.2) 0%, rgba(250,194,193,0) 100%),
      radial-gradient(circle 271px at 85px -105px, rgba(247,168,10,0.2) 0%, rgba(247,106,10,0) 100%),
      linear-gradient(180deg, #f6f6f5 0%, #f2f3f5 100%);
  }
  .bg-gradient-layer-3 {
    width: 360px; height: 792px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.4) 10%, rgba(255,255,255,0) 100%),
      radial-gradient(circle 220px at 360px 0px, rgba(255,143,111,0.4) 0%, rgba(250,194,193,0) 100%),
      radial-gradient(circle 389px at 111px -284px, rgba(247,168,10,0.4) 0%, rgba(247,106,10,0) 100%),
      linear-gradient(180deg, #f6f6f5 0%, #f2f3f5 100%);
  }

  
  .tap-scale { transition: transform 150ms ease; }
  .tap-scale:active { transform: scale(0.98); }
  .tap-opacity:active { opacity: 0.8; }

  
  .flex-distribute { display: flex; align-items: center; justify-content: space-between; }
  .flex-center     { display: flex; align-items: center; }
  .flex-between    { display: flex; align-items: center; justify-content: space-between; }
  .scrollbar-hide { scrollbar-width: none; -ms-overflow-style: none; }
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .mobile-canvas,
  .mobile-canvas * { scrollbar-width: none; -ms-overflow-style: none; }
  .mobile-canvas::-webkit-scrollbar,
  .mobile-canvas *::-webkit-scrollbar { display: none; }

  
  .divider { border: none; border-top: 1px solid var(--color-divider); margin: 0; }
}#tf-state-5 .flex{ display: flex; }#tf-state-5 .inline-flex{ display: inline-flex; }#tf-state-5 .grid{ display: grid; }#tf-state-5 .block{ display: block; }#tf-state-5 .hidden{ display: none; }#tf-state-5 .flex-col{ flex-direction: column; }#tf-state-5 .flex-1{ flex: 1 1 0%; }#tf-state-5 .flex-shrink-0,#tf-state-5 .shrink-0{ flex-shrink: 0; }#tf-state-5 .items-start{ align-items: flex-start; }#tf-state-5 .items-center{ align-items: center; }#tf-state-5 .items-end{ align-items: flex-end; }#tf-state-5 .items-baseline{ align-items: baseline; }#tf-state-5 .justify-center{ justify-content: center; }#tf-state-5 .justify-between{ justify-content: space-between; }#tf-state-5 .relative{ position: relative; }#tf-state-5 .absolute{ position: absolute; }#tf-state-5 .fixed{ position: fixed; }#tf-state-5 .inset-0{ inset: 0; }#tf-state-5 .top-full{ top: 100%; }#tf-state-5 .left-0{ left: 0; }#tf-state-5 .right-0{ right: 0; }#tf-state-5 .top-0{ top: 0; }#tf-state-5 .bottom-0{ bottom: 0; }#tf-state-5 .z-10{ z-index: 10; }#tf-state-5 .z-40{ z-index: 40; }#tf-state-5 .z-50{ z-index: 50; }#tf-state-5 .w-full{ width: 100%; }#tf-state-5 .h-full{ height: 100%; }#tf-state-5 .w-5{ width: 20px; }#tf-state-5 .h-5{ height: 20px; }#tf-state-5 .w-8{ width: 32px; }#tf-state-5 .w-10{ width: 40px; }#tf-state-5 .h-10{ height: 40px; }#tf-state-5 .w-12{ width: 48px; }#tf-state-5 .h-12{ height: 48px; }#tf-state-5 .w-\[1px\]{ width: 1px; }#tf-state-5 .h-\[16px\]{ height: 16px; }#tf-state-5 .w-\[64px\]{ width: 64px; }#tf-state-5 .w-\[72px\]{ width: 72px; }#tf-state-5 .h-\[46px\]{ height: 46px; }#tf-state-5 .min-w-0{ min-width: 0; }#tf-state-5 .overflow-hidden{ overflow: hidden; }#tf-state-5 .overflow-x-auto{ overflow-x: auto; }#tf-state-5 .overflow-y-auto{ overflow-y: auto; }#tf-state-5 .overflow-x-hidden{ overflow-x: hidden; }#tf-state-5 .cursor-pointer{ cursor: pointer; }#tf-state-5 .pointer-events-none{ pointer-events: none; }#tf-state-5 .border-none{ border: none; }#tf-state-5 .border-0{ border: 0; }#tf-state-5 .border{ border: 1px solid var(--color-border-subtle); }#tf-state-5 .border-b{ border-bottom: 1px solid var(--color-border-subtle); }#tf-state-5 .border-black{ border-color: #000; }#tf-state-5 .bg-transparent{ background: transparent; }#tf-state-5 .bg-white{ background-color: #fff; }#tf-state-5 .bg-\[var\(--color-primary\)\]{ background-color: var(--color-primary); }#tf-state-5 .bg-\[var\(--color-bg-hover\)\]{ background-color: var(--color-bg-hover); }#tf-state-5 .bg-\[var\(--color-primary-active\)\]{ background-color: var(--color-primary-active); }#tf-state-5 .text-white{ color: #fff; }#tf-state-5 .rounded-\[var\(--radius-xxs\)\]{ border-radius: var(--radius-xxs); }#tf-state-5 .rounded-\[var\(--radius-md\)\]{ border-radius: var(--radius-md); }#tf-state-5 .rounded-\[var\(--radius-lg\)\]{ border-radius: var(--radius-lg); }#tf-state-5 .rounded-\[var\(--radius-xl\)\]{ border-radius: var(--radius-xl); }#tf-state-5 .rounded-\[var\(--radius-2xl\)\]{ border-radius: var(--radius-2xl); }#tf-state-5 .rounded-\[var\(--radius-full\)\]{ border-radius: var(--radius-full); }#tf-state-5 .truncate{ overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }#tf-state-5 .whitespace-nowrap{ white-space: nowrap; }#tf-state-5 .text-left{ text-align: left; }#tf-state-5 .text-center{ text-align: center; }#tf-state-5 .p-0{ padding: 0; }#tf-state-5 .px-3{ padding-left: 12px; padding-right: 12px; }#tf-state-5 .px-4{ padding-left: 16px; padding-right: 16px; }#tf-state-5 .py-2{ padding-top: 8px; padding-bottom: 8px; }#tf-state-5 .py-2\.5{ padding-top: 10px; padding-bottom: 10px; }#tf-state-5 .py-16{ padding-top: 64px; padding-bottom: 64px; }#tf-state-5 .pl-\[var\(--spacing-lg\)\]{ padding-left: var(--spacing-lg); }#tf-state-5 .mt-2{ margin-top: 8px; }#tf-state-5 .mb-3{ margin-bottom: 12px; }#tf-state-5 .-top-0\.5{ top: -2px; }#tf-state-5 .-right-0\.5{ right: -2px; }#tf-state-5 .left-1\/2{ left: 50%; }#tf-state-5 .top-1\/2{ top: 50%; }#tf-state-5 .-translate-y-1\/2{ transform: translateY(-50%); }#tf-state-5 .rotate-180{ transform: rotate(180deg); }#tf-state-5 .gap-0{ gap: 0; }#tf-state-5 .gap-2{ gap: 8px; }#tf-state-5 .gap-4{ gap: 16px; }#tf-state-5 .grid-cols-3{ grid-template-columns: repeat(3, minmax(0, 1fr)); }#tf-state-5 .space-y-2 > * + *{ margin-top: 8px; }#tf-state-5 .transition-all,#tf-state-5 .transition-colors,#tf-state-5 .transition-opacity,#tf-state-5 .transition-transform{
  transition-duration: 150ms;
  transition-timing-function: ease;
}#tf-state-5 .duration-150{ transition-duration: 150ms; }#tf-state-5 .duration-200{ transition-duration: 200ms; }#tf-state-5 .opacity-40{ opacity: 0.4; }#tf-state-5 .line-clamp-2{
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}



@keyframes slide-in-right {
  from { transform: translateX(100%); }
  to   { transform: translateX(0); }
}
@keyframes slide-out-right {
  from { transform: translateX(0); }
  to   { transform: translateX(100%); }
}
@keyframes fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes slide-up {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}
@keyframes page-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}#tf-state-5 .animate-slide-in-right{ animation: slide-in-right 300ms ease-out forwards; }#tf-state-5 .animate-slide-out-right{ animation: slide-out-right 300ms ease-in forwards; }#tf-state-5 .fade-in{ animation: fade-in 300ms ease-out forwards; }#tf-state-5 .animate-slide-up{ animation: slide-up 300ms ease-out forwards; }#tf-state-5 .animate-page-in{ animation: page-in 150ms ease-out; }#tf-state-5 [data-component-id="product_price"]{
  display: inline-block;
}



@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Regular.ttf') format('truetype');
  font-weight: 400;
  font-display: swap;
}

@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Medium.ttf') format('truetype');
  font-weight: 500;
  font-display: swap;
}

@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Bold.ttf') format('truetype');
  font-weight: 600;
  font-display: swap;
}

@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Bold.ttf') format('truetype');
  font-weight: 700;
  font-display: swap;
}



@layer base {
  :root {
    
    --background: oklch(1 0 0);
    --foreground: var(--color-text-primary);
    --card: var(--color-bg-card);
    --card-foreground: var(--color-text-primary);
    --popover: var(--color-bg-card);
    --popover-foreground: var(--color-text-primary);
    --primary: var(--color-primary);
    --primary-foreground: var(--color-text-white);
    --secondary: var(--color-bg-hover);
    --secondary-foreground: var(--color-text-primary);
    --muted: var(--color-bg-disabled);
    --muted-foreground: var(--color-text-secondary);
    --accent: var(--color-primary-active);
    --accent-foreground: var(--color-primary);
    --destructive: var(--color-error);
    --destructive-foreground: var(--color-text-white);
    --border: var(--color-border-subtle);
    --input: var(--color-border-subtle);
    --ring: var(--color-primary);
    --radius: 0.625rem;
    --chart-1: oklch(0.87 0 0);
    --chart-2: oklch(0.556 0 0);
    --chart-3: oklch(0.439 0 0);
    --chart-4: oklch(0.371 0 0);
    --chart-5: oklch(0.269 0 0);
    --sidebar: oklch(0.985 0 0);
    --sidebar-foreground: var(--color-text-primary);
    --sidebar-primary: var(--color-primary);
    --sidebar-primary-foreground: var(--color-text-white);
    --sidebar-accent: var(--color-primary-active);
    --sidebar-accent-foreground: var(--color-primary);
    --sidebar-border: var(--color-border-subtle);
    --sidebar-ring: var(--color-primary);

    
    --color-text-primary:     rgba(0, 0, 0, 0.9);
    --color-text-secondary:   rgba(0, 0, 0, 0.6);
    --color-text-muted:       rgba(0, 0, 0, 0.4);
    --color-text-hint:        rgba(0, 0, 0, 0.4);
    --color-text-disabled:    rgba(0, 0, 0, 0.2);
    --color-text-white:       #ffffff;

    --color-primary: #C7000B;
    --color-primary-disabled: rgba(199, 0, 11, 0.4);
    --color-primary-soft: rgba(199, 0, 11, 0.05);
    --color-primary-active: rgba(199, 0, 11, 0.08);
    --color-orange: #FF8C42;

    --color-success: #10B981;
    --color-warning: #F97316;
    --color-error: #DC2626;

    --color-bg-page: #F2F3F5;
    --color-bg-card: #ffffff;
    --color-bg-hover: rgba(0, 0, 0, 0.04);
    --color-bg-disabled: rgba(0, 0, 0, 0.05);

    --color-border-subtle: rgba(0, 0, 0, 0.06);

    --color-divider-strong:  rgba(0, 0, 0, 0.6);
    --color-divider:         rgba(0, 0, 0, 0.1);
    --color-divider-subtle:  rgba(0, 0, 0, 0.05);
    --color-divider-faint:   rgba(0, 0, 0, 0.03);

    --color-mask: rgba(0, 0, 0, 0.3);

    --radius-xxs: 4px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 18px;
    --radius-2xl: 20px;
    --radius-3xl: 24px;
    --radius-4xl: 32px;
    --radius-full: 9999px;

    --shadow-sm: 0 1px 6px 0 rgba(0, 0, 0, 0.08);
    --shadow-md: 0 8px 24px 0 rgba(0, 0, 0, 0.08);
    --shadow-lg: 0 8px 24px 0 rgba(0, 0, 0, 0.16);
    --shadow-xl: 0 10px 20px 0 rgba(0, 0, 0, 0.15);

    --font-caption-10:  10px;
    --font-caption-12:  12px;
    --font-display-36: 36px;
    --font-display-48: 48px;
    --font-display-60: 60px;
    --font-headline-12: 12px;
    --font-headline-14: 14px;
    --font-headline-16: 16px;
    --font-headline-18: 18px;
    --font-headline-20: 20px;
    --font-headline-24: 24px;
    --font-body-12: 12px;
    --font-body-14: 14px;
    --font-body-16: 16px;

    --font-weight-regular:  400;
    --font-weight-medium:   500;
    --font-weight-semibold: 600;
    --font-weight-bold:     700;

    --line-height-12: 12px;
    --line-height-14: 14px;
    --line-height-16: 16px;
    --line-height-18: 18px;
    --line-height-20: 20px;
    --line-height-24: 24px;
    --line-height-26: 26px;
    --line-height-30: 30px;
    --line-height-32: 32px;
    --line-height-36: 36px;
    --line-height-48: 48px;
    --line-height-60: 60px;
    --line-height-64: 64px;
    --line-height-80: 80px;

    --spacing-xs: 4px;
    --spacing-sm: 6px;
    --spacing-md: 8px;
    --spacing-lg: 12px;
    --spacing-xl: 16px;
    --spacing-2xl: 24px;
  }

  .dark {
    --background: oklch(0.145 0 0);
    --foreground: oklch(0.985 0 0);
    --card: oklch(0.205 0 0);
    --card-foreground: oklch(0.985 0 0);
    --popover: oklch(0.205 0 0);
    --popover-foreground: oklch(0.985 0 0);
    --primary: var(--color-primary);
    --primary-foreground: var(--color-text-white);
    --secondary: oklch(0.269 0 0);
    --secondary-foreground: oklch(0.985 0 0);
    --muted: oklch(0.269 0 0);
    --muted-foreground: oklch(0.708 0 0);
    --accent: oklch(0.269 0 0);
    --accent-foreground: oklch(0.985 0 0);
    --destructive: var(--color-error);
    --destructive-foreground: var(--color-text-white);
    --border: oklch(1 0 0 / 10%);
    --input: oklch(1 0 0 / 15%);
    --ring: var(--color-primary);
    --chart-1: oklch(0.87 0 0);
    --chart-2: oklch(0.556 0 0);
    --chart-3: oklch(0.439 0 0);
    --chart-4: oklch(0.371 0 0);
    --chart-5: oklch(0.269 0 0);
    --sidebar: oklch(0.205 0 0);
    --sidebar-foreground: oklch(0.985 0 0);
    --sidebar-primary: oklch(0.488 0.243 264.376);
    --sidebar-primary-foreground: oklch(0.985 0 0);
    --sidebar-accent: oklch(0.269 0 0);
    --sidebar-accent-foreground: oklch(0.985 0 0);
    --sidebar-border: oklch(1 0 0 / 10%);
    --sidebar-ring: oklch(0.556 0 0);
  }

  * {
    @apply border-border;
    border-color: var(--color-border-subtle);
  }

  body {
    @apply bg-background text-foreground;
    font-family: 'HarmonyOS Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Noto Sans SC', sans-serif;
    background-color: var(--color-bg-page);
    color: var(--color-text-primary);
    -webkit-tap-highlight-color: transparent;
  }

  .theme {
    --font-heading: var(--font-sans);
    --font-sans: 'HarmonyOS Sans SC', sans-serif;
  }
  html {
    @apply font-sans;
  }
}



@layer components {
  
  .font-display-s { font-size: var(--font-display-36); line-height: var(--line-height-48); font-weight: var(--font-weight-medium); }
  .font-display-m { font-size: var(--font-display-48); line-height: var(--line-height-64); font-weight: var(--font-weight-medium); }
  .font-display-l { font-size: var(--font-display-60); line-height: var(--line-height-80); font-weight: var(--font-weight-medium); }

  
  .font-headline-xxs { font-size: var(--font-headline-12); line-height: var(--line-height-16); font-weight: var(--font-weight-medium); }
  .font-headline-xs  { font-size: var(--font-headline-14); line-height: var(--line-height-18); font-weight: var(--font-weight-medium); }
  .font-headline-s   { font-size: var(--font-headline-16); line-height: var(--line-height-20); font-weight: var(--font-weight-medium); }
  .font-headline-m   { font-size: var(--font-headline-18); line-height: var(--line-height-24); font-weight: var(--font-weight-medium); }
  .font-headline-l   { font-size: var(--font-headline-20); line-height: var(--line-height-26); font-weight: var(--font-weight-medium); }
  .font-headline-xl  { font-size: var(--font-headline-20); line-height: var(--line-height-26); font-weight: var(--font-weight-bold); }
  .font-headline-xxl { font-size: var(--font-headline-24); line-height: var(--line-height-32); font-weight: var(--font-weight-bold); }

  
  .font-headline-xs-multi { font-size: var(--font-headline-14); line-height: var(--line-height-20); font-weight: var(--font-weight-medium); }
  .font-headline-s-multi  { font-size: var(--font-headline-16); line-height: var(--line-height-24); font-weight: var(--font-weight-medium); }
  .font-headline-m-multi  { font-size: var(--font-headline-18); line-height: var(--line-height-26); font-weight: var(--font-weight-medium); }
  .font-headline-l-multi  { font-size: var(--font-headline-20); line-height: var(--line-height-30); font-weight: var(--font-weight-medium); }

  
  .font-body-s  { font-size: var(--font-body-12); line-height: var(--line-height-16); font-weight: var(--font-weight-regular); }
  .font-body-m  { font-size: var(--font-body-14); line-height: var(--line-height-18); font-weight: var(--font-weight-regular); }
  .font-body-l  { font-size: var(--font-body-16); line-height: var(--line-height-20); font-weight: var(--font-weight-regular); }

  
  .font-body-s-multi { font-size: var(--font-body-12); line-height: var(--line-height-18); font-weight: var(--font-weight-regular); }
  .font-body-m-multi { font-size: var(--font-body-14); line-height: var(--line-height-20); font-weight: var(--font-weight-regular); }
  .font-body-l-multi { font-size: var(--font-body-16); line-height: var(--line-height-24); font-weight: var(--font-weight-regular); }

  
  .font-caption-s { font-size: var(--font-caption-10); line-height: var(--line-height-12); font-weight: var(--font-weight-regular); }
  .font-caption-m { font-size: var(--font-caption-12); line-height: var(--line-height-16); font-weight: var(--font-weight-regular); }

  .font-caption-s-multi { font-size: var(--font-caption-10); line-height: var(--line-height-14); font-weight: var(--font-weight-regular); }
  .font-caption-m-multi { font-size: var(--font-caption-12); line-height: var(--line-height-18); font-weight: var(--font-weight-regular); }

  
  .p-page    { padding: var(--spacing-lg) var(--spacing-xl); }
  .p-card    { padding: var(--spacing-lg); }
  .p-card-sm { padding: var(--spacing-md); }
  .p-pill    { padding: var(--spacing-sm) var(--spacing-lg); }
  .p-tab     { padding: var(--spacing-xs) 0; }

  
  .size-icon-nav   { width: 40px; height: 40px; }
  .size-icon-entry { width: 48px; height: 48px; }
  .size-icon-card  { width: 40px; height: 40px; }
  .size-icon-sm    { width: 28px; height: 28px; }
  .size-badge      { width: 16px; height: 16px; font-size: 10px; }
  .size-icon-tab   { width: 30px; height: 30px; }
  .h-banner        { height: 140px; }

  
  .bg-gradient-layer-1 {
    width: 360px; height: 792px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.5) 0%, rgba(255,255,255,0) 100%),
      radial-gradient(circle 200px at 360px 140px, rgba(255,143,111,0.4) 0%, rgba(250,194,193,0) 100%),
      radial-gradient(circle 300px at 0px -100px, rgba(247,168,10,0.4) 0%, rgba(247,106,10,0) 100%),
      linear-gradient(180deg, #f6f6f5 0%, #f2f3f5 100%);
  }
  .bg-gradient-layer-2 {
    width: 360px; height: 792px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.4) 10%, rgba(255,255,255,0) 100%),
      radial-gradient(circle 231px at 320px 0px, rgba(255,143,111,0.2) 0%, rgba(250,194,193,0) 100%),
      radial-gradient(circle 271px at 85px -105px, rgba(247,168,10,0.2) 0%, rgba(247,106,10,0) 100%),
      linear-gradient(180deg, #f6f6f5 0%, #f2f3f5 100%);
  }
  .bg-gradient-layer-3 {
    width: 360px; height: 792px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.4) 10%, rgba(255,255,255,0) 100%),
      radial-gradient(circle 220px at 360px 0px, rgba(255,143,111,0.4) 0%, rgba(250,194,193,0) 100%),
      radial-gradient(circle 389px at 111px -284px, rgba(247,168,10,0.4) 0%, rgba(247,106,10,0) 100%),
      linear-gradient(180deg, #f6f6f5 0%, #f2f3f5 100%);
  }

  
  .tap-scale { transition: transform 150ms ease; }
  .tap-scale:active { transform: scale(0.98); }
  .tap-opacity:active { opacity: 0.8; }

  
  .flex-distribute { display: flex; align-items: center; justify-content: space-between; }
  .flex-center     { display: flex; align-items: center; }
  .flex-between    { display: flex; align-items: center; justify-content: space-between; }
  .scrollbar-hide { scrollbar-width: none; -ms-overflow-style: none; }
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .mobile-canvas,
  .mobile-canvas * { scrollbar-width: none; -ms-overflow-style: none; }
  .mobile-canvas::-webkit-scrollbar,
  .mobile-canvas *::-webkit-scrollbar { display: none; }

  
  .divider { border: none; border-top: 1px solid var(--color-divider); margin: 0; }
}#tf-state-5 .flex{ display: flex; }#tf-state-5 .inline-flex{ display: inline-flex; }#tf-state-5 .grid{ display: grid; }#tf-state-5 .block{ display: block; }#tf-state-5 .hidden{ display: none; }#tf-state-5 .flex-col{ flex-direction: column; }#tf-state-5 .flex-1{ flex: 1 1 0%; }#tf-state-5 .flex-shrink-0,#tf-state-5 .shrink-0{ flex-shrink: 0; }#tf-state-5 .items-start{ align-items: flex-start; }#tf-state-5 .items-center{ align-items: center; }#tf-state-5 .items-end{ align-items: flex-end; }#tf-state-5 .items-baseline{ align-items: baseline; }#tf-state-5 .justify-center{ justify-content: center; }#tf-state-5 .justify-between{ justify-content: space-between; }#tf-state-5 .relative{ position: relative; }#tf-state-5 .absolute{ position: absolute; }#tf-state-5 .fixed{ position: fixed; }#tf-state-5 .inset-0{ inset: 0; }#tf-state-5 .top-full{ top: 100%; }#tf-state-5 .left-0{ left: 0; }#tf-state-5 .right-0{ right: 0; }#tf-state-5 .top-0{ top: 0; }#tf-state-5 .bottom-0{ bottom: 0; }#tf-state-5 .z-10{ z-index: 10; }#tf-state-5 .z-40{ z-index: 40; }#tf-state-5 .z-50{ z-index: 50; }#tf-state-5 .w-full{ width: 100%; }#tf-state-5 .h-full{ height: 100%; }#tf-state-5 .w-5{ width: 20px; }#tf-state-5 .h-5{ height: 20px; }#tf-state-5 .w-8{ width: 32px; }#tf-state-5 .w-10{ width: 40px; }#tf-state-5 .h-10{ height: 40px; }#tf-state-5 .w-12{ width: 48px; }#tf-state-5 .h-12{ height: 48px; }#tf-state-5 .w-\[1px\]{ width: 1px; }#tf-state-5 .h-\[16px\]{ height: 16px; }#tf-state-5 .w-\[64px\]{ width: 64px; }#tf-state-5 .w-\[72px\]{ width: 72px; }#tf-state-5 .h-\[46px\]{ height: 46px; }#tf-state-5 .min-w-0{ min-width: 0; }#tf-state-5 .overflow-hidden{ overflow: hidden; }#tf-state-5 .overflow-x-auto{ overflow-x: auto; }#tf-state-5 .overflow-y-auto{ overflow-y: auto; }#tf-state-5 .overflow-x-hidden{ overflow-x: hidden; }#tf-state-5 .cursor-pointer{ cursor: pointer; }#tf-state-5 .pointer-events-none{ pointer-events: none; }#tf-state-5 .border-none{ border: none; }#tf-state-5 .border-0{ border: 0; }#tf-state-5 .border{ border: 1px solid var(--color-border-subtle); }#tf-state-5 .border-b{ border-bottom: 1px solid var(--color-border-subtle); }#tf-state-5 .border-black{ border-color: #000; }#tf-state-5 .bg-transparent{ background: transparent; }#tf-state-5 .bg-white{ background-color: #fff; }#tf-state-5 .bg-\[var\(--color-primary\)\]{ background-color: var(--color-primary); }#tf-state-5 .bg-\[var\(--color-bg-hover\)\]{ background-color: var(--color-bg-hover); }#tf-state-5 .bg-\[var\(--color-primary-active\)\]{ background-color: var(--color-primary-active); }#tf-state-5 .text-white{ color: #fff; }#tf-state-5 .rounded-\[var\(--radius-xxs\)\]{ border-radius: var(--radius-xxs); }#tf-state-5 .rounded-\[var\(--radius-md\)\]{ border-radius: var(--radius-md); }#tf-state-5 .rounded-\[var\(--radius-lg\)\]{ border-radius: var(--radius-lg); }#tf-state-5 .rounded-\[var\(--radius-xl\)\]{ border-radius: var(--radius-xl); }#tf-state-5 .rounded-\[var\(--radius-2xl\)\]{ border-radius: var(--radius-2xl); }#tf-state-5 .rounded-\[var\(--radius-full\)\]{ border-radius: var(--radius-full); }#tf-state-5 .truncate{ overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }#tf-state-5 .whitespace-nowrap{ white-space: nowrap; }#tf-state-5 .text-left{ text-align: left; }#tf-state-5 .text-center{ text-align: center; }#tf-state-5 .p-0{ padding: 0; }#tf-state-5 .px-3{ padding-left: 12px; padding-right: 12px; }#tf-state-5 .px-4{ padding-left: 16px; padding-right: 16px; }#tf-state-5 .py-2{ padding-top: 8px; padding-bottom: 8px; }#tf-state-5 .py-2\.5{ padding-top: 10px; padding-bottom: 10px; }#tf-state-5 .py-16{ padding-top: 64px; padding-bottom: 64px; }#tf-state-5 .pl-\[var\(--spacing-lg\)\]{ padding-left: var(--spacing-lg); }#tf-state-5 .mt-2{ margin-top: 8px; }#tf-state-5 .mb-3{ margin-bottom: 12px; }#tf-state-5 .-top-0\.5{ top: -2px; }#tf-state-5 .-right-0\.5{ right: -2px; }#tf-state-5 .left-1\/2{ left: 50%; }#tf-state-5 .top-1\/2{ top: 50%; }#tf-state-5 .-translate-y-1\/2{ transform: translateY(-50%); }#tf-state-5 .rotate-180{ transform: rotate(180deg); }#tf-state-5 .gap-0{ gap: 0; }#tf-state-5 .gap-2{ gap: 8px; }#tf-state-5 .gap-4{ gap: 16px; }#tf-state-5 .grid-cols-3{ grid-template-columns: repeat(3, minmax(0, 1fr)); }#tf-state-5 .space-y-2 > * + *{ margin-top: 8px; }#tf-state-5 .transition-all,#tf-state-5 .transition-colors,#tf-state-5 .transition-opacity,#tf-state-5 .transition-transform{
  transition-duration: 150ms;
  transition-timing-function: ease;
}#tf-state-5 .duration-150{ transition-duration: 150ms; }#tf-state-5 .duration-200{ transition-duration: 200ms; }#tf-state-5 .opacity-40{ opacity: 0.4; }#tf-state-5 .line-clamp-2{
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}



@keyframes slide-in-right {
  from { transform: translateX(100%); }
  to   { transform: translateX(0); }
}
@keyframes slide-out-right {
  from { transform: translateX(0); }
  to   { transform: translateX(100%); }
}
@keyframes fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes slide-up {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}
@keyframes page-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}#tf-state-5 .animate-slide-in-right{ animation: slide-in-right 300ms ease-out forwards; }#tf-state-5 .animate-slide-out-right{ animation: slide-out-right 300ms ease-in forwards; }#tf-state-5 .fade-in{ animation: fade-in 300ms ease-out forwards; }#tf-state-5 .animate-slide-up{ animation: slide-up 300ms ease-out forwards; }#tf-state-5 .animate-page-in{ animation: page-in 150ms ease-out; }#tf-state-5 .tf-cg-text{
  word-break: break-word;
}



@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Regular.ttf') format('truetype');
  font-weight: 400;
  font-display: swap;
}

@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Medium.ttf') format('truetype');
  font-weight: 500;
  font-display: swap;
}

@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Bold.ttf') format('truetype');
  font-weight: 600;
  font-display: swap;
}

@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Bold.ttf') format('truetype');
  font-weight: 700;
  font-display: swap;
}



@layer base {
  :root {
    
    --background: oklch(1 0 0);
    --foreground: var(--color-text-primary);
    --card: var(--color-bg-card);
    --card-foreground: var(--color-text-primary);
    --popover: var(--color-bg-card);
    --popover-foreground: var(--color-text-primary);
    --primary: var(--color-primary);
    --primary-foreground: var(--color-text-white);
    --secondary: var(--color-bg-hover);
    --secondary-foreground: var(--color-text-primary);
    --muted: var(--color-bg-disabled);
    --muted-foreground: var(--color-text-secondary);
    --accent: var(--color-primary-active);
    --accent-foreground: var(--color-primary);
    --destructive: var(--color-error);
    --destructive-foreground: var(--color-text-white);
    --border: var(--color-border-subtle);
    --input: var(--color-border-subtle);
    --ring: var(--color-primary);
    --radius: 0.625rem;
    --chart-1: oklch(0.87 0 0);
    --chart-2: oklch(0.556 0 0);
    --chart-3: oklch(0.439 0 0);
    --chart-4: oklch(0.371 0 0);
    --chart-5: oklch(0.269 0 0);
    --sidebar: oklch(0.985 0 0);
    --sidebar-foreground: var(--color-text-primary);
    --sidebar-primary: var(--color-primary);
    --sidebar-primary-foreground: var(--color-text-white);
    --sidebar-accent: var(--color-primary-active);
    --sidebar-accent-foreground: var(--color-primary);
    --sidebar-border: var(--color-border-subtle);
    --sidebar-ring: var(--color-primary);

    
    --color-text-primary:     rgba(0, 0, 0, 0.9);
    --color-text-secondary:   rgba(0, 0, 0, 0.6);
    --color-text-muted:       rgba(0, 0, 0, 0.4);
    --color-text-hint:        rgba(0, 0, 0, 0.4);
    --color-text-disabled:    rgba(0, 0, 0, 0.2);
    --color-text-white:       #ffffff;

    --color-primary: #C7000B;
    --color-primary-disabled: rgba(199, 0, 11, 0.4);
    --color-primary-soft: rgba(199, 0, 11, 0.05);
    --color-primary-active: rgba(199, 0, 11, 0.08);
    --color-orange: #FF8C42;

    --color-success: #10B981;
    --color-warning: #F97316;
    --color-error: #DC2626;

    --color-bg-page: #F2F3F5;
    --color-bg-card: #ffffff;
    --color-bg-hover: rgba(0, 0, 0, 0.04);
    --color-bg-disabled: rgba(0, 0, 0, 0.05);

    --color-border-subtle: rgba(0, 0, 0, 0.06);

    --color-divider-strong:  rgba(0, 0, 0, 0.6);
    --color-divider:         rgba(0, 0, 0, 0.1);
    --color-divider-subtle:  rgba(0, 0, 0, 0.05);
    --color-divider-faint:   rgba(0, 0, 0, 0.03);

    --color-mask: rgba(0, 0, 0, 0.3);

    --radius-xxs: 4px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 18px;
    --radius-2xl: 20px;
    --radius-3xl: 24px;
    --radius-4xl: 32px;
    --radius-full: 9999px;

    --shadow-sm: 0 1px 6px 0 rgba(0, 0, 0, 0.08);
    --shadow-md: 0 8px 24px 0 rgba(0, 0, 0, 0.08);
    --shadow-lg: 0 8px 24px 0 rgba(0, 0, 0, 0.16);
    --shadow-xl: 0 10px 20px 0 rgba(0, 0, 0, 0.15);

    --font-caption-10:  10px;
    --font-caption-12:  12px;
    --font-display-36: 36px;
    --font-display-48: 48px;
    --font-display-60: 60px;
    --font-headline-12: 12px;
    --font-headline-14: 14px;
    --font-headline-16: 16px;
    --font-headline-18: 18px;
    --font-headline-20: 20px;
    --font-headline-24: 24px;
    --font-body-12: 12px;
    --font-body-14: 14px;
    --font-body-16: 16px;

    --font-weight-regular:  400;
    --font-weight-medium:   500;
    --font-weight-semibold: 600;
    --font-weight-bold:     700;

    --line-height-12: 12px;
    --line-height-14: 14px;
    --line-height-16: 16px;
    --line-height-18: 18px;
    --line-height-20: 20px;
    --line-height-24: 24px;
    --line-height-26: 26px;
    --line-height-30: 30px;
    --line-height-32: 32px;
    --line-height-36: 36px;
    --line-height-48: 48px;
    --line-height-60: 60px;
    --line-height-64: 64px;
    --line-height-80: 80px;

    --spacing-xs: 4px;
    --spacing-sm: 6px;
    --spacing-md: 8px;
    --spacing-lg: 12px;
    --spacing-xl: 16px;
    --spacing-2xl: 24px;
  }

  .dark {
    --background: oklch(0.145 0 0);
    --foreground: oklch(0.985 0 0);
    --card: oklch(0.205 0 0);
    --card-foreground: oklch(0.985 0 0);
    --popover: oklch(0.205 0 0);
    --popover-foreground: oklch(0.985 0 0);
    --primary: var(--color-primary);
    --primary-foreground: var(--color-text-white);
    --secondary: oklch(0.269 0 0);
    --secondary-foreground: oklch(0.985 0 0);
    --muted: oklch(0.269 0 0);
    --muted-foreground: oklch(0.708 0 0);
    --accent: oklch(0.269 0 0);
    --accent-foreground: oklch(0.985 0 0);
    --destructive: var(--color-error);
    --destructive-foreground: var(--color-text-white);
    --border: oklch(1 0 0 / 10%);
    --input: oklch(1 0 0 / 15%);
    --ring: var(--color-primary);
    --chart-1: oklch(0.87 0 0);
    --chart-2: oklch(0.556 0 0);
    --chart-3: oklch(0.439 0 0);
    --chart-4: oklch(0.371 0 0);
    --chart-5: oklch(0.269 0 0);
    --sidebar: oklch(0.205 0 0);
    --sidebar-foreground: oklch(0.985 0 0);
    --sidebar-primary: oklch(0.488 0.243 264.376);
    --sidebar-primary-foreground: oklch(0.985 0 0);
    --sidebar-accent: oklch(0.269 0 0);
    --sidebar-accent-foreground: oklch(0.985 0 0);
    --sidebar-border: oklch(1 0 0 / 10%);
    --sidebar-ring: oklch(0.556 0 0);
  }

  * {
    @apply border-border;
    border-color: var(--color-border-subtle);
  }

  body {
    @apply bg-background text-foreground;
    font-family: 'HarmonyOS Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Noto Sans SC', sans-serif;
    background-color: var(--color-bg-page);
    color: var(--color-text-primary);
    -webkit-tap-highlight-color: transparent;
  }

  .theme {
    --font-heading: var(--font-sans);
    --font-sans: 'HarmonyOS Sans SC', sans-serif;
  }
  html {
    @apply font-sans;
  }
}



@layer components {
  
  .font-display-s { font-size: var(--font-display-36); line-height: var(--line-height-48); font-weight: var(--font-weight-medium); }
  .font-display-m { font-size: var(--font-display-48); line-height: var(--line-height-64); font-weight: var(--font-weight-medium); }
  .font-display-l { font-size: var(--font-display-60); line-height: var(--line-height-80); font-weight: var(--font-weight-medium); }

  
  .font-headline-xxs { font-size: var(--font-headline-12); line-height: var(--line-height-16); font-weight: var(--font-weight-medium); }
  .font-headline-xs  { font-size: var(--font-headline-14); line-height: var(--line-height-18); font-weight: var(--font-weight-medium); }
  .font-headline-s   { font-size: var(--font-headline-16); line-height: var(--line-height-20); font-weight: var(--font-weight-medium); }
  .font-headline-m   { font-size: var(--font-headline-18); line-height: var(--line-height-24); font-weight: var(--font-weight-medium); }
  .font-headline-l   { font-size: var(--font-headline-20); line-height: var(--line-height-26); font-weight: var(--font-weight-medium); }
  .font-headline-xl  { font-size: var(--font-headline-20); line-height: var(--line-height-26); font-weight: var(--font-weight-bold); }
  .font-headline-xxl { font-size: var(--font-headline-24); line-height: var(--line-height-32); font-weight: var(--font-weight-bold); }

  
  .font-headline-xs-multi { font-size: var(--font-headline-14); line-height: var(--line-height-20); font-weight: var(--font-weight-medium); }
  .font-headline-s-multi  { font-size: var(--font-headline-16); line-height: var(--line-height-24); font-weight: var(--font-weight-medium); }
  .font-headline-m-multi  { font-size: var(--font-headline-18); line-height: var(--line-height-26); font-weight: var(--font-weight-medium); }
  .font-headline-l-multi  { font-size: var(--font-headline-20); line-height: var(--line-height-30); font-weight: var(--font-weight-medium); }

  
  .font-body-s  { font-size: var(--font-body-12); line-height: var(--line-height-16); font-weight: var(--font-weight-regular); }
  .font-body-m  { font-size: var(--font-body-14); line-height: var(--line-height-18); font-weight: var(--font-weight-regular); }
  .font-body-l  { font-size: var(--font-body-16); line-height: var(--line-height-20); font-weight: var(--font-weight-regular); }

  
  .font-body-s-multi { font-size: var(--font-body-12); line-height: var(--line-height-18); font-weight: var(--font-weight-regular); }
  .font-body-m-multi { font-size: var(--font-body-14); line-height: var(--line-height-20); font-weight: var(--font-weight-regular); }
  .font-body-l-multi { font-size: var(--font-body-16); line-height: var(--line-height-24); font-weight: var(--font-weight-regular); }

  
  .font-caption-s { font-size: var(--font-caption-10); line-height: var(--line-height-12); font-weight: var(--font-weight-regular); }
  .font-caption-m { font-size: var(--font-caption-12); line-height: var(--line-height-16); font-weight: var(--font-weight-regular); }

  .font-caption-s-multi { font-size: var(--font-caption-10); line-height: var(--line-height-14); font-weight: var(--font-weight-regular); }
  .font-caption-m-multi { font-size: var(--font-caption-12); line-height: var(--line-height-18); font-weight: var(--font-weight-regular); }

  
  .p-page    { padding: var(--spacing-lg) var(--spacing-xl); }
  .p-card    { padding: var(--spacing-lg); }
  .p-card-sm { padding: var(--spacing-md); }
  .p-pill    { padding: var(--spacing-sm) var(--spacing-lg); }
  .p-tab     { padding: var(--spacing-xs) 0; }

  
  .size-icon-nav   { width: 40px; height: 40px; }
  .size-icon-entry { width: 48px; height: 48px; }
  .size-icon-card  { width: 40px; height: 40px; }
  .size-icon-sm    { width: 28px; height: 28px; }
  .size-badge      { width: 16px; height: 16px; font-size: 10px; }
  .size-icon-tab   { width: 30px; height: 30px; }
  .h-banner        { height: 140px; }

  
  .bg-gradient-layer-1 {
    width: 360px; height: 792px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.5) 0%, rgba(255,255,255,0) 100%),
      radial-gradient(circle 200px at 360px 140px, rgba(255,143,111,0.4) 0%, rgba(250,194,193,0) 100%),
      radial-gradient(circle 300px at 0px -100px, rgba(247,168,10,0.4) 0%, rgba(247,106,10,0) 100%),
      linear-gradient(180deg, #f6f6f5 0%, #f2f3f5 100%);
  }
  .bg-gradient-layer-2 {
    width: 360px; height: 792px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.4) 10%, rgba(255,255,255,0) 100%),
      radial-gradient(circle 231px at 320px 0px, rgba(255,143,111,0.2) 0%, rgba(250,194,193,0) 100%),
      radial-gradient(circle 271px at 85px -105px, rgba(247,168,10,0.2) 0%, rgba(247,106,10,0) 100%),
      linear-gradient(180deg, #f6f6f5 0%, #f2f3f5 100%);
  }
  .bg-gradient-layer-3 {
    width: 360px; height: 792px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.4) 10%, rgba(255,255,255,0) 100%),
      radial-gradient(circle 220px at 360px 0px, rgba(255,143,111,0.4) 0%, rgba(250,194,193,0) 100%),
      radial-gradient(circle 389px at 111px -284px, rgba(247,168,10,0.4) 0%, rgba(247,106,10,0) 100%),
      linear-gradient(180deg, #f6f6f5 0%, #f2f3f5 100%);
  }

  
  .tap-scale { transition: transform 150ms ease; }
  .tap-scale:active { transform: scale(0.98); }
  .tap-opacity:active { opacity: 0.8; }

  
  .flex-distribute { display: flex; align-items: center; justify-content: space-between; }
  .flex-center     { display: flex; align-items: center; }
  .flex-between    { display: flex; align-items: center; justify-content: space-between; }
  .scrollbar-hide { scrollbar-width: none; -ms-overflow-style: none; }
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .mobile-canvas,
  .mobile-canvas * { scrollbar-width: none; -ms-overflow-style: none; }
  .mobile-canvas::-webkit-scrollbar,
  .mobile-canvas *::-webkit-scrollbar { display: none; }

  
  .divider { border: none; border-top: 1px solid var(--color-divider); margin: 0; }
}#tf-state-5 .flex{ display: flex; }#tf-state-5 .inline-flex{ display: inline-flex; }#tf-state-5 .grid{ display: grid; }#tf-state-5 .block{ display: block; }#tf-state-5 .hidden{ display: none; }#tf-state-5 .flex-col{ flex-direction: column; }#tf-state-5 .flex-1{ flex: 1 1 0%; }#tf-state-5 .flex-shrink-0,#tf-state-5 .shrink-0{ flex-shrink: 0; }#tf-state-5 .items-start{ align-items: flex-start; }#tf-state-5 .items-center{ align-items: center; }#tf-state-5 .items-end{ align-items: flex-end; }#tf-state-5 .items-baseline{ align-items: baseline; }#tf-state-5 .justify-center{ justify-content: center; }#tf-state-5 .justify-between{ justify-content: space-between; }#tf-state-5 .relative{ position: relative; }#tf-state-5 .absolute{ position: absolute; }#tf-state-5 .fixed{ position: fixed; }#tf-state-5 .inset-0{ inset: 0; }#tf-state-5 .top-full{ top: 100%; }#tf-state-5 .left-0{ left: 0; }#tf-state-5 .right-0{ right: 0; }#tf-state-5 .top-0{ top: 0; }#tf-state-5 .bottom-0{ bottom: 0; }#tf-state-5 .z-10{ z-index: 10; }#tf-state-5 .z-40{ z-index: 40; }#tf-state-5 .z-50{ z-index: 50; }#tf-state-5 .w-full{ width: 100%; }#tf-state-5 .h-full{ height: 100%; }#tf-state-5 .w-5{ width: 20px; }#tf-state-5 .h-5{ height: 20px; }#tf-state-5 .w-8{ width: 32px; }#tf-state-5 .w-10{ width: 40px; }#tf-state-5 .h-10{ height: 40px; }#tf-state-5 .w-12{ width: 48px; }#tf-state-5 .h-12{ height: 48px; }#tf-state-5 .w-\[1px\]{ width: 1px; }#tf-state-5 .h-\[16px\]{ height: 16px; }#tf-state-5 .w-\[64px\]{ width: 64px; }#tf-state-5 .w-\[72px\]{ width: 72px; }#tf-state-5 .h-\[46px\]{ height: 46px; }#tf-state-5 .min-w-0{ min-width: 0; }#tf-state-5 .overflow-hidden{ overflow: hidden; }#tf-state-5 .overflow-x-auto{ overflow-x: auto; }#tf-state-5 .overflow-y-auto{ overflow-y: auto; }#tf-state-5 .overflow-x-hidden{ overflow-x: hidden; }#tf-state-5 .cursor-pointer{ cursor: pointer; }#tf-state-5 .pointer-events-none{ pointer-events: none; }#tf-state-5 .border-none{ border: none; }#tf-state-5 .border-0{ border: 0; }#tf-state-5 .border{ border: 1px solid var(--color-border-subtle); }#tf-state-5 .border-b{ border-bottom: 1px solid var(--color-border-subtle); }#tf-state-5 .border-black{ border-color: #000; }#tf-state-5 .bg-transparent{ background: transparent; }#tf-state-5 .bg-white{ background-color: #fff; }#tf-state-5 .bg-\[var\(--color-primary\)\]{ background-color: var(--color-primary); }#tf-state-5 .bg-\[var\(--color-bg-hover\)\]{ background-color: var(--color-bg-hover); }#tf-state-5 .bg-\[var\(--color-primary-active\)\]{ background-color: var(--color-primary-active); }#tf-state-5 .text-white{ color: #fff; }#tf-state-5 .rounded-\[var\(--radius-xxs\)\]{ border-radius: var(--radius-xxs); }#tf-state-5 .rounded-\[var\(--radius-md\)\]{ border-radius: var(--radius-md); }#tf-state-5 .rounded-\[var\(--radius-lg\)\]{ border-radius: var(--radius-lg); }#tf-state-5 .rounded-\[var\(--radius-xl\)\]{ border-radius: var(--radius-xl); }#tf-state-5 .rounded-\[var\(--radius-2xl\)\]{ border-radius: var(--radius-2xl); }#tf-state-5 .rounded-\[var\(--radius-full\)\]{ border-radius: var(--radius-full); }#tf-state-5 .truncate{ overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }#tf-state-5 .whitespace-nowrap{ white-space: nowrap; }#tf-state-5 .text-left{ text-align: left; }#tf-state-5 .text-center{ text-align: center; }#tf-state-5 .p-0{ padding: 0; }#tf-state-5 .px-3{ padding-left: 12px; padding-right: 12px; }#tf-state-5 .px-4{ padding-left: 16px; padding-right: 16px; }#tf-state-5 .py-2{ padding-top: 8px; padding-bottom: 8px; }#tf-state-5 .py-2\.5{ padding-top: 10px; padding-bottom: 10px; }#tf-state-5 .py-16{ padding-top: 64px; padding-bottom: 64px; }#tf-state-5 .pl-\[var\(--spacing-lg\)\]{ padding-left: var(--spacing-lg); }#tf-state-5 .mt-2{ margin-top: 8px; }#tf-state-5 .mb-3{ margin-bottom: 12px; }#tf-state-5 .-top-0\.5{ top: -2px; }#tf-state-5 .-right-0\.5{ right: -2px; }#tf-state-5 .left-1\/2{ left: 50%; }#tf-state-5 .top-1\/2{ top: 50%; }#tf-state-5 .-translate-y-1\/2{ transform: translateY(-50%); }#tf-state-5 .rotate-180{ transform: rotate(180deg); }#tf-state-5 .gap-0{ gap: 0; }#tf-state-5 .gap-2{ gap: 8px; }#tf-state-5 .gap-4{ gap: 16px; }#tf-state-5 .grid-cols-3{ grid-template-columns: repeat(3, minmax(0, 1fr)); }#tf-state-5 .space-y-2 > * + *{ margin-top: 8px; }#tf-state-5 .transition-all,#tf-state-5 .transition-colors,#tf-state-5 .transition-opacity,#tf-state-5 .transition-transform{
  transition-duration: 150ms;
  transition-timing-function: ease;
}#tf-state-5 .duration-150{ transition-duration: 150ms; }#tf-state-5 .duration-200{ transition-duration: 200ms; }#tf-state-5 .opacity-40{ opacity: 0.4; }#tf-state-5 .line-clamp-2{
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}



@keyframes slide-in-right {
  from { transform: translateX(100%); }
  to   { transform: translateX(0); }
}
@keyframes slide-out-right {
  from { transform: translateX(0); }
  to   { transform: translateX(100%); }
}
@keyframes fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes slide-up {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}
@keyframes page-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}#tf-state-5 .animate-slide-in-right{ animation: slide-in-right 300ms ease-out forwards; }#tf-state-5 .animate-slide-out-right{ animation: slide-out-right 300ms ease-in forwards; }#tf-state-5 .fade-in{ animation: fade-in 300ms ease-out forwards; }#tf-state-5 .animate-slide-up{ animation: slide-up 300ms ease-out forwards; }#tf-state-5 .animate-page-in{ animation: page-in 150ms ease-out; }#tf-state-5 [data-component-id="product_tags"]{
  display: inline-flex;
  align-items: center;
}



@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Regular.ttf') format('truetype');
  font-weight: 400;
  font-display: swap;
}

@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Medium.ttf') format('truetype');
  font-weight: 500;
  font-display: swap;
}

@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Bold.ttf') format('truetype');
  font-weight: 600;
  font-display: swap;
}

@font-face {
  font-family: 'HarmonyOS Sans SC';
  src: url('../assets/fonts/harmonyos-sans-sc/HarmonyOS_Sans_SC_Bold.ttf') format('truetype');
  font-weight: 700;
  font-display: swap;
}



@layer base {
  :root {
    
    --background: oklch(1 0 0);
    --foreground: var(--color-text-primary);
    --card: var(--color-bg-card);
    --card-foreground: var(--color-text-primary);
    --popover: var(--color-bg-card);
    --popover-foreground: var(--color-text-primary);
    --primary: var(--color-primary);
    --primary-foreground: var(--color-text-white);
    --secondary: var(--color-bg-hover);
    --secondary-foreground: var(--color-text-primary);
    --muted: var(--color-bg-disabled);
    --muted-foreground: var(--color-text-secondary);
    --accent: var(--color-primary-active);
    --accent-foreground: var(--color-primary);
    --destructive: var(--color-error);
    --destructive-foreground: var(--color-text-white);
    --border: var(--color-border-subtle);
    --input: var(--color-border-subtle);
    --ring: var(--color-primary);
    --radius: 0.625rem;
    --chart-1: oklch(0.87 0 0);
    --chart-2: oklch(0.556 0 0);
    --chart-3: oklch(0.439 0 0);
    --chart-4: oklch(0.371 0 0);
    --chart-5: oklch(0.269 0 0);
    --sidebar: oklch(0.985 0 0);
    --sidebar-foreground: var(--color-text-primary);
    --sidebar-primary: var(--color-primary);
    --sidebar-primary-foreground: var(--color-text-white);
    --sidebar-accent: var(--color-primary-active);
    --sidebar-accent-foreground: var(--color-primary);
    --sidebar-border: var(--color-border-subtle);
    --sidebar-ring: var(--color-primary);

    
    --color-text-primary:     rgba(0, 0, 0, 0.9);
    --color-text-secondary:   rgba(0, 0, 0, 0.6);
    --color-text-muted:       rgba(0, 0, 0, 0.4);
    --color-text-hint:        rgba(0, 0, 0, 0.4);
    --color-text-disabled:    rgba(0, 0, 0, 0.2);
    --color-text-white:       #ffffff;

    --color-primary: #C7000B;
    --color-primary-disabled: rgba(199, 0, 11, 0.4);
    --color-primary-soft: rgba(199, 0, 11, 0.05);
    --color-primary-active: rgba(199, 0, 11, 0.08);
    --color-orange: #FF8C42;

    --color-success: #10B981;
    --color-warning: #F97316;
    --color-error: #DC2626;

    --color-bg-page: #F2F3F5;
    --color-bg-card: #ffffff;
    --color-bg-hover: rgba(0, 0, 0, 0.04);
    --color-bg-disabled: rgba(0, 0, 0, 0.05);

    --color-border-subtle: rgba(0, 0, 0, 0.06);

    --color-divider-strong:  rgba(0, 0, 0, 0.6);
    --color-divider:         rgba(0, 0, 0, 0.1);
    --color-divider-subtle:  rgba(0, 0, 0, 0.05);
    --color-divider-faint:   rgba(0, 0, 0, 0.03);

    --color-mask: rgba(0, 0, 0, 0.3);

    --radius-xxs: 4px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 18px;
    --radius-2xl: 20px;
    --radius-3xl: 24px;
    --radius-4xl: 32px;
    --radius-full: 9999px;

    --shadow-sm: 0 1px 6px 0 rgba(0, 0, 0, 0.08);
    --shadow-md: 0 8px 24px 0 rgba(0, 0, 0, 0.08);
    --shadow-lg: 0 8px 24px 0 rgba(0, 0, 0, 0.16);
    --shadow-xl: 0 10px 20px 0 rgba(0, 0, 0, 0.15);

    --font-caption-10:  10px;
    --font-caption-12:  12px;
    --font-display-36: 36px;
    --font-display-48: 48px;
    --font-display-60: 60px;
    --font-headline-12: 12px;
    --font-headline-14: 14px;
    --font-headline-16: 16px;
    --font-headline-18: 18px;
    --font-headline-20: 20px;
    --font-headline-24: 24px;
    --font-body-12: 12px;
    --font-body-14: 14px;
    --font-body-16: 16px;

    --font-weight-regular:  400;
    --font-weight-medium:   500;
    --font-weight-semibold: 600;
    --font-weight-bold:     700;

    --line-height-12: 12px;
    --line-height-14: 14px;
    --line-height-16: 16px;
    --line-height-18: 18px;
    --line-height-20: 20px;
    --line-height-24: 24px;
    --line-height-26: 26px;
    --line-height-30: 30px;
    --line-height-32: 32px;
    --line-height-36: 36px;
    --line-height-48: 48px;
    --line-height-60: 60px;
    --line-height-64: 64px;
    --line-height-80: 80px;

    --spacing-xs: 4px;
    --spacing-sm: 6px;
    --spacing-md: 8px;
    --spacing-lg: 12px;
    --spacing-xl: 16px;
    --spacing-2xl: 24px;
  }

  .dark {
    --background: oklch(0.145 0 0);
    --foreground: oklch(0.985 0 0);
    --card: oklch(0.205 0 0);
    --card-foreground: oklch(0.985 0 0);
    --popover: oklch(0.205 0 0);
    --popover-foreground: oklch(0.985 0 0);
    --primary: var(--color-primary);
    --primary-foreground: var(--color-text-white);
    --secondary: oklch(0.269 0 0);
    --secondary-foreground: oklch(0.985 0 0);
    --muted: oklch(0.269 0 0);
    --muted-foreground: oklch(0.708 0 0);
    --accent: oklch(0.269 0 0);
    --accent-foreground: oklch(0.985 0 0);
    --destructive: var(--color-error);
    --destructive-foreground: var(--color-text-white);
    --border: oklch(1 0 0 / 10%);
    --input: oklch(1 0 0 / 15%);
    --ring: var(--color-primary);
    --chart-1: oklch(0.87 0 0);
    --chart-2: oklch(0.556 0 0);
    --chart-3: oklch(0.439 0 0);
    --chart-4: oklch(0.371 0 0);
    --chart-5: oklch(0.269 0 0);
    --sidebar: oklch(0.205 0 0);
    --sidebar-foreground: oklch(0.985 0 0);
    --sidebar-primary: oklch(0.488 0.243 264.376);
    --sidebar-primary-foreground: oklch(0.985 0 0);
    --sidebar-accent: oklch(0.269 0 0);
    --sidebar-accent-foreground: oklch(0.985 0 0);
    --sidebar-border: oklch(1 0 0 / 10%);
    --sidebar-ring: oklch(0.556 0 0);
  }

  * {
    @apply border-border;
    border-color: var(--color-border-subtle);
  }

  body {
    @apply bg-background text-foreground;
    font-family: 'HarmonyOS Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Noto Sans SC', sans-serif;
    background-color: var(--color-bg-page);
    color: var(--color-text-primary);
    -webkit-tap-highlight-color: transparent;
  }

  .theme {
    --font-heading: var(--font-sans);
    --font-sans: 'HarmonyOS Sans SC', sans-serif;
  }
  html {
    @apply font-sans;
  }
}



@layer components {
  
  .font-display-s { font-size: var(--font-display-36); line-height: var(--line-height-48); font-weight: var(--font-weight-medium); }
  .font-display-m { font-size: var(--font-display-48); line-height: var(--line-height-64); font-weight: var(--font-weight-medium); }
  .font-display-l { font-size: var(--font-display-60); line-height: var(--line-height-80); font-weight: var(--font-weight-medium); }

  
  .font-headline-xxs { font-size: var(--font-headline-12); line-height: var(--line-height-16); font-weight: var(--font-weight-medium); }
  .font-headline-xs  { font-size: var(--font-headline-14); line-height: var(--line-height-18); font-weight: var(--font-weight-medium); }
  .font-headline-s   { font-size: var(--font-headline-16); line-height: var(--line-height-20); font-weight: var(--font-weight-medium); }
  .font-headline-m   { font-size: var(--font-headline-18); line-height: var(--line-height-24); font-weight: var(--font-weight-medium); }
  .font-headline-l   { font-size: var(--font-headline-20); line-height: var(--line-height-26); font-weight: var(--font-weight-medium); }
  .font-headline-xl  { font-size: var(--font-headline-20); line-height: var(--line-height-26); font-weight: var(--font-weight-bold); }
  .font-headline-xxl { font-size: var(--font-headline-24); line-height: var(--line-height-32); font-weight: var(--font-weight-bold); }

  
  .font-headline-xs-multi { font-size: var(--font-headline-14); line-height: var(--line-height-20); font-weight: var(--font-weight-medium); }
  .font-headline-s-multi  { font-size: var(--font-headline-16); line-height: var(--line-height-24); font-weight: var(--font-weight-medium); }
  .font-headline-m-multi  { font-size: var(--font-headline-18); line-height: var(--line-height-26); font-weight: var(--font-weight-medium); }
  .font-headline-l-multi  { font-size: var(--font-headline-20); line-height: var(--line-height-30); font-weight: var(--font-weight-medium); }

  
  .font-body-s  { font-size: var(--font-body-12); line-height: var(--line-height-16); font-weight: var(--font-weight-regular); }
  .font-body-m  { font-size: var(--font-body-14); line-height: var(--line-height-18); font-weight: var(--font-weight-regular); }
  .font-body-l  { font-size: var(--font-body-16); line-height: var(--line-height-20); font-weight: var(--font-weight-regular); }

  
  .font-body-s-multi { font-size: var(--font-body-12); line-height: var(--line-height-18); font-weight: var(--font-weight-regular); }
  .font-body-m-multi { font-size: var(--font-body-14); line-height: var(--line-height-20); font-weight: var(--font-weight-regular); }
  .font-body-l-multi { font-size: var(--font-body-16); line-height: var(--line-height-24); font-weight: var(--font-weight-regular); }

  
  .font-caption-s { font-size: var(--font-caption-10); line-height: var(--line-height-12); font-weight: var(--font-weight-regular); }
  .font-caption-m { font-size: var(--font-caption-12); line-height: var(--line-height-16); font-weight: var(--font-weight-regular); }

  .font-caption-s-multi { font-size: var(--font-caption-10); line-height: var(--line-height-14); font-weight: var(--font-weight-regular); }
  .font-caption-m-multi { font-size: var(--font-caption-12); line-height: var(--line-height-18); font-weight: var(--font-weight-regular); }

  
  .p-page    { padding: var(--spacing-lg) var(--spacing-xl); }
  .p-card    { padding: var(--spacing-lg); }
  .p-card-sm { padding: var(--spacing-md); }
  .p-pill    { padding: var(--spacing-sm) var(--spacing-lg); }
  .p-tab     { padding: var(--spacing-xs) 0; }

  
  .size-icon-nav   { width: 40px; height: 40px; }
  .size-icon-entry { width: 48px; height: 48px; }
  .size-icon-card  { width: 40px; height: 40px; }
  .size-icon-sm    { width: 28px; height: 28px; }
  .size-badge      { width: 16px; height: 16px; font-size: 10px; }
  .size-icon-tab   { width: 30px; height: 30px; }
  .h-banner        { height: 140px; }

  
  .bg-gradient-layer-1 {
    width: 360px; height: 792px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.5) 0%, rgba(255,255,255,0) 100%),
      radial-gradient(circle 200px at 360px 140px, rgba(255,143,111,0.4) 0%, rgba(250,194,193,0) 100%),
      radial-gradient(circle 300px at 0px -100px, rgba(247,168,10,0.4) 0%, rgba(247,106,10,0) 100%),
      linear-gradient(180deg, #f6f6f5 0%, #f2f3f5 100%);
  }
  .bg-gradient-layer-2 {
    width: 360px; height: 792px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.4) 10%, rgba(255,255,255,0) 100%),
      radial-gradient(circle 231px at 320px 0px, rgba(255,143,111,0.2) 0%, rgba(250,194,193,0) 100%),
      radial-gradient(circle 271px at 85px -105px, rgba(247,168,10,0.2) 0%, rgba(247,106,10,0) 100%),
      linear-gradient(180deg, #f6f6f5 0%, #f2f3f5 100%);
  }
  .bg-gradient-layer-3 {
    width: 360px; height: 792px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.4) 10%, rgba(255,255,255,0) 100%),
      radial-gradient(circle 220px at 360px 0px, rgba(255,143,111,0.4) 0%, rgba(250,194,193,0) 100%),
      radial-gradient(circle 389px at 111px -284px, rgba(247,168,10,0.4) 0%, rgba(247,106,10,0) 100%),
      linear-gradient(180deg, #f6f6f5 0%, #f2f3f5 100%);
  }

  
  .tap-scale { transition: transform 150ms ease; }
  .tap-scale:active { transform: scale(0.98); }
  .tap-opacity:active { opacity: 0.8; }

  
  .flex-distribute { display: flex; align-items: center; justify-content: space-between; }
  .flex-center     { display: flex; align-items: center; }
  .flex-between    { display: flex; align-items: center; justify-content: space-between; }
  .scrollbar-hide { scrollbar-width: none; -ms-overflow-style: none; }
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .mobile-canvas,
  .mobile-canvas * { scrollbar-width: none; -ms-overflow-style: none; }
  .mobile-canvas::-webkit-scrollbar,
  .mobile-canvas *::-webkit-scrollbar { display: none; }

  
  .divider { border: none; border-top: 1px solid var(--color-divider); margin: 0; }

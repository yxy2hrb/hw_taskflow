translateY(-50%); }#tf-state-4 .rotate-180{ transform: rotate(180deg); }#tf-state-4 .gap-0{ gap: 0; }#tf-state-4 .gap-2{ gap: 8px; }#tf-state-4 .gap-4{ gap: 16px; }#tf-state-4 .grid-cols-3{ grid-template-columns: repeat(3, minmax(0, 1fr)); }#tf-state-4 .space-y-2 > * + *{ margin-top: 8px; }#tf-state-4 .transition-all,#tf-state-4 .transition-colors,#tf-state-4 .transition-opacity,#tf-state-4 .transition-transform{

t-id="aftersales_card"><div class="bg-white rounded-[var(--radius-lg)] flex flex-col" style="padding:var(--spacing-lg);gap:var(--spacing-lg)"><div class="flex items-center justify-between"><span class="font-headline-s" style="color:var(--color-text-primary)">售后信息</span></div><div class="tf-cg-aftersales-content" style="display:flex;flex-direction:column;gap:var(--spacing-md)"><div data-component-id="warranty_policy" class="tf-cg-text font-body-m" style="font-size:var(--font-body-14);line-height:var(--line-height-20);color:var(--color-text-primary)">保修政策：整机3年质保，主要部件5年质保</div><div data-component-id="service_guarantee" class="tf-cg-text"><span class="font-body-m" style="font-size:var(--font-body-14);line-height:var(--line-height-20);color:var(--color-text-primary)">服务保障：7x24小时技术支持，次日达上门服务</span></div></div></div></div><div data-component-id="tools_card"><div class="bg-white rounded-[var(--radius-lg)] flex flex-col" style="padding:var(--spacing-lg);gap:var(--spacing-lg)"><div class="flex items-center justify-between"><span class="font-headline-s" style="color:var(--color-text-primary)">售前/售后工具</span></div><div data-component-id="tools_grid" class="tf-cg-tools-grid"><div class="grid" style="grid-template-columns:repeat(4, 1fr);gap:var(--spacing-xl)"><button class="flex flex-col items-center bg-transparent border-none cursor-pointer" style="gap:var(--spacing-md)"><div class="rounded-[var(--radius-md)] flex items-center justify-center" style="width:40px;height:40px;background-color:var(--color-primary)15"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--color-primary)"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg></div><span class="font-body-s truncate w-full text-center" style="color:var(--color-text-primary)">配置报价</span></button><button class="flex flex-col items-center bg-transparent border-none c
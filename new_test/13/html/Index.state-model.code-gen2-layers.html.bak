#tf-state-6 .border{ border: 1px solid var(--color-border-subtle); }#tf-state-6 .border-b{ border-bottom: 1px solid var(--color-border-subtle); }#tf-state-6 .border-black{ border-color: #000; }#tf-state-6 .bg-transparent{ background: transparent; }#tf-state-6 .bg-white{ background-color: #fff; }#tf-state-6 .bg-\[var\(--color-primary\)\]{ background-color: var(--color-primary); }#tf-state-6 .bg-\[var\(--color-bg-hover\)\]{ background-color: var(--color-bg-hover); }#tf-state-6 .bg-\[var\(--color-primary-active\)\]{ background-color: var(--color-primary-active); }#tf-state-6 .text-white{ color: #fff; }#tf-state-6 .rounded-\[var\(--radius-xxs\)\]{ border-radius: var(--radius-xxs); }#tf-state-6 .rounded-\[var\(--radius-md\)\]{ border-radius: var(--radius-md); }#tf-state-6 .rounded-\[var\(--radius-lg\)\]{ border-radius: var(--radius-lg); }#tf-state-6 .rounded-\[var\(--radius-xl\)\]{ border-radius: var(--radius-xl); }#tf-state-6 .rounded-\[var\(--radius-2xl\)\]{ border-radius: var(--radius-2xl); }#tf-state-6 .rounded-\[var\(--radius-full\)\]{ border-radius: var(--radius-full); }#tf-state-6 .truncate{ overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }#tf-state-6 .whitespace-nowrap{ white-space: nowrap; }#tf-state-6 .text-left{ text-align: left; }#tf-state-6 .text-center{ text-align: center; }#tf-state-6 .p-0{ padding: 0; }#tf-state-6 .px-3{ padding-left: 12px; padding-right: 12px; }#tf-state-6 .px-4{ padding-left: 16px; padding-right: 16px; }#tf-state-6 .py-2{ padding-top: 8px; padding-bottom: 8px; }#tf-state-6 .py-2\.5{ padding-top: 10px; padding-bottom: 10px; }#tf-state-6 .py-16{ padding-top: 64px; padding-bottom: 64px; }#tf-state-6 .pl-\[var\(--spacing-lg\)\]{ padding-left: var(--spacing-lg); }#tf-state-6 .mt-2{ margin-top: 8px; }#tf-state-6 .mb-3{ margin-bottom: 12px; }#tf-state-6 .-top-0\.5{ top: -2px; }#tf-state-6 .-right-0\.5{ right: -2px; }#tf-state-6 .left-1\/2{ left: 50%; }#tf-state-6 .top-1\/2{ top: 50%; }#tf-state-6 .-translate-y-1\/2{ transform: translateY(-50%); }#tf-state-6 .rotate-180{ transform: rotate(180deg); }#tf-state-6 .gap-0{ gap: 0; }#tf-state-6 .gap-2{ gap: 8px; }#tf-state-6 .gap-4{ gap: 16px; }#tf-state-6 .grid-cols-3{ grid-template-columns: repeat(3, minmax(0, 1fr)); }#tf-state-6 .space-y-2 > * + *{ margin-top: 8px; }#tf-state-6 .transition-all,#tf-state-6 .transition-colors,#tf-state-6 .transition-opacity,#tf-state-6 .transition-transform{
  transition-duration: 150ms;
  transition-timing-function: ease;
}#tf-state-6 .duration-150{ transition-duration: 150ms; }#tf-state-6 .duration-200{ transition-duration: 200ms; }#tf-state-6 .opacity-40{ opacity: 0.4; }#tf-state-6 .line-clamp-2{
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;

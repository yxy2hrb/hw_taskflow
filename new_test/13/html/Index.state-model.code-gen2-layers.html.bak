#tf-state-3 .border{ border: 1px solid var(--color-border-subtle); }#tf-state-3 .border-b{ border-bottom: 1px solid var(--color-border-subtle); }#tf-state-3 .border-black{ border-color: #000; }#tf-state-3 .bg-transparent{ background: transparent; }#tf-state-3 .bg-white{ background-color: #fff; }#tf-state-3 .bg-\[var\(--color-primary\)\]{ background-color: var(--color-primary); }#tf-state-3 .bg-\[var\(--color-bg-hover\)\]{ background-color: var(--color-bg-hover); }#tf-state-3 .bg-\[var\(--color-primary-active\)\]{ background-color: var(--color-primary-active); }#tf-state-3 .text-white{ color: #fff; }#tf-state-3 .rounded-\[var\(--radius-xxs\)\]{ border-radius: var(--radius-xxs); }#tf-state-3 .rounded-\[var\(--radius-md\)\]{ border-radius: var(--radius-md); }#tf-state-3 .rounded-\[var\(--radius-lg\)\]{ border-radius: var(--radius-lg); }#tf-state-3 .rounded-\[var\(--radius-xl\)\]{ border-radius: var(--radius-xl); }#tf-state-3 .rounded-\[var\(--radius-2xl\)\]{ border-radius: var(--radius-2xl); }#tf-state-3 .rounded-\[var\(--radius-full\)\]{ border-radius: var(--radius-full); }#tf-state-3 .truncate{ overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }#tf-state-3 .whitespace-nowrap{ white-space: nowrap; }#tf-state-3 .text-left{ text-align: left; }#tf-state-3 .text-center{ text-align: center; }#tf-state-3 .p-0{ padding: 0; }#tf-state-3 .px-3{ padding-left: 12px; padding-right: 12px; }#tf-state-3 .px-4{ padding-left: 16px; padding-right: 16px; }#tf-state-3 .py-2{ padding-top: 8px; padding-bottom: 8px; }#tf-state-3 .py-2\.5{ padding-top: 10px; padding-bottom: 10px; }#tf-state-3 .py-16{ padding-top: 64px; padding-bottom: 64px; }#tf-state-3 .pl-\[var\(--spacing-lg\)\]{ padding-left: var(--spacing-lg); }#tf-state-3 .mt-2{ margin-top: 8px; }#tf-state-3 .mb-3{ margin-bottom: 12px; }#tf-state-3 .-top-0\.5{ top: -2px; }#tf-state-3 .-right-0\.5{ right: -2px; }#tf-state-3 .left-1\/2{ left: 50%; }#tf-state-3 .top-1\/2{ top: 50%; }#tf-state-3 .-translate-y-1\/2{ transform: translateY(-50%); }#tf-state-3 .rotate-180{ transform: rotate(180deg); }#tf-state-3 .gap-0{ gap: 0; }#tf-state-3 .gap-2{ gap: 8px; }#tf-state-3 .gap-4{ gap: 16px; }#tf-state-3 .grid-cols-3{ grid-template-columns: repeat(3, minmax(0, 1fr)); }#tf-state-3 .space-y-2 > * + *{ margin-top: 8px; }#tf-state-3 .transition-all,#tf-state-3 .transition-colors,#tf-state-3 .transition-opacity,#tf-state-3 .transition-transform{
  transition-duration: 150ms;
  transition-timing-function: ease;

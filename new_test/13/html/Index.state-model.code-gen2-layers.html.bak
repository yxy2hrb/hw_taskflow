@keyframes slide-in-right {
  from { transform: translateX(100%); }
  to   { transform: translateX(0); }
}
@keyframes slide-out-right {
  from { transform: translateX(0); }
  to   { transform: translateX(100%); }
}
@keyframes fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes slide-up {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}
@keyframes page-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}#tf-state-5 .animate-slide-in-right{ animation: slide-in-right 300ms ease-out forwards; }#tf-state-5 .animate-slide-out-right{ animation: slide-out-right 300ms ease-in forwards; }#tf-state-5 .fade-in{ animation: fade-in 300ms ease-out forwards; }#tf-state-5 .animate-slide-up{ animation: slide-up 300ms ease-out forwards; }#tf-state-5 .animate-page-in{ animation: page-in 150ms ease-out; }#tf-state-5 .tf-cg-sheet-overlay{
  position: fixed;
  inset: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}#tf-state-5 .tf-cg-sheet-mask{
  position: absolute;
  inset: 0;
  background-color: var(--color-mask);
}#tf-state-5 .tf-cg-sheet-container{
  position: relative;
  width: 100%;
  max-width: 360px;
  height: 720px;
  background-color: var(--color-bg-card);
  border-radius: var(--radius-3xl) var(--radius-3xl) 0 0;
  box-shadow: var(--shadow-lg);
  display: flex;
  flex-direction: column;
  animation: slide-up 300ms ease-out;
}#tf-state-5 .tf-cg-sheet-header{
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-xl) var(--spacing-xl) var(--spacing-lg);
  border-bottom: 1px solid var(--color-divider-subtle);
}#tf-state-5 .tf-cg-sheet-title{
  color: var(--color-text-primary);
}#tf-state-5 .tf-cg-sheet-actions{
  display: flex;
  align-items: center;
  gap: var(--spacing-lg);
}#tf-state-5 .tf-cg-sheet-clear{
  background: none;
  border: none;
  color: var(--color-text-secondary);
  cursor: pointer;
  padding: 0;
}#tf-state-5 .tf-cg-sheet-clear:active{
  opacity: 0.7;
}#tf-state-5 .tf-cg-sheet-close{
  background: none;
  border: none;
  color: var(--color-text-secondary);
  cursor: pointer;
  padding: var(--spacing-xs);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  transition: background-color 150ms ease;
}#tf-state-5 .tf-cg-sheet-close:hover{
  background-color: var(--color-bg-hover);
}#tf-state-5 .tf-cg-sheet-body{
  flex: 1;
  overflow-y: auto;
  padding: var(--spacing-lg) var(--spacing-xl);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-lg);
}#tf-state-5 .tf-cg-warning-card{
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-md);
  padding: var(--spacing-lg);
  background-color: rgba(249, 115, 22, 0.08);
  border-radius: var(--radius-md);
  border-left: 3px solid var(--color-warning);
}#tf-state-5 .tf-cg-warning-icon{
  flex-shrink: 0;
  color: var(--color-warning);
  margin-top: 2px;
}#tf-state-5 .tf-cg-warning-text{
  color: var(--color-text-primary);
  line-height: 1.5;
}#tf-state-5 .tf-cg-product-item{
  padding: var(--spacing-lg);
  background-color: var(--color-bg-card);
  border: 1px solid var(--color-border-subtle);
  border-radius: var(--radius-md);
}#tf-state-5 .tf-cg-product-info{
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}#tf-state-5 .tf-cg-product-name{
  color: var(--color-text-primary);
  font-weight: var(--font-weight-medium);
}#tf-state-5 .tf-cg-product-meta{
  display: flex;
  align-items: center;
  justify-content: space-between;
}#tf-state-5 .tf-cg-product-price{
  color: var(--color-primary);
  font-weight: var(--font-weight-semibold);
}#tf-state-5 .tf-cg-product-qty{
  color: var(--color-text-secondary);
}#tf-state-5 .tf-cg-entry-item{
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-lg);
  background-color: var(--color-bg-card);
  border: 1px solid var(--color-border-subtle);
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: background-color 150ms ease;
}#tf-state-5 .tf-cg-entry-item:hover{
  background-color: var(--color-bg-hover);
}#tf-state-5 .tf-cg-entry-content{
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
}#tf-state-5 .tf-cg-entry-title{
  color: var(--color-text-primary);
  font-weight: var(--font-weight-medium);
}#tf-state-5 .tf-cg-entry-subtitle{
  color: var(--color-text-secondary);
}#tf-state-5 .tf-cg-entry-arrow{
  color: var(--color-text-muted);
}#tf-state-5 .tf-cg-sheet-footer{
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-xl);
  border-top: 1px solid var(--color-divider-subtle);
  background-color: var(--color-bg-card);
}#tf-state-5 .tf-cg-footer-total{
  display: flex;
  align-items: baseline;
}#tf-state-5 .tf-cg-total-label{
  color: var(--color-text-secondary);
}#tf-state-5 .tf-cg-total-amount{
  color: var(--color-primary);
  font-weight: var(--font-weight-bold);
}#tf-state-5 .tf-cg-primary-btn{
  padding: var(--spacing-md) var(--spacing-2xl);
  background-color: var(--color-primary);
  color: var(--color-text-white);
  border: none;
  border-radius: var(--radius-full);
  cursor: pointer;
  transition: all 150ms ease;
}#tf-state-5 .tf-cg-primary-btn:hover{
  background-color: var(--color-primary-active);
}#tf-state-5 .tf-cg-primary-btn:active{
  transform: scale(0.98);
}

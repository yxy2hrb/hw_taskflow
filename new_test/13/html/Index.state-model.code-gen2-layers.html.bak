  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}



@keyframes slide-in-right {
  from { transform: translateX(100%); }
  to   { transform: translateX(0); }
}
@keyframes slide-out-right {
  from { transform: translateX(0); }
  to   { transform: translateX(100%); }
}
@keyframes fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes slide-up {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}
@keyframes page-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}#tf-state-3 .animate-slide-in-right{ animation: slide-in-right 300ms ease-out forwards; }#tf-state-3 .animate-slide-out-right{ animation: slide-out-right 300ms ease-in forwards; }#tf-state-3 .fade-in{ animation: fade-in 300ms ease-out forwards; }#tf-state-3 .animate-slide-up{ animation: slide-up 300ms ease-out forwards; }#tf-state-3 .animate-page-in{ animation: page-in 150ms ease-out; }#tf-state-3 .tf-cg-tools-grid{
  width: 100%;
  padding: 0;
}#tf-state-3 .tf-cg-tools-grid button{
  padding: 0;
  outline: none;
  -webkit-tap-highlight-color: transparent;
}#tf-state-3 .tf-cg-tools-grid button:active{
  opacity: 0.8;
}

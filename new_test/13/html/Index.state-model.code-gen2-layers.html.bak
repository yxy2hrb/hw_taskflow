translateY(-50%); }#tf-state-2 .rotate-180{ transform: rotate(180deg); }#tf-state-2 .gap-0{ gap: 0; }#tf-state-2 .gap-2{ gap: 8px; }#tf-state-2 .gap-4{ gap: 16px; }#tf-state-2 .grid-cols-3{ grid-template-columns: repeat(3, minmax(0, 1fr)); }#tf-state-2 .space-y-2 > * + *{ margin-top: 8px; }#tf-state-2 .transition-all,#tf-state-2 .transition-colors,#tf-state-2 .transition-opacity,#tf-state-2 .transition-transform{

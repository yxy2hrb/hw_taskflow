@keyframes slide-in-right {
  from { transform: translateX(100%); }
  to   { transform: translateX(0); }
}
@keyframes slide-out-right {
  from { transform: translateX(0); }
  to   { transform: translateX(100%); }
}
@keyframes fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes slide-up {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}
@keyframes page-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}#tf-state-6 .animate-slide-in-right{ animation: slide-in-right 300ms ease-out forwards; }#tf-state-6 .animate-slide-out-right{ animation: slide-out-right 300ms ease-in forwards; }#tf-state-6 .fade-in{ animation: fade-in 300ms ease-out forwards; }#tf-state-6 .animate-slide-up{ animation: slide-up 300ms ease-out forwards; }#tf-state-6 .animate-page-in{ animation: page-in 150ms ease-out; }#tf-state-6 .tf-cg-bottom-bar{
  background-color: var(--color-bg-card);
  box-shadow: 0 -2px 8px 0 rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}#tf-state-6 .tf-cg-bottom-bar__inner{
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 100%;
  padding: 0 var(--spacing-xl);
  box-sizing: border-box;
}#tf-state-6 .tf-cg-bottom-bar__left{
  display: flex;
  align-items: center;
  gap: var(--spacing-2xl);
}#tf-state-6 .tf-cg-bottom-bar__action{
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}#tf-state-6 .tf-cg-bottom-bar__action-icon{
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-primary);
  width: 24px;
  height: 24px;
}#tf-state-6 .tf-cg-bottom-bar__action-label{
  font-size: var(--font-caption-10);
  line-height: var(--line-height-12);
  font-weight: var(--font-weight-regular);
  color: var(--color-text-secondary);
  white-space: nowrap;
}#tf-state-6 .tf-cg-bottom-bar__right{
  display: flex;
  align-items: center;
}#tf-state-6 .tf-cg-bottom-bar__primary{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background-color: var(--color-primary);
  color: var(--color-text-white);
  border: none;
  border-radius: var(--radius-full);
  padding: 10px 32px;
  font-size: var(--font-headline-16);
  line-height: var(--line-height-20);
  font-weight: var(--font-weight-medium);
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  transition: opacity 150ms ease;
  min-width: 120px;
  height: 40px;
  box-sizing: border-box;
}#tf-state-6 .tf-cg-bottom-bar__primary:active{
  opacity: 0.85;
}

{
  "state_name": "Interests and Preferences页",
  "lifecycle": "persistent",
  "injection": { "mode": "overlay", "z_index": 9999 },
  "inherit_skeleton": false,
  "tree": {
    "type": "Page",
    "props": { "background": "#FFFFFF" },
    "children": [
      { "type": "StatusBar" },
      { "type": "NavBar", "props": {
          "title": "Interests and Preferences",
          "leftIcon": "arrow_back",
          "align": "left"
        }
      },
      { "type": "SegmentedTabs", "props": {
          "items": ["Industry", "Topics", "Notifications"],
          "active": 0,
          "variant": "underline"
        }
      },
      { "type": "Grid", "props": { "columns": 3, "gap": 16, "padding": [24, 16] },
        "children": [
          { "type": "IconCard", "props": { "icon": "business",          "label": "Enterprise" } },
          { "type": "IconCard", "props": { "icon": "home_work",         "label": "Real Estate" } },
          { "type": "IconCard", "props": { "icon": "school",            "label": "Education" } },
          { "type": "IconCard", "props": { "icon": "health_and_safety", "label": "Healthcare" } },
          { "type": "IconCard", "props": { "icon": "account_balance",   "label": "Finance" } },
          { "type": "IconCard", "props": { "icon": "public",            "label": "Digital Government" } }
        ]
      }
    ]
  }
}
